#version 460 core
// The radiance of a clear sky for a sun of irradiance 1 in an
// equirectangular map, from single scattering by Rayleigh and Mie particles
// in a spherical atmosphere. The sun's disc is left out. Below the horizon a
// grey ground takes the light of the sun and of the sky above it.
precision highp float;
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "Pbr/bodies/frame_block.glsl"
#include "Pbr/bodies/gi_common.glsl"
layout(rgba16f) uniform writeonly image2D skyEnv;

const float groundRadius = 6360e3;
const float topRadius = 6420e3;
const vec3 rayleigh = vec3(5.8e-6, 13.5e-6, 33.1e-6);
const float mie = 21e-6;
const float rayleighHeight = 7994.0;
const float mieHeight = 1200.0;
const float g = 0.76;

// The distance from o along d to the top of the atmosphere.
float toTop(vec3 o, vec3 d) {
  float b = dot(o, d);
  float c = dot(o, o) - topRadius * topRadius;
  return -b + sqrt(max(b * b - c, 0.0));
}

vec3 atmosphere(vec3 d, vec3 sun) {
  vec3 o = vec3(0.0, groundRadius + 2.0, 0.0);
  float pathLength = toTop(o, d);
  float step = pathLength / 16.0;
  vec3 sumR = vec3(0.0), sumM = vec3(0.0);
  float depthR = 0.0, depthM = 0.0;
  for (int i = 0; i < 16; i++) {
    vec3 p = o + d * (step * (float(i) + 0.5));
    float h = length(p) - groundRadius;
    float hr = exp(-h / rayleighHeight) * step;
    float hm = exp(-h / mieHeight) * step;
    depthR += hr;
    depthM += hm;
    float lightLength = toTop(p, sun);
    float lightStep = lightLength / 8.0;
    float lightR = 0.0, lightM = 0.0;
    bool blocked = false;
    for (int j = 0; j < 8; j++) {
      vec3 q = p + sun * (lightStep * (float(j) + 0.5));
      float lh = length(q) - groundRadius;
      if (lh < 0.0) {
        blocked = true;
        break;
      }
      lightR += exp(-lh / rayleighHeight) * lightStep;
      lightM += exp(-lh / mieHeight) * lightStep;
    }
    if (blocked) continue;
    vec3 tau = rayleigh * (depthR + lightR) + mie * 1.1 * (depthM + lightM);
    vec3 attenuation = exp(-tau);
    sumR += attenuation * hr;
    sumM += attenuation * hm;
  }
  float mu = dot(d, sun);
  float phaseR = 3.0 / (16.0 * PI) * (1.0 + mu * mu);
  float phaseM = 3.0 / (8.0 * PI) * ((1.0 - g * g) * (1.0 + mu * mu)) /
      ((2.0 + g * g) * pow(1.0 + g * g - 2.0 * g * mu, 1.5));
  return sumR * rayleigh * phaseR + sumM * mie * phaseM;
}

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(skyEnv);
  if (any(greaterThanEqual(p, size))) return;
  vec3 d = equirectDirection((vec2(p) + 0.5) / vec2(size));
  vec3 sun = normalize(cb0.sunDirection.xyz);
  vec3 radiance;
  if (d.y >= 0.0) {
    radiance = atmosphere(d, sun);
  } else {
    // A ground of albedo 0.2, lit by the sun and by the sky at its zenith.
    vec3 zenith = atmosphere(vec3(0.0, 1.0, 0.0), sun);
    vec3 horizon = atmosphere(normalize(vec3(d.x, 0.02, d.z)), sun);
    vec3 ground = 0.2 / PI * (max(sun.y, 0.0) * exp(-rayleigh * rayleighHeight / max(sun.y, 0.05)) + zenith * PI);
    radiance = mix(horizon, ground, clamp(-d.y * 8.0, 0.0, 1.0));
  }
  imageStore(skyEnv, p, vec4(radiance, 1.0));
}
