#version 460 core
// One mip of the prefiltered sky: the sky seen in a GGX lobe of the
// roughness of the mip around each direction, with the normal, the view and
// the reflection the same. Each sample reads the mip of the sky whose texels
// cover its solid angle.
precision highp float;
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "Pbr/bodies/gi_common.glsl"

uniform Level {
  // x the roughness, y the texels of the sky's top mip, z its last mip
  vec4 level;
} cb3;

uniform texture2D skyEnv; // t0
uniform sampler s2;
#define skyEnv_S s2
layout(rgba16f) uniform writeonly image2D target;

vec2 hammersley(int i, int n) {
  uint b = uint(i);
  b = (b << 16u) | (b >> 16u);
  b = ((b & 0x55555555u) << 1u) | ((b & 0xAAAAAAAAu) >> 1u);
  b = ((b & 0x33333333u) << 2u) | ((b & 0xCCCCCCCCu) >> 2u);
  b = ((b & 0x0F0F0F0Fu) << 4u) | ((b & 0xF0F0F0F0u) >> 4u);
  b = ((b & 0x00FF00FFu) << 8u) | ((b & 0xFF00FF00u) >> 8u);
  return vec2(float(i) / float(n), float(b) * 2.3283064365386963e-10);
}

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(target);
  if (any(greaterThanEqual(p, size))) return;
  vec3 n = equirectDirection((vec2(p) + 0.5) / vec2(size));
  float roughness = cb3.level.x;
  if (roughness <= 0.0) {
    imageStore(target, p, textureLod(sampler2D(skyEnv, s2), equirect(n), 1.0));
    return;
  }
  float a = roughness * roughness;
  vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
  vec3 tx = normalize(cross(up, n));
  vec3 ty = cross(n, tx);
  float texel = 4.0 * PI / cb3.level.y;
  vec3 sum = vec3(0.0);
  float weight = 0.0;
  const int samples = 64;
  for (int i = 0; i < samples; i++) {
    vec2 xi = hammersley(i, samples);
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    vec3 h = tx * (sinTheta * cos(phi)) + ty * (sinTheta * sin(phi)) + n * cosTheta;
    vec3 l = 2.0 * dot(n, h) * h - n;
    float nl = dot(n, l);
    if (nl <= 0.0) continue;
    float nh = max(dot(n, h), 0.0);
    float f = (nh * a * a - nh) * nh + 1.0;
    float pdf = a * a / (PI * f * f) * 0.25;
    float solid = 1.0 / (float(samples) * pdf + 1e-4);
    float lod = clamp(0.5 * log2(solid / texel) + 1.0, 0.0, cb3.level.z);
    sum += textureLod(sampler2D(skyEnv, s2), equirect(l), lod).rgb * nl;
    weight += nl;
  }
  imageStore(target, p, vec4(sum / max(weight, 1e-4), 1.0));
}
