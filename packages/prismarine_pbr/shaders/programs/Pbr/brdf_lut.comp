#version 460 core
// The scale and bias of the split-sum specular term of GGX with
// height-correlated Smith visibility, over the cosine of the view in x and
// the roughness in y.
precision highp float;
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f) uniform writeonly image2D brdfLut;

const float PI = 3.14159265;

vec2 hammersley(int i, int n) {
  uint b = uint(i);
  b = (b << 16u) | (b >> 16u);
  b = ((b & 0x55555555u) << 1u) | ((b & 0xAAAAAAAAu) >> 1u);
  b = ((b & 0x33333333u) << 2u) | ((b & 0xCCCCCCCCu) >> 2u);
  b = ((b & 0x0F0F0F0Fu) << 4u) | ((b & 0xF0F0F0F0u) >> 4u);
  b = ((b & 0x00FF00FFu) << 8u) | ((b & 0xFF00FF00u) >> 8u);
  return vec2(float(i) / float(n), float(b) * 2.3283064365386963e-10);
}

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(brdfLut);
  if (any(greaterThanEqual(p, size))) return;
  float nv = max((float(p.x) + 0.5) / float(size.x), 1e-3);
  float roughness = (float(p.y) + 0.5) / float(size.y);
  float a = roughness * roughness;
  float a2 = a * a;
  vec3 v = vec3(sqrt(1.0 - nv * nv), 0.0, nv);
  vec2 sum = vec2(0.0);
  const int samples = 256;
  for (int i = 0; i < samples; i++) {
    vec2 xi = hammersley(i, samples);
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (a2 - 1.0) * xi.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    vec3 h = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
    vec3 l = 2.0 * dot(v, h) * h - v;
    float nl = clamp(l.z, 0.0, 1.0);
    float nh = clamp(h.z, 0.0, 1.0);
    float vh = clamp(dot(v, h), 0.0, 1.0);
    if (nl <= 0.0) continue;
    float gv = nl * sqrt(nv * nv * (1.0 - a2) + a2);
    float gl = nv * sqrt(nl * nl * (1.0 - a2) + a2);
    float vis = 0.5 / max(gv + gl, 1e-5);
    // The visibility times the inverse of the pdf of the sample.
    float g = vis * 4.0 * nl * vh / nh;
    float fc = pow(1.0 - vh, 5.0);
    sum += vec2((1.0 - fc) * g, fc * g);
  }
  imageStore(brdfLut, p, vec4(sum / float(samples), 0.0, 1.0));
}
