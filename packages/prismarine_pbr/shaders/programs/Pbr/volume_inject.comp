#version 460
// The light that the fog of each froxel scatters towards the camera, from the
// sun with its shadow map, the point lights with their shadows and the sky,
// with the Henyey-Greenstein phase function, blended with the froxel of the
// last frame at the same point. rgb holds the scattered light per metre and
// a the extinction per metre.
layout(local_size_x = 8, local_size_y = 8) in;
#include "Pbr/bodies/frame_block.glsl"
#include "Pbr/bodies/volume_block.glsl"

uniform texture2D shadowMap; // t4
uniform samplerShadow s4;
#define shadowMap_S s4
#include "Pbr/bodies/point_shadow.glsl"
uniform texture3D history; // t0
uniform sampler s0;
#define history_S s0

layout(rgba16f) uniform image3D scatter;

const float PI = 3.14159265;

float phase(float cosTheta, float g) {
  float d = 1.0 + g * g - 2.0 * g * cosTheta;
  return (1.0 - g * g) / (4.0 * PI * d * sqrt(d));
}

float sunShadow(vec3 p) {
  if (cb0.sunDirection.w < 0.5) return 1.0;
  vec4 s = cb0.shadowMatrix * vec4(p, 1.0);
  if (s.z >= 1.0 || any(lessThan(s.xy, vec2(0.0))) || any(greaterThan(s.xy, vec2(1.0)))) {
    return 1.0;
  }
  return texture(sampler2DShadow(shadowMap, s4), vec3(s.xy, s.z - cb0.shadowParams.y));
}

void main() {
  ivec3 id = ivec3(gl_GlobalInvocationID);
  ivec3 grid = ivec3(cb1.grid.xyz);
  if (any(greaterThanEqual(id, grid))) return;
  vec2 ndc = (vec2(id.xy) + 0.5) / vec2(grid.xy) * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
  float z = volumeDepth((float(id.z) + cb1.grid.w) / float(grid.z));
  vec3 ray = cb1.forward.xyz + ndc.x * cb1.right.xyz + ndc.y * cb1.up.xyz;
  vec3 p = cb1.camera.xyz + ray * z;
  vec3 view = normalize(ray);
  float g = cb1.fog.w;
  float density = cb1.fog.x * exp(-max(p.y - cb1.fog.z, 0.0) * cb1.fog.y);

  vec3 light = cb0.sunColor.rgb * cb1.lights.x * sunShadow(p) *
               phase(dot(cb0.sunDirection.xyz, view), g);
  int count = int(cb0.groundColor.w);
  for (int i = 0; i < 16; i++) {
    if (i >= count) break;
    vec4 lp = cb0.lightPosition[i];
    vec3 d = lp.xyz - p;
    float dist2 = max(dot(d, d), 1e-4);
    float r = dist2 / (lp.w * lp.w);
    float falloff = clamp(1.0 - r * r, 0.0, 1.0) / dist2;
    if (falloff <= 0.0) continue;
    light += cb0.lightColor[i].rgb * cb1.lights.y * falloff *
             phase(dot(d * inversesqrt(dist2), view), g) *
             pointShadow(i, p, vec3(0.0));
  }
  light += (cb0.skyColor.rgb + cb0.groundColor.rgb) * 0.5 * cb1.lights.z / (4.0 * PI);
  vec4 now = vec4(light * density, density);

  float keep = cb1.depth.w;
  if (keep > 0.0) {
    vec4 c = cb1.previousViewProjection * vec4(p, 1.0);
    vec2 uv = c.xy / c.w * vec2(0.5, -0.5) + 0.5;
    float t = volumeSlice(dot(p - cb1.previousCamera.xyz, cb1.previousForward.xyz));
    // A froxel of the history holds the mean over its depth offsets, the
    // value at the centre of its slice.
    vec3 at = vec3(uv, t);
    if (c.w > 0.0 && all(greaterThanEqual(at, vec3(0.0))) && all(lessThanEqual(at, vec3(1.0)))) {
      now = mix(now, texture(sampler3D(history, s0), at), keep);
    }
  }
  imageStore(scatter, id, now);
}
