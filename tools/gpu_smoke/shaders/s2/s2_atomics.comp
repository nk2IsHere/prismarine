#version 460
// Storage texel buffers: every invocation adds one to a counter and
// exchanges another; an RGBA32F buffer is written.
layout(local_size_x = 64) in;

layout(r32ui) uniform uimageBuffer counters;
layout(rgba32f) uniform writeonly imageBuffer values;

void main() {
  uint i = gl_GlobalInvocationID.x;
  imageAtomicAdd(counters, 0, 1u);
  imageAtomicExchange(counters, 1, 77u);
  imageStore(values, int(i), vec4(0.25, 0.5, 0.75, 1.0));
}
