#version 460
// Storage images in S2's formats: RGBA16 unorm (2D, an array layer, a mip
// level), RGBA32UI 3D, RGBA16F 2D.
layout(local_size_x = 4, local_size_y = 4) in;

layout(rgba16) uniform writeonly image2D moments;
layout(rgba16) uniform writeonly image2D moments_layer;
layout(rgba16) uniform writeonly image2D moments_mip;
layout(rgba32ui) uniform writeonly uimage3D grid;
layout(rgba16f) uniform writeonly image2D hdr;

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  imageStore(moments, p, vec4(0.25, 0.5, 0.75, 1.0));
  imageStore(moments_layer, p, vec4(0.75, 0.5, 0.25, 1.0));
  imageStore(moments_mip, p, vec4(0.5, 0.5, 0.5, 1.0));
  imageStore(grid, ivec3(p, 1), uvec4(1, 2, 3, 4));
  imageStore(hdr, p, vec4(2.0, 0.5, 0.25, 1.0));
}
