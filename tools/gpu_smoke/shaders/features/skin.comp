#version 460
// Writes the vertices of a quad and the arguments of an indexed indirect
// draw, as compute skinning and culling do.
layout(local_size_x = 1) in;

layout(std430) writeonly buffer Positions {
  vec2 p[];
} positions;

layout(std430) writeonly buffer Args {
  uint a[];
} args;

void main() {
  positions.p[0] = vec2(-1.0, -1.0);
  positions.p[1] = vec2(1.0, -1.0);
  positions.p[2] = vec2(-1.0, 1.0);
  positions.p[3] = vec2(1.0, 1.0);
  // The index count, instance count, first index, base vertex and first
  // instance.
  args.a[0] = 6u;
  args.a[1] = 1u;
  args.a[2] = 0u;
  args.a[3] = 0u;
  args.a[4] = 0u;
}
