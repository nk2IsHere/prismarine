+std::shared_ptr<Texture> ContextMTL::McsmMakeTextureView(
+    const std::shared_ptr<Texture>& texture,
+    const TextureDescriptor& view_desc,
+    uint32_t base_mip,
+    uint32_t base_layer) const {
+  if (!texture || !view_desc.IsValid()) {
+    return nullptr;
+  }
+  const TextureDescriptor& desc = texture->GetTextureDescriptor();
+  if (desc.type == TextureType::kTexture3D ||
+      view_desc.type == TextureType::kTexture3D ||
+      base_mip + view_desc.mip_count > desc.mip_count ||
+      base_layer + view_desc.GetArrayLayerCount() > desc.GetArrayLayerCount() ||
+      view_desc.format != desc.format ||
+      view_desc.sample_count != desc.sample_count) {
+    VALIDATION_LOG << "A texture view must lie within its 2D, array or cube "
+                      "texture, in its format and sample count.";
+    return nullptr;
+  }
+  id<MTLTexture> parent = TextureMTL::Cast(*texture).GetMTLTexture();
+  id<MTLTexture> view = [parent
+      newTextureViewWithPixelFormat:ToMTLPixelFormat(view_desc.format)
+                        textureType:ToMTLTextureType(view_desc.type)
+                             levels:NSMakeRange(base_mip, view_desc.mip_count)
+                             slices:NSMakeRange(base_layer,
+                                                view_desc.GetArrayLayerCount())];
+  if (!view) {
+    return nullptr;
+  }
+  return TextureMTL::Wrapper(view_desc, view);
+}
+
 }  // namespace impeller
