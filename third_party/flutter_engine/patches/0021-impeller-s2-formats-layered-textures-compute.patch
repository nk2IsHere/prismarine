+
+#include "impeller/renderer/backend/vulkan/texture_source_vk.h"
+#include "impeller/renderer/backend/vulkan/vk.h"
+
+namespace impeller {
+
+/// mcsm9: a view of some mip levels and array layers of another texture's
+/// image, sampled, rendered into or written as a storage image on its own
+/// (a mip chain built level by level, one layer of an array as a 2D target).
+///
+/// The view tracks the layout of its own subresources; the parent's tracked
+/// layout stays as it was, which holds while every user leaves the
+/// subresources in shader-read between passes (colour targets and sampled
+/// depth end their passes there, compute passes move storage images back).
+class McsmTextureViewVK final : public TextureSourceVK {
+ public:
+  static std::shared_ptr<McsmTextureViewVK> Make(
+      const vk::Device& device,
+      std::shared_ptr<const TextureSourceVK> parent,
+      const TextureDescriptor& view_desc,
+      uint32_t base_mip,
+      uint32_t base_layer);
+
+  ~McsmTextureViewVK() override;
+
+  vk::Image GetImage() const override;
+
+  vk::ImageView GetImageView() const override;
+
+  vk::ImageView GetRenderTargetView(uint32_t mip_level,
+                                    uint32_t array_layer) const override;
+
+  bool IsSwapchainImage() const override { return false; }
+
+ private:
+  McsmTextureViewVK(std::shared_ptr<const TextureSourceVK> parent,
+                    const TextureDescriptor& view_desc,
+                    uint32_t base_mip,
+                    uint32_t base_layer);
+
+  std::shared_ptr<const TextureSourceVK> parent_;
+  vk::UniqueImageView image_view_;
+  // One attachment view per (mip level, layer) of the view, row-major by mip.
+  std::vector<vk::UniqueImageView> rt_views_;
+};
+
+}  // namespace impeller
