@@ -5,6 +5,8 @@
 #ifndef FLUTTER_IMPELLER_CORE_SAMPLER_DESCRIPTOR_H_
 #define FLUTTER_IMPELLER_CORE_SAMPLER_DESCRIPTOR_H_
 
+#include <optional>
+
 #include "impeller/core/formats.h"
 
 namespace impeller {
@@ -26,6 +28,27 @@ struct SamplerDescriptor final {
   /// filtering only applies when all filters are linear.
   uint8_t max_anisotropy = 1;
 
+  // mcsm9: the rest of Direct3D 11's sampler state (Metal and Vulkan): a
+  // comparison function (sample_c), the border colour, LOD clamps and a LOD
+  // bias (Vulkan only: Metal has no sampler bias). The defaults change
+  // nothing.
+  std::optional<CompareFunction> mcsm_compare;
+  McsmBorderColor mcsm_border_color = McsmBorderColor::kTransparentBlack;
+  float mcsm_min_lod = 0.0f;
+  float mcsm_max_lod = 1000.0f;  // VK_LOD_CLAMP_NONE: no clamp.
+  float mcsm_lod_bias = 0.0f;
+
+  /// mcsm9: whether two descriptors' extras (above) agree; ToKey leaves
+  /// them out.
+  static bool McsmExtrasEqual(const SamplerDescriptor& a,
+                              const SamplerDescriptor& b) {
+    return a.mcsm_compare == b.mcsm_compare &&
+           a.mcsm_border_color == b.mcsm_border_color &&
+           a.mcsm_min_lod == b.mcsm_min_lod &&
+           a.mcsm_max_lod == b.mcsm_max_lod &&
+           a.mcsm_lod_bias == b.mcsm_lod_bias;
+  }
+
   std::string_view label = "NN Clamp Sampler";
 
   SamplerDescriptor();
