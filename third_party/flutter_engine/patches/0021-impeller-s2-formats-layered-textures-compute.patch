+namespace {
+// mcsm9: the aspect a copy reads or writes (depth for depth formats).
+vk::ImageAspectFlags McsmCopyAspect(PixelFormat format) {
+  if (IsDepthWritable(format)) {
+    return vk::ImageAspectFlagBits::eDepth;
+  }
+  if (IsStencilWritable(format)) {
+    return vk::ImageAspectFlagBits::eStencil;
+  }
+  return vk::ImageAspectFlagBits::eColor;
+}
+
+// mcsm9: a mip level and slice as copy subresource and offset (a 3D
+// texture's slice is a depth offset).
+void McsmCopySubresource(const TextureDescriptor& desc,
+                         uint32_t mip,
+                         uint32_t slice,
+                         vk::ImageSubresourceLayers* layers,
+                         int32_t* z) {
+  const bool is_3d = desc.type == TextureType::kTexture3D;
+  *layers = vk::ImageSubresourceLayers(McsmCopyAspect(desc.format), mip,
+                                       is_3d ? 0u : slice, 1u);
+  *z = is_3d ? static_cast<int32_t>(slice) : 0;
+}
+
+// mcsm9: moves `texture` to `layout` for a copy and returns the layout to
+// restore after (shader-read for one never written).
+vk::ImageLayout McsmToCopyLayout(const vk::CommandBuffer& cmd,
+                                 const TextureVK& texture,
+                                 vk::ImageLayout layout) {
+  vk::ImageLayout before = texture.GetLayout();
+  if (before == vk::ImageLayout::eUndefined) {
+    before = vk::ImageLayout::eShaderReadOnlyOptimal;
+  }
+  BarrierVK barrier;
+  barrier.cmd_buffer = cmd;
+  barrier.new_layout = layout;
+  barrier.src_stage = vk::PipelineStageFlagBits::eAllCommands;
+  barrier.src_access = vk::AccessFlagBits::eMemoryWrite;
+  barrier.dst_stage = vk::PipelineStageFlagBits::eTransfer;
+  barrier.dst_access =
+      vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite;
+  texture.SetLayout(barrier);
+  return before;
+}
+
+void McsmRestoreLayout(const vk::CommandBuffer& cmd,
+                       const TextureVK& texture,
+                       vk::ImageLayout layout) {
+  BarrierVK barrier;
+  barrier.cmd_buffer = cmd;
+  barrier.new_layout = layout;
+  barrier.src_stage = vk::PipelineStageFlagBits::eTransfer;
+  barrier.src_access = vk::AccessFlagBits::eTransferWrite;
+  barrier.dst_stage = vk::PipelineStageFlagBits::eAllCommands;
+  barrier.dst_access =
+      vk::AccessFlagBits::eMemoryRead | vk::AccessFlagBits::eMemoryWrite;
+  texture.SetLayout(barrier);
+}
+}  // namespace
+
+bool BlitPassVK::McsmCopyTextureToTexture(
+    std::shared_ptr<Texture> source,
+    std::shared_ptr<Texture> destination,
+    IRect source_region,
+    IPoint destination_origin,
+    uint32_t source_mip,
+    uint32_t source_slice,
+    uint32_t destination_mip,
+    uint32_t destination_slice) {
+  const auto& cmd = command_buffer_->GetCommandBuffer();
+  const auto& src = TextureVK::Cast(*source);
+  const auto& dst = TextureVK::Cast(*destination);
+  if (!command_buffer_->Track(source) || !command_buffer_->Track(destination)) {
+    return false;
+  }
+  // One image (another level or slice of it) is copied in general layout.
+  const bool same = src.GetImage() == dst.GetImage();
+  const vk::ImageLayout src_layout = same ? vk::ImageLayout::eGeneral
+                                          : vk::ImageLayout::eTransferSrcOptimal;
+  const vk::ImageLayout dst_layout = same ? vk::ImageLayout::eGeneral
+                                          : vk::ImageLayout::eTransferDstOptimal;
+  const vk::ImageLayout src_before = McsmToCopyLayout(cmd, src, src_layout);
+  const vk::ImageLayout dst_before =
+      same ? src_before : McsmToCopyLayout(cmd, dst, dst_layout);
+
+  vk::ImageCopy copy;
+  int32_t src_z = 0, dst_z = 0;
+  McsmCopySubresource(src.GetTextureDescriptor(), source_mip, source_slice,
+                      &copy.srcSubresource, &src_z);
+  McsmCopySubresource(dst.GetTextureDescriptor(), destination_mip,
+                      destination_slice, &copy.dstSubresource, &dst_z);
+  copy.srcOffset = vk::Offset3D(source_region.GetX(), source_region.GetY(),
+                                src_z);
+  copy.dstOffset = vk::Offset3D(destination_origin.x, destination_origin.y,
+                                dst_z);
+  copy.extent = vk::Extent3D(source_region.GetWidth(),
+                             source_region.GetHeight(), 1);
+  cmd.copyImage(src.GetImage(), src_layout, dst.GetImage(), dst_layout, copy);
+
+  McsmRestoreLayout(cmd, src, src_before);
+  if (!same) {
+    McsmRestoreLayout(cmd, dst, dst_before);
+  }
+  return true;
+}
+
+bool BlitPassVK::McsmCopyTextureToBuffer(
+    std::shared_ptr<Texture> source,
+    std::shared_ptr<DeviceBuffer> destination,
+    IRect source_region,
+    size_t destination_offset,
+    uint32_t source_mip,
+    uint32_t source_slice) {
+  const auto& cmd = command_buffer_->GetCommandBuffer();
+  const auto& src = TextureVK::Cast(*source);
+  if (!command_buffer_->Track(source) || !command_buffer_->Track(destination)) {
+    return false;
+  }
+  const vk::ImageLayout before =
+      McsmToCopyLayout(cmd, src, vk::ImageLayout::eTransferSrcOptimal);
+  vk::BufferImageCopy copy;
+  int32_t z = 0;
+  McsmCopySubresource(src.GetTextureDescriptor(), source_mip, source_slice,
+                      &copy.imageSubresource, &z);
+  copy.bufferOffset = destination_offset;
+  copy.imageOffset = vk::Offset3D(source_region.GetX(), source_region.GetY(), z);
+  copy.imageExtent =
+      vk::Extent3D(source_region.GetWidth(), source_region.GetHeight(), 1);
+  cmd.copyImageToBuffer(src.GetImage(), vk::ImageLayout::eTransferSrcOptimal,
+                        DeviceBufferVK::Cast(*destination).GetBuffer(), copy);
+  McsmRestoreLayout(cmd, src, before);
+  if (destination->GetDeviceBufferDescriptor().readback) {
+    vk::MemoryBarrier barrier;
+    barrier.srcAccessMask = vk::AccessFlagBits::eTransferWrite;
+    barrier.dstAccessMask = vk::AccessFlagBits::eHostRead;
+    cmd.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer,
+                        vk::PipelineStageFlagBits::eHost, {}, 1, &barrier, 0,
+                        {}, 0, {});
+  }
+  return true;
+}
