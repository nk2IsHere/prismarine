+
+bool BlitPassMTL::McsmCopyTextureToBuffer(
+    std::shared_ptr<Texture> source,
+    std::shared_ptr<DeviceBuffer> destination,
+    IRect source_region,
+    size_t destination_offset,
+    uint32_t source_mip,
+    uint32_t source_slice) {
+  auto source_mtl = TextureMTL::Cast(*source).GetMTLTexture();
+  auto destination_mtl = DeviceBufferMTL::Cast(*destination).GetMTLBuffer();
+  if (!source_mtl || !destination_mtl) {
+    return false;
+  }
+  NSUInteger src_slice, src_z;
+  McsmSliceOrigin(*source, source_slice, &src_slice, &src_z);
+  const size_t bytes_per_row = BytesPerRowForTextureWidth(
+      source->GetTextureDescriptor().format, source_region.GetWidth());
+  [encoder_ copyFromTexture:source_mtl
+                     sourceSlice:src_slice
+                     sourceLevel:source_mip
+                    sourceOrigin:MTLOriginMake(source_region.GetX(),
+                                               source_region.GetY(), src_z)
+                      sourceSize:MTLSizeMake(source_region.GetWidth(),
+                                             source_region.GetHeight(), 1)
+                        toBuffer:destination_mtl
+               destinationOffset:destination_offset
+          destinationBytesPerRow:bytes_per_row
+        destinationBytesPerImage:bytes_per_row * source_region.GetHeight()];
+  return true;
+}
+
 }  // namespace impeller
