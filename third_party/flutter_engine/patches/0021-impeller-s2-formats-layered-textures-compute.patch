+namespace impeller {
+
+McsmTextureViewVK::McsmTextureViewVK(
+    std::shared_ptr<const TextureSourceVK> parent,
+    const TextureDescriptor& view_desc,
+    uint32_t base_mip,
+    uint32_t base_layer)
+    : TextureSourceVK(view_desc), parent_(std::move(parent)) {
+  McsmSetSubresourceBase(base_mip, base_layer);
+  // The view's subresources are where the parent's are.
+  SetLayoutWithoutEncoding(parent_->GetLayout());
+}
+
+McsmTextureViewVK::~McsmTextureViewVK() = default;
+
+std::shared_ptr<McsmTextureViewVK> McsmTextureViewVK::Make(
+    const vk::Device& device,
+    std::shared_ptr<const TextureSourceVK> parent,
+    const TextureDescriptor& view_desc,
+    uint32_t base_mip,
+    uint32_t base_layer) {
+  if (!parent || !view_desc.IsValid()) {
+    return nullptr;
+  }
+  const TextureDescriptor& parent_desc = parent->GetTextureDescriptor();
+  if (parent_desc.type == TextureType::kTexture3D ||
+      view_desc.type == TextureType::kTexture3D ||
+      base_mip + view_desc.mip_count > parent_desc.mip_count ||
+      base_layer + view_desc.GetArrayLayerCount() >
+          parent_desc.GetArrayLayerCount() ||
+      view_desc.format != parent_desc.format ||
+      view_desc.sample_count != parent_desc.sample_count) {
+    VALIDATION_LOG << "A texture view must lie within its 2D, array or cube "
+                      "texture, in its format and sample count.";
+    return nullptr;
+  }
+  auto view = std::shared_ptr<McsmTextureViewVK>(
+      new McsmTextureViewVK(parent, view_desc, base_mip, base_layer));
+
+  vk::ImageViewCreateInfo info;
+  info.image = parent->GetImage();
+  info.viewType = ToVKImageViewType(view_desc.type);
+  info.format = ToVKImageFormat(view_desc.format);
+  info.subresourceRange.aspectMask =
+      IsDepthWritable(view_desc.format) ? vk::ImageAspectFlagBits::eDepth
+                                        : ToVKImageAspectFlags(view_desc.format);
+  info.subresourceRange.baseMipLevel = base_mip;
+  info.subresourceRange.levelCount = view_desc.mip_count;
+  info.subresourceRange.baseArrayLayer = base_layer;
+  info.subresourceRange.layerCount = ToArrayLayerCount(view_desc);
+  auto [result, image_view] = device.createImageViewUnique(info);
+  if (result != vk::Result::eSuccess) {
+    VALIDATION_LOG << "Could not create a texture view: "
+                   << vk::to_string(result);
+    return nullptr;
+  }
+  view->image_view_ = std::move(image_view);
+
+  if (view_desc.usage & TextureUsage::kRenderTarget) {
+    info.viewType = vk::ImageViewType::e2D;
+    info.subresourceRange.aspectMask = ToVKImageAspectFlags(view_desc.format);
+    info.subresourceRange.levelCount = 1u;
+    info.subresourceRange.layerCount = 1u;
+    for (uint32_t mip = 0; mip < view_desc.mip_count; mip++) {
+      for (uint32_t layer = 0; layer < ToArrayLayerCount(view_desc); layer++) {
+        info.subresourceRange.baseMipLevel = base_mip + mip;
+        info.subresourceRange.baseArrayLayer = base_layer + layer;
+        auto [rt_result, rt_view] = device.createImageViewUnique(info);
+        if (rt_result != vk::Result::eSuccess) {
+          VALIDATION_LOG << "Could not create a texture view's attachment "
+                            "view: "
+                         << vk::to_string(rt_result);
+          return nullptr;
+        }
+        view->rt_views_.push_back(std::move(rt_view));
+      }
+    }
+  }
+  return view;
+}
+
+vk::Image McsmTextureViewVK::GetImage() const {
+  return parent_->GetImage();
+}
+
+vk::ImageView McsmTextureViewVK::GetImageView() const {
+  return image_view_.get();
+}
+
+vk::ImageView McsmTextureViewVK::GetRenderTargetView(
+    uint32_t mip_level,
+    uint32_t array_layer) const {
+  if (rt_views_.empty()) {
+    return VK_NULL_HANDLE;
+  }
+  const size_t index =
+      static_cast<size_t>(mip_level) * ToArrayLayerCount(desc_) + array_layer;
+  return index < rt_views_.size() ? rt_views_[index].get()
+                                  : rt_views_[0].get();
+}
