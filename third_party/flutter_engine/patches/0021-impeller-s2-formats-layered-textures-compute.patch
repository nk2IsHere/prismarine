+// mcsm9: whether a depth attachment is also sampled by shaders (a stored
+// depth texture with shader-read usage): it then ends its pass shader-read.
+bool McsmDepthIsSampled(const Texture& texture) {
+  const TextureDescriptor& desc = texture.GetTextureDescriptor();
+  return desc.storage_mode != StorageMode::kDeviceTransient &&
+         (desc.usage & TextureUsage::kShaderRead);
