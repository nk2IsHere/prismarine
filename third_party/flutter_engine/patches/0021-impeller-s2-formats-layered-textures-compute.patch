@@ -44,6 +44,34 @@ struct TextureDescriptor {
   TextureUsageMask usage = TextureUsage::kShaderRead;
   SampleCount sample_count = SampleCount::kCount1;
   CompressionType compression_type = CompressionType::kLossless;
+  // mcsm: the layers of a kTexture2DArray and the depth of a kTexture3D (1
+  // for every other type).
+  size_t array_layer_count = 1u;
+  size_t depth = 1u;
+
+  /// @brief mcsm: how many slices a slice index ranges over: a cube's six
+  ///        faces, an array's layers, a 3D texture's depth slices, else one.
+  constexpr size_t GetSliceCount() const {
+    switch (type) {
+      case TextureType::kTextureCube:
+        return 6u;
+      case TextureType::kTexture2DArray:
+        return array_layer_count;
+      case TextureType::kTexture3D:
+        return depth;
+      case TextureType::kTexture2D:
+      case TextureType::kTexture2DMultisample:
+      case TextureType::kTextureExternalOES:
+        return 1u;
+    }
+    return 1u;
+  }
+
+  /// @brief mcsm: how many array layers the texture's image has (a 3D
+  ///        texture's depth slices are not layers).
+  constexpr size_t GetArrayLayerCount() const {
+    return type == TextureType::kTexture3D ? 1u : GetSliceCount();
+  }
 
   /// @brief The number of bytes required to store an image of the given texel
   ///        dimensions in this format. Block-compressed formats round the
