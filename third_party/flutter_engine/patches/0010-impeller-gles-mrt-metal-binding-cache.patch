+  {
+    size_t count = 0;
+    render_target.IterateAllColorAttachments(
+        [&](size_t index, const ColorAttachment&) -> bool {
+          count = std::max(count, index + 1);
+          return true;
+        });
+    for (size_t i = 1; i < count; i++) {
+      if (!render_target.HasColorAttachment(i)) {
+        VALIDATION_LOG << "Colour attachments must be contiguous on GLES.";
+        return false;
+      }
+      const ColorAttachment& color = render_target.GetColorAttachment(i);
+      if (color.resolve_texture || !color.texture) {
+        VALIDATION_LOG << "A resolved colour attachment past the first.";
+        return false;
+      }
+      RenderPassData::ExtraColor extra;
+      extra.texture = color.texture;
+      extra.mip_level = color.mip_level;
+      extra.slice = color.slice;
+      extra.clear_color = color.clear_color;
+      extra.clear = CanClearAttachment(color.load_action);
+      extra.discard = CanDiscardAttachmentWhenDone(color.store_action);
+      pass_data->extra_colors.push_back(std::move(extra));
+    }
+  }
