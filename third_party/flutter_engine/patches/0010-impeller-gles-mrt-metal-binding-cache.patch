+// mcsm7: blending and write masks for a pipeline with several colour
+// attachments. One shared state when they all agree (the global calls apply
+// to every draw buffer); else per draw buffer where the driver has the
+// indexed calls (GLES 3.2 / GL 4.0 core, or OES_draw_buffers_indexed).
+static bool ConfigureBlendingMulti(const ProcTableGLES& gl,
+                                   const PipelineDescriptor& desc) {
+  const auto& colors = desc.GetColorAttachmentDescriptors();
+  const ColorAttachmentDescriptor* first = nullptr;
+  bool same = true;
+  for (const auto& [index, color] : colors) {
+    if (!first) {
+      first = &color;
+      continue;
+    }
+    if (color.blending_enabled != first->blending_enabled ||
+        color.write_mask != first->write_mask ||
+        (color.blending_enabled &&
+         (color.src_color_blend_factor != first->src_color_blend_factor ||
+          color.dst_color_blend_factor != first->dst_color_blend_factor ||
+          color.src_alpha_blend_factor != first->src_alpha_blend_factor ||
+          color.dst_alpha_blend_factor != first->dst_alpha_blend_factor ||
+          color.color_blend_op != first->color_blend_op ||
+          color.alpha_blend_op != first->alpha_blend_op))) {
+      same = false;
+    }
+  }
+  if (!first) {
+    return false;
+  }
+  if (same) {
+    ConfigureBlending(gl, first);
+    return true;
+  }
+  const bool core = gl.Enablei.IsAvailable() && gl.Disablei.IsAvailable() &&
+                    gl.BlendFuncSeparatei.IsAvailable() &&
+                    gl.BlendEquationSeparatei.IsAvailable() &&
+                    gl.ColorMaski.IsAvailable();
+  const bool oes = gl.EnableiOES.IsAvailable() && gl.DisableiOES.IsAvailable() &&
+                   gl.BlendFuncSeparateiOES.IsAvailable() &&
+                   gl.BlendEquationSeparateiOES.IsAvailable() &&
+                   gl.ColorMaskiOES.IsAvailable();
+  if (!core && !oes) {
+    VALIDATION_LOG << "Colour attachments with different blends need indexed "
+                      "blend state (GLES 3.2, GL 4.0 or "
+                      "OES_draw_buffers_indexed).";
+    return false;
+  }
+  for (const auto& [index, color] : colors) {
+    const GLuint i = static_cast<GLuint>(index);
+    if (color.blending_enabled) {
+      core ? gl.Enablei(GL_BLEND, i) : gl.EnableiOES(GL_BLEND, i);
+      const GLenum sc = ToBlendFactor(color.src_color_blend_factor);
+      const GLenum dc = ToBlendFactor(color.dst_color_blend_factor);
+      const GLenum sa = ToBlendFactor(color.src_alpha_blend_factor);
+      const GLenum da = ToBlendFactor(color.dst_alpha_blend_factor);
+      core ? gl.BlendFuncSeparatei(i, sc, dc, sa, da)
+           : gl.BlendFuncSeparateiOES(i, sc, dc, sa, da);
+      const GLenum mc = ToBlendOperation(color.color_blend_op);
+      const GLenum ma = ToBlendOperation(color.alpha_blend_op);
+      core ? gl.BlendEquationSeparatei(i, mc, ma)
+           : gl.BlendEquationSeparateiOES(i, mc, ma);
+    } else {
+      core ? gl.Disablei(GL_BLEND, i) : gl.DisableiOES(GL_BLEND, i);
+    }
+    const auto m = color.write_mask;
+    const GLboolean r = (m & ColorWriteMaskBits::kRed) ? GL_TRUE : GL_FALSE;
+    const GLboolean g = (m & ColorWriteMaskBits::kGreen) ? GL_TRUE : GL_FALSE;
+    const GLboolean b = (m & ColorWriteMaskBits::kBlue) ? GL_TRUE : GL_FALSE;
+    const GLboolean a = (m & ColorWriteMaskBits::kAlpha) ? GL_TRUE : GL_FALSE;
+    core ? gl.ColorMaski(i, r, g, b, a) : gl.ColorMaskiOES(i, r, g, b, a);
+  }
+  return true;
+}
