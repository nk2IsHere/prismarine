From aa30a26b92c38f3d7a0928783f20187d4b8795eb Mon Sep 17 00:00:00 2001
From: mcsm <mcsm@localhost>
Date: Wed, 11 Nov 2026 16:24:12 +0100
Subject: [PATCH 25/25] flutter_gpu (mcsm10): a vertex stage without inputs
 loads; storage, texel, texture and sampler bindings are sent on Metal only
 when changed or displaced; RenderPass_McsmDrawIndirectCached (leaf, 2 = no
 cached pipeline); Texture_McsmInitializeViewFormat (the parent's sRGB twin);
 feature bit 4096

---
 engine/src/flutter/lib/gpu/context.cc        | 13 +++-
 engine/src/flutter/lib/gpu/render_pass.cc    | 73 +++++++++++++++++---
 engine/src/flutter/lib/gpu/render_pass.h     | 18 ++++-
 engine/src/flutter/lib/gpu/shader_library.cc | 36 +++++-----
 engine/src/flutter/lib/gpu/texture.cc        | 53 +++++++++++---
 engine/src/flutter/lib/gpu/texture.h         | 14 ++++
 6 files changed, 168 insertions(+), 39 deletions(-)

diff --git a/engine/src/flutter/lib/gpu/context.cc b/engine/src/flutter/lib/gpu/context.cc
index 0f12b18fc11..940b1190f19 100644
--- a/engine/src/flutter/lib/gpu/context.cc
+++ b/engine/src/flutter/lib/gpu/context.cc
@@ -276,16 +276,23 @@ extern int64_t InternalFlutterGpu_McsmFeatures() {
   // (RenderPass_McsmBindStorageBuffer), compute pipelines and passes
   // (ComputePipeline_*, ComputePass_*), and shader bundles with storage
   // resources and per-block uniform limits.
+  //
+  // mcsm10: 4096 = our renderer's needs on Metal and Vulkan: vertex stages
+  // without inputs, storage and unsigned texel buffers in pixel stages,
+  // more bindings per draw, leaf indirect draws
+  // (RenderPass_McsmDrawIndirectCached), the binding resend cut and sRGB
+  // texture views.
   const int64_t common = 1 | 2 | 4 | 8 | 512;
   switch (backend) {
     case 0:
-      return common | 16 | 64 | 256 | 1024 | 2048;
+      return common | 16 | 64 | 256 | 1024 | 2048 | 4096;
     case 1:
       return common | 64 | 128 | 1024;
     case 2:
-      return common | 64 | (g_mcsm_vk_viewports ? 256 : 0) | 1024 | 2048;
+      return common | 64 | (g_mcsm_vk_viewports ? 256 : 0) | 1024 | 2048 |
+             4096;
     default:
-      return common | 16 | 64 | 128 | 256 | 2048;
+      return common | 16 | 64 | 128 | 256 | 2048 | 4096;
   }
 }
 
diff --git a/engine/src/flutter/lib/gpu/render_pass.cc b/engine/src/flutter/lib/gpu/render_pass.cc
