   for (auto& entry : mcsm_storage_bindings_) {
     if (entry.stage == stage && entry.slot.binding == slot.binding &&
         entry.slot.ext_res_0 == slot.ext_res_0) {
+      // mcsm10: the same buffer and range again leaves the entry clean, so
