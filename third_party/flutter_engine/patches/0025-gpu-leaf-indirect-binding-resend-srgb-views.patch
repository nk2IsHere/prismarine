+// mcsm10: `format` < 0 keeps the parent's; else a Flutter GPU pixel format,
+// the parent's or its sRGB twin.
+static bool McsmInitializeView(Dart_Handle wrapper,
+                               flutter::gpu::Context* gpu_context,
+                               flutter::gpu::Texture* parent,
+                               int texture_type,
+                               int base_mip,
+                               int mip_count,
+                               int base_layer,
+                               int layers,
+                               int format) {
   if (!parent || base_mip < 0 || mip_count < 1 || base_layer < 0 ||
       layers < 1) {
     return false;
@@ -378,6 +380,12 @@ bool InternalFlutterGpu_Texture_McsmInitializeView(
   const impeller::TextureDescriptor& parent_desc =
       parent_texture->GetTextureDescriptor();
   impeller::TextureDescriptor desc = parent_desc;
+  if (format >= 0) {
+    desc.format = flutter::gpu::ToImpellerPixelFormat(format);
+    if (!impeller::McsmViewFormatAllowed(parent_desc.format, desc.format)) {
+      return false;
+    }
+  }
   desc.type = static_cast<impeller::TextureType>(texture_type);
   desc.size = {std::max<int64_t>(1, parent_desc.size.width >> base_mip),
                std::max<int64_t>(1, parent_desc.size.height >> base_mip)};
@@ -410,6 +418,33 @@ bool InternalFlutterGpu_Texture_McsmInitializeView(
   return true;
 }
 
