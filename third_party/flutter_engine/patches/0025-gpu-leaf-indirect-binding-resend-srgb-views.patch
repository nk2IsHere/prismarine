       return true;
     }
   }
@@ -189,11 +195,16 @@ void RenderPass::McsmSendStorageBuffers() {
   // Metal's backend reads no metadata for a buffer, Vulkan's only the
   // binding; GLES has no storage buffers.
   static const impeller::ShaderMetadata kNoMetadata;
-  for (const auto& entry : mcsm_storage_bindings_) {
+  for (auto& entry : mcsm_storage_bindings_) {
     if (retained_bindings_) {
-      // Marks the index as written, so a uniform that held it is sent again.
-      SendBuffer(entry.stage, entry.slot.ext_res_0, &mcsm_storage_bindings_,
-                 true);
+      // mcsm10: sent only when it changed or another binding took its
+      // index since; the entry's address is its writer key.
+      const bool send =
+          SendBuffer(entry.stage, entry.slot.ext_res_0, &entry, entry.dirty);
+      entry.dirty = false;
+      if (!send) {
+        continue;
+      }
     }
     render_pass_->BindResource(entry.stage,
                                impeller::DescriptorType::kStorageBuffer,
@@ -201,11 +212,20 @@ void RenderPass::McsmSendStorageBuffers() {
   }
   // mcsm9: texel buffers, textures and samplers bound apart. Their Metal
   // indices are marked written, so a binding that held one is sent again.
-  for (const auto& entry : mcsm_bindings_) {
+  for (auto& entry : mcsm_bindings_) {
     if (retained_bindings_) {
-      SendTexture(entry.stage, entry.slot.ext_res_0, &mcsm_bindings_, true);
+      // mcsm10: as storage buffers, sent only when changed or displaced.
+      // Both indices are marked, so neither check may short-circuit.
+      bool send =
+          SendTexture(entry.stage, entry.slot.ext_res_0, &entry, entry.dirty);
       if (entry.slot.ext_res_1 != ~size_t{0}) {
-        SendBuffer(entry.stage, entry.slot.ext_res_1, &mcsm_bindings_, true);
+        send = SendBuffer(entry.stage, entry.slot.ext_res_1, &entry,
+                          entry.dirty) ||
+               send;
+      }
+      entry.dirty = false;
+      if (!send) {
+        continue;
       }
     }
     switch (entry.kind) {
@@ -237,7 +257,17 @@ bool RenderPass::McsmBind(McsmBinding binding) {
     if (entry.stage == binding.stage && entry.kind == binding.kind &&
         entry.slot.binding == binding.slot.binding &&
         entry.slot.ext_res_0 == binding.slot.ext_res_0) {
-      entry = std::move(binding);
+      // mcsm10: the same resource again leaves the entry clean.
+      const bool same =
+          entry.view.GetBuffer() == binding.view.GetBuffer() &&
+          entry.view.GetRange() == binding.view.GetRange() &&
+          entry.format == binding.format && entry.texture == binding.texture &&
+          entry.sampler.get() == binding.sampler.get() &&
+          entry.slot.ext_res_1 == binding.slot.ext_res_1;
+      if (!same) {
+        entry = std::move(binding);
+        entry.dirty = true;
+      }
       return true;
     }
   }
@@ -1749,6 +1779,31 @@ bool InternalFlutterGpu_RenderPass_McsmDrawIndirect(
       indexed);
 }
 
+// mcsm10: an indirect draw as a leaf call: only with the pipeline already
+// cached on the pass (so it never blocks); 2 when it isn't, for the caller to
+// draw through McsmDrawIndirect.
+int InternalFlutterGpu_RenderPass_McsmDrawIndirectCached(
+    flutter::gpu::RenderPass* wrapper,
+    flutter::gpu::DeviceBuffer* args,
+    int offset_in_bytes,
+    bool indexed) {
+  const size_t length = indexed ? 20u : 16u;
+  if (!args || offset_in_bytes < 0 || offset_in_bytes % 4 != 0 ||
+      static_cast<size_t>(offset_in_bytes) + length >
+          args->GetBuffer()->GetDeviceBufferDescriptor().size) {
+    return 0;
+  }
+  if (!wrapper->HasCachedPipeline()) {
+    return 2;
+  }
+  return wrapper->McsmDrawIndirect(
+             impeller::BufferView(args->GetBuffer(),
+                                  impeller::Range(offset_in_bytes, length)),
+             indexed)
+             ? 1
+             : 0;
+}
+
 bool InternalFlutterGpu_RenderPass_McsmBindTextureSampler(
     flutter::gpu::RenderPass* wrapper,
     flutter::gpu::Shader* shader,
