From a1c861c5bd32dc60d0d4f1c15236d9ee17ed20db Mon Sep 17 00:00:00 2001
From: mcsm <mcsm@localhost>
Date: Wed, 11 Nov 2026 16:24:11 +0100
Subject: [PATCH 23/25] impellerc (mcsm10): a subpass input (framebuffer fetch)
 takes no Metal texture index; mcsm9's explicit image indices gave it one, and
 SPIRV-Cross read it as colour attachment 1, so the 15 framebuffer blend
 pipelines failed to build at every start

---
 engine/src/flutter/impeller/compiler/compiler.cc | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/engine/src/flutter/impeller/compiler/compiler.cc b/engine/src/flutter/impeller/compiler/compiler.cc
index 4731e3d6f44..531ed47aa2f 100644
--- a/engine/src/flutter/impeller/compiler/compiler.cc
+++ b/engine/src/flutter/impeller/compiler/compiler.cc
@@ -224,6 +224,14 @@ static CompilerBackend CreateMSLCompiler(
       mcsm_resources.push_constant_buffers.size());
   for (auto& image_id :
        SortUniforms(&ir, sl_compiler.get(), spirv_cross::SPIRType::Image)) {
+    // mcsm10: a subpass input (framebuffer fetch) is no texture: SPIRV-Cross
+    // reads it as the colour attachment its texture index names, so an index
+    // here made the framebuffer blends read [[color(1)]], an attachment their
+    // pipelines don't have.
+    if (sl_compiler->get_type_from_variable(image_id).image.dim ==
+        spv::DimSubpassData) {
+      continue;
+    }
     sl_compiler->add_msl_resource_binding({
         .stage = execution_model,
         .basetype = spirv_cross::SPIRType::BaseType::Image,
