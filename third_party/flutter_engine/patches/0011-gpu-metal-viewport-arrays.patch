+bool PassBindingsCacheMTL::SetViewports(const Viewport* viewports,
+                                        const IRect32* scissors,
+                                        size_t count) {
+  constexpr size_t kMax = 16;
+  if (count == 0 || count > kMax) {
+    return false;
+  }
+  MTLViewport vp[kMax];
+  MTLScissorRect sc[kMax];
+  for (size_t i = 0; i < count; i++) {
+    const auto& v = viewports[i];
+    vp[i] = MTLViewport{
+        .originX = v.rect.GetX(),
+        .originY = v.rect.GetY(),
+        .width = v.rect.GetWidth(),
+        .height = v.rect.GetHeight(),
+        .znear = v.depth_range.z_near,
+        .zfar = v.depth_range.z_far,
+    };
+    const auto& s = scissors[i];
+    sc[i] = MTLScissorRect{
+        .x = static_cast<NSUInteger>(s.GetX()),
+        .y = static_cast<NSUInteger>(s.GetY()),
+        .width = static_cast<NSUInteger>(s.GetWidth()),
+        .height = static_cast<NSUInteger>(s.GetHeight()),
+    };
+  }
+  [encoder_ setViewports:vp count:count];
+  [encoder_ setScissorRects:sc count:count];
+  viewport_.reset();
+  scissor_.reset();
+  return true;
+}
