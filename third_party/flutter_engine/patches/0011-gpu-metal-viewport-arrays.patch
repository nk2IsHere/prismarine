+void RenderPass::McsmEndViewports() {
+  if (!mcsm_viewports_sent_) {
+    return;
+  }
+  mcsm_viewports_sent_ = false;
+  // The array set them all; the whole target, unless the draw sets its own.
+  const auto size = render_pass_->GetRenderTargetSize();
+  render_pass_->SetViewport(
+      impeller::Viewport{.rect = impeller::Rect::MakeSize(size)});
+  render_pass_->SetScissor(impeller::IRect32::MakeSize(size));
+}
+
+bool RenderPass::McsmSetViewports(const float* viewports,
+                                  const int32_t* scissors,
+                                  size_t count) {
+  if (count > 16 || GetContext()->GetBackendType() !=
+                        impeller::Context::BackendType::kMetal) {
+    return false;
+  }
+  mcsm_viewports_.clear();
+  mcsm_scissors_.clear();
+  for (size_t i = 0; i < count; i++) {
+    const float* v = viewports + 6 * i;
+    impeller::Viewport viewport;
+    viewport.rect = impeller::Rect::MakeXYWH(v[0], v[1], v[2], v[3]);
+    viewport.depth_range.z_near = v[4];
+    viewport.depth_range.z_far = v[5];
+    mcsm_viewports_.push_back(viewport);
+    const int32_t* s = scissors + 4 * i;
+    mcsm_scissors_.push_back(impeller::IRect32::MakeXYWH(s[0], s[1], s[2], s[3]));
+  }
+  mcsm_viewports_sent_ = false;
+  return true;
+}
