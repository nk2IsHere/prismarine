   if (ended_ && *ended_) {
     return false;  // mcsm7
   }
+  McsmEndViewports();  // mcsm7: replays draw with one viewport
   bool ok = true;
   // mcsm7: on Metal the encoder keeps bindings between draws, so a replayed
   // draw sends only what differs from the draw replayed before it (in this
@@ -1334,3 +1383,18 @@ bool InternalFlutterGpu_RenderPass_Replay(flutter::gpu::RenderPass* wrapper,
   }
   return wrapper->Replay(*list, indices.data(), static_cast<size_t>(count));
 }
+
+bool InternalFlutterGpu_RenderPass_McsmSetViewports(
+    flutter::gpu::RenderPass* wrapper,
+    Dart_Handle viewports_handle,
+    Dart_Handle scissors_handle,
+    int count) {
+  tonic::Float32List viewports(viewports_handle);
+  tonic::Int32List scissors(scissors_handle);
+  if (count < 0 || viewports.num_elements() < 6 * count ||
+      scissors.num_elements() < 4 * count) {
+    return false;
+  }
+  return wrapper->McsmSetViewports(viewports.data(), scissors.data(),
+                                   static_cast<size_t>(count));
+}
