diff --git a/engine/src/flutter/lib/gpu/shader.cc b/engine/src/flutter/lib/gpu/shader.cc
index 31c94704040..561303439ff 100644
--- a/engine/src/flutter/lib/gpu/shader.cc
+++ b/engine/src/flutter/lib/gpu/shader.cc
@@ -110,6 +110,7 @@ void Shader::ResetFrom(Shader& other) {
   uniform_structs_ = std::move(other.uniform_structs_);
   uniform_textures_ = std::move(other.uniform_textures_);
   descriptor_set_layouts_ = std::move(other.descriptor_set_layouts_);
+  ReresolveUniforms();
   if (code_changed) {
     is_dirty_ = true;
   }
@@ -191,6 +192,45 @@ const Shader::TextureBinding* Shader::GetUniformTexture(
   return &uniform->second;
 }
 
+int Shader::ResolveUniformStruct(const std::string& name) {
+  for (size_t i = 0; i < resolved_struct_names_.size(); i++) {
+    if (resolved_struct_names_[i] == name) {
+      return resolved_structs_[i] ? static_cast<int>(i) : -1;
+    }
+  }
+  const UniformBinding* binding = GetUniformStruct(name);
+  if (!binding) {
+    return -1;
+  }
+  resolved_struct_names_.push_back(name);
+  resolved_structs_.push_back(binding);
+  return static_cast<int>(resolved_structs_.size() - 1);
+}
+
+int Shader::ResolveUniformTexture(const std::string& name) {
+  for (size_t i = 0; i < resolved_texture_names_.size(); i++) {
+    if (resolved_texture_names_[i] == name) {
+      return resolved_textures_[i] ? static_cast<int>(i) : -1;
+    }
+  }
+  const TextureBinding* binding = GetUniformTexture(name);
+  if (!binding) {
+    return -1;
+  }
+  resolved_texture_names_.push_back(name);
+  resolved_textures_.push_back(binding);
+  return static_cast<int>(resolved_textures_.size() - 1);
+}
+
+void Shader::ReresolveUniforms() {
+  for (size_t i = 0; i < resolved_struct_names_.size(); i++) {
+    resolved_structs_[i] = GetUniformStruct(resolved_struct_names_[i]);
+  }
+  for (size_t i = 0; i < resolved_texture_names_.size(); i++) {
+    resolved_textures_[i] = GetUniformTexture(resolved_texture_names_[i]);
+  }
+}
+
 }  // namespace gpu
 }  // namespace flutter
 
@@ -210,6 +250,20 @@ int InternalFlutterGpu_Shader_GetUniformStructSize(
   return uniform->size_in_bytes;
 }
 
+int InternalFlutterGpu_Shader_ResolveUniformStruct(
+    flutter::gpu::Shader* wrapper,
+    Dart_Handle struct_name_handle) {
+  return wrapper->ResolveUniformStruct(
+      tonic::StdStringFromDart(struct_name_handle));
+}
+
+int InternalFlutterGpu_Shader_ResolveUniformTexture(
+    flutter::gpu::Shader* wrapper,
+    Dart_Handle texture_name_handle) {
+  return wrapper->ResolveUniformTexture(
+      tonic::StdStringFromDart(texture_name_handle));
+}
