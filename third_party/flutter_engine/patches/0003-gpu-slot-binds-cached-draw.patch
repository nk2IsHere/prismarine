diff --git a/engine/src/flutter/lib/gpu/shader.h b/engine/src/flutter/lib/gpu/shader.h
index feae2821a8c..93a59bb9681 100644
--- a/engine/src/flutter/lib/gpu/shader.h
+++ b/engine/src/flutter/lib/gpu/shader.h
@@ -90,7 +90,35 @@ class Shader : public RefCountedDartWrappable<Shader> {
   const Shader::TextureBinding* GetUniformTexture(
       const std::string& name) const;
 
+  /// mcsm E3: a small index for a uniform struct (or texture) name, stable
+  /// for this shader's life (a reload re-resolves the names), or -1 when the
+  /// shader has no such uniform. Binds can then pass the index instead of
+  /// the name.
+  int ResolveUniformStruct(const std::string& name);
+  int ResolveUniformTexture(const std::string& name);
+
+  /// The binding for a resolved index; null for an unknown index or a name
+  /// a reload removed.
+  const UniformBinding* GetResolvedUniformStruct(int index) const {
+    return index >= 0 && static_cast<size_t>(index) < resolved_structs_.size()
+               ? resolved_structs_[index]
+               : nullptr;
+  }
+  const TextureBinding* GetResolvedUniformTexture(int index) const {
+    return index >= 0 &&
+                   static_cast<size_t>(index) < resolved_textures_.size()
+               ? resolved_textures_[index]
+               : nullptr;
+  }
+
  private:
+  void ReresolveUniforms();
+
+  std::vector<std::string> resolved_struct_names_;
+  std::vector<const UniformBinding*> resolved_structs_;
+  std::vector<std::string> resolved_texture_names_;
+  std::vector<const TextureBinding*> resolved_textures_;
+
   Shader();
 
   // Stable per-source identifier used to namespace this shader's entrypoint
@@ -129,6 +157,16 @@ extern int InternalFlutterGpu_Shader_GetUniformStructSize(
     flutter::gpu::Shader* wrapper,
     Dart_Handle struct_name_handle);
 
+FLUTTER_GPU_EXPORT
+extern int InternalFlutterGpu_Shader_ResolveUniformStruct(
+    flutter::gpu::Shader* wrapper,
+    Dart_Handle struct_name_handle);
+
+FLUTTER_GPU_EXPORT
+extern int InternalFlutterGpu_Shader_ResolveUniformTexture(
+    flutter::gpu::Shader* wrapper,
+    Dart_Handle texture_name_handle);
+
 FLUTTER_GPU_EXPORT
 extern int InternalFlutterGpu_Shader_GetUniformMemberOffset(
     flutter::gpu::Shader* wrapper,
