--- a/engine/src/flutter/lib/gpu/render_pass.cc
+++ b/engine/src/flutter/lib/gpu/render_pass.cc
@@ -243,6 +243,24 @@ RenderPass::GetCachedPipeline() {
   return pipeline;
 }
 
+bool RenderPass::HasCachedPipeline() {
+  if (last_pipeline_ && render_pipeline_.get() == last_render_pipeline_ &&
+      pipeline_state_version_ == last_pipeline_state_version_) {
+    return true;
+  }
+  if (!render_pipeline_) {
+    return false;
+  }
+  PipelineStateKey key = MakePipelineStateKey();
+  for (const auto& entry : pipeline_cache_) {
+    if (entry.render_pipeline.get() == render_pipeline_.get() &&
+        entry.key == key) {
+      return true;
+    }
+  }
+  return false;
+}
+
 bool RenderPass::SendBuffer(impeller::ShaderStage stage,
                             size_t index,
                             const void* writer,
@@ -555,16 +573,13 @@ void InternalFlutterGpu_RenderPass_BindIndexBufferDevice(
                   length_in_bytes, index_type);
 }
 
