@@ -845,6 +909,20 @@ bool InternalFlutterGpu_RenderPass_Draw(flutter::gpu::RenderPass* wrapper,
          wrapper->Draw(vertex_count, instance_count, /*indexed=*/false);
 }
 
+int InternalFlutterGpu_RenderPass_DrawCached(
+    flutter::gpu::RenderPass* wrapper,
+    int element_count,
+    int instance_count,
+    bool indexed) {
+  if (element_count < 0 || instance_count < 0) {
+    return 0;
+  }
+  if (!wrapper->HasCachedPipeline()) {
+    return 2;
+  }
+  return wrapper->Draw(element_count, instance_count, indexed) ? 1 : 0;
+}
+
 bool InternalFlutterGpu_RenderPass_DrawIndexed(
     flutter::gpu::RenderPass* wrapper,
     int index_count,
