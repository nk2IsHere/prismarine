+    int height_address_mode,
+    int max_anisotropy) {
+  return BindTextureBinding(wrapper, shader,
+                            shader->GetResolvedUniformTexture(texture_index),
+                            texture, min_filter, mag_filter, mip_filter,
+                            width_address_mode, height_address_mode,
