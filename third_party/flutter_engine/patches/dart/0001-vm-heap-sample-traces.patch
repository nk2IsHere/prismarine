@@ -1391,6 +1397,12 @@ class FastObjectCopyBase : public ObjectCopyBase {
     if (Heap::IsAllocatableInNewSpace(size)) {
       const uword alloc = new_space_->TryAllocateNoSafepoint(thread_, size);
       if (alloc != 0) {
+#if !defined(PRODUCT)
