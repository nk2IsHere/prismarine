 }
 
+intptr_t Heap::McsmIdle(int64_t deadline,
+                        intptr_t min_new_words,
+                        intptr_t max_new_words) {
+  Thread* thread = Thread::Current();
+  mcsm_last_idle_micros_ = OS::GetCurrentMonotonicMicros();
+  intptr_t ran = 0;
+  // Decided before any safepoint operation: a call that runs nothing stops
+  // no other mutator.
+  if (new_space_.McsmShouldScavenge(deadline, min_new_words, max_new_words)) {
+    CollectNewSpaceGarbage(thread, GCType::kScavenge, GCReason::kIdle);
+    ran |= 1;
+  }
+  // The thresholds as they are outside latency mode: this call is where an
+  // embedder that holds the VM in latency mode lets old-space work start.
+  const Dart_PerformanceMode mode = mode_.exchange(Dart_PerformanceMode_Default);
+  PageSpace::Phase phase;
+  {
+    MonitorLocker ml(old_space_.tasks_lock());
+    phase = old_space_.phase();
+  }
+  if (phase == PageSpace::kAwaitingFinalization ||
+      (phase == PageSpace::kDone && old_space_.ReachedSoftThreshold())) {
+    // Another mutator may have acted meanwhile: decided again with every
+    // mutator stopped.
+    GcSafepointOperationScope safepoint_operation(thread);
+    {
+      MonitorLocker ml(old_space_.tasks_lock());
+      phase = old_space_.phase();
+    }
+    if (phase == PageSpace::kAwaitingFinalization) {
+      CollectOldSpaceGarbage(thread, GCType::kMarkSweep, GCReason::kFinalize);
+      ran |= 4;
+    } else if (phase == PageSpace::kDone &&
+               old_space_.ReachedSoftThreshold()) {
+      // Right after the young collection: the start pause is the root set's,
+      // mostly new space.
+      StartConcurrentMarking(thread, GCReason::kIdle);
+      ran |= 2;
+    }
+  }
+  mode_ = mode;
+  return ran;
+}
+
+bool Heap::McsmIdleRecent() const {
+  const int64_t last = mcsm_last_idle_micros_;
+  return last != 0 && (OS::GetCurrentMonotonicMicros() - last) < 100000;
+}
+
 void Heap::NotifyDestroyed() {
   TIMELINE_FUNCTION_GC_DURATION(Thread::Current(), "NotifyDestroyed");
   CollectAllGarbage(GCReason::kDestroyed, /*compact=*/true);
@@ -611,6 +660,10 @@ void Heap::CheckConcurrentMarking(Thread* thread,
       }
       return;
     case PageSpace::kAwaitingFinalization:
+      // mcsm: the embedder's next idle call finalizes (Dart_McsmIdle).
+      if (McsmIdleRecent()) {
+        return;
+      }
       CollectOldSpaceGarbage(thread, GCType::kMarkSweep, GCReason::kFinalize);
       return;
     case PageSpace::kDone:
@@ -633,6 +686,10 @@ void Heap::CheckFinalizeMarking(Thread* thread) {
   }
 
   if (phase == PageSpace::kAwaitingFinalization) {
+    // mcsm: the embedder's next idle call finalizes (Dart_McsmIdle).
+    if (McsmIdleRecent()) {
+      return;
+    }
     CollectOldSpaceGarbage(thread, GCType::kMarkSweep, GCReason::kFinalize);
   }
 }
