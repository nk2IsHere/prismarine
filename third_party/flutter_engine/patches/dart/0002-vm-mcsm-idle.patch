From: mcsm <mcsm@localhost>
Subject: [PATCH] vm (mcsm): collections at the embedder's idle point
 (Dart_McsmIdle): a young collection by new-space use and deadline, old-space
 work only at the normal thresholds, a finished mark finalized by the next
 idle call while they arrive

diff --git a/runtime/include/dart_api.h b/runtime/include/dart_api.h
index e4d6db44..ebb45790 100644
--- a/runtime/include/dart_api.h
+++ b/runtime/include/dart_api.h
@@ -1217,6 +1217,28 @@ DART_EXPORT void Dart_KillIsolate(Dart_Isolate isolate);
  */
 DART_EXPORT void Dart_NotifyIdle(int64_t deadline);
 
+/**
+ * mcsm: collections at the embedder's idle point, in place of Dart_NotifyIdle
+ * (which also starts an old-space mark once old space grew by two pages).
+ *
+ * A young collection runs when new space holds at least |min_new_bytes| and
+ * the VM's estimate of it ends by |deadline|, or when it holds
+ * |max_new_bytes| (then whatever the deadline). Old-space work only as the
+ * normal thresholds ask: a finished mark is finalized here, and marking
+ * starts here once the soft threshold is reached. No idle compaction; the
+ * page cache is kept. While these calls arrive (one in the last 100 ms), a
+ * finished mark waits for the next one rather than being finalized from an
+ * allocation or an interrupt.
+ *
+ * |deadline| as Dart_NotifyIdle's. Returns what ran: 1 a young collection,
+ * 2 a mark started, 4 a mark finalized.
+ *
+ * Requires there to be a current isolate.
+ */
+DART_EXPORT int64_t Dart_McsmIdle(int64_t deadline,
+                                  int64_t min_new_bytes,
+                                  int64_t max_new_bytes);
+
 typedef void (*Dart_HeapSamplingReportCallback)(void* context, void* data);
 
 typedef void* (*Dart_HeapSamplingCreateCallback)(
diff --git a/runtime/vm/dart_api_impl.cc b/runtime/vm/dart_api_impl.cc
index ac526ee0..3471bfef 100644
--- a/runtime/vm/dart_api_impl.cc
+++ b/runtime/vm/dart_api_impl.cc
@@ -1745,6 +1745,17 @@ DART_EXPORT void Dart_NotifyIdle(int64_t deadline) {
   T->isolate()->group()->idle_time_handler()->NotifyIdle(deadline);
 }
 
+DART_EXPORT int64_t Dart_McsmIdle(int64_t deadline,
+                                  int64_t min_new_bytes,
+                                  int64_t max_new_bytes) {
+  Thread* T = Thread::Current();
+  CHECK_ISOLATE(T->isolate());
+  API_TIMELINE_BEGIN_END(T);
+  TransitionNativeToVM transition(T);
+  return T->heap()->McsmIdle(deadline, min_new_bytes >> kWordSizeLog2,
+                             max_new_bytes >> kWordSizeLog2);
+}
+
