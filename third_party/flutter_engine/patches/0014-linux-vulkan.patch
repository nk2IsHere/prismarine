+#include <algorithm>
+
+#include "flutter/fml/logging.h"
+
+namespace flutter {
+
+struct McsmVulkanSwapchain::Procs {
+  PFN_vkDestroySurfaceKHR DestroySurfaceKHR = nullptr;
+  PFN_vkGetPhysicalDeviceSurfaceSupportKHR GetSurfaceSupport = nullptr;
+  PFN_vkGetPhysicalDeviceSurfaceCapabilitiesKHR GetSurfaceCapabilities =
+      nullptr;
+  PFN_vkGetPhysicalDeviceSurfaceFormatsKHR GetSurfaceFormats = nullptr;
+  PFN_vkGetPhysicalDeviceSurfacePresentModesKHR GetPresentModes = nullptr;
+  PFN_vkCreateSwapchainKHR CreateSwapchainKHR = nullptr;
+  PFN_vkDestroySwapchainKHR DestroySwapchainKHR = nullptr;
+  PFN_vkGetSwapchainImagesKHR GetSwapchainImagesKHR = nullptr;
+  PFN_vkAcquireNextImageKHR AcquireNextImageKHR = nullptr;
+  PFN_vkQueuePresentKHR QueuePresentKHR = nullptr;
+  PFN_vkQueueSubmit QueueSubmit = nullptr;
+  PFN_vkQueueWaitIdle QueueWaitIdle = nullptr;
+  PFN_vkCreateCommandPool CreateCommandPool = nullptr;
+  PFN_vkDestroyCommandPool DestroyCommandPool = nullptr;
+  PFN_vkAllocateCommandBuffers AllocateCommandBuffers = nullptr;
+  PFN_vkResetCommandBuffer ResetCommandBuffer = nullptr;
+  PFN_vkBeginCommandBuffer BeginCommandBuffer = nullptr;
+  PFN_vkEndCommandBuffer EndCommandBuffer = nullptr;
+  PFN_vkCmdPipelineBarrier CmdPipelineBarrier = nullptr;
+  PFN_vkCmdCopyImage CmdCopyImage = nullptr;
+  PFN_vkCmdClearColorImage CmdClearColorImage = nullptr;
+  PFN_vkCreateFence CreateFence = nullptr;
+  PFN_vkDestroyFence DestroyFence = nullptr;
+  PFN_vkWaitForFences WaitForFences = nullptr;
+  PFN_vkResetFences ResetFences = nullptr;
+  PFN_vkCreateSemaphore CreateSemaphore = nullptr;
+  PFN_vkDestroySemaphore DestroySemaphore = nullptr;
+  // One render-finished semaphore per swapchain image.
+  std::vector<VkSemaphore> rendered;
+};
+
+std::unique_ptr<McsmVulkanSwapchain> McsmVulkanSwapchain::Create(
+    McsmVulkanDevice* device,
+    VkSurfaceKHR surface,
+    uint32_t width,
+    uint32_t height,
+    bool vsync) {
+  std::unique_ptr<McsmVulkanSwapchain> self(new McsmVulkanSwapchain());
+  self->device_ = device;
+  self->surface_ = surface;
+  self->width_ = width;
+  self->height_ = height;
+  self->vsync_ = vsync;
+  auto p = std::make_unique<Procs>();
+#define MCSM_I(field, name) \
+  p->field = reinterpret_cast<PFN_vk##name>(device->InstanceProc("vk" #name))
+#define MCSM_D(field, name) \
+  p->field = reinterpret_cast<PFN_vk##name>(device->DeviceProc("vk" #name))
+  MCSM_I(DestroySurfaceKHR, DestroySurfaceKHR);
+  MCSM_I(GetSurfaceSupport, GetPhysicalDeviceSurfaceSupportKHR);
+  MCSM_I(GetSurfaceCapabilities, GetPhysicalDeviceSurfaceCapabilitiesKHR);
+  MCSM_I(GetSurfaceFormats, GetPhysicalDeviceSurfaceFormatsKHR);
+  MCSM_I(GetPresentModes, GetPhysicalDeviceSurfacePresentModesKHR);
+  MCSM_D(CreateSwapchainKHR, CreateSwapchainKHR);
+  MCSM_D(DestroySwapchainKHR, DestroySwapchainKHR);
+  MCSM_D(GetSwapchainImagesKHR, GetSwapchainImagesKHR);
+  MCSM_D(AcquireNextImageKHR, AcquireNextImageKHR);
+  MCSM_D(QueuePresentKHR, QueuePresentKHR);
+  MCSM_D(QueueSubmit, QueueSubmit);
+  MCSM_D(QueueWaitIdle, QueueWaitIdle);
+  MCSM_D(CreateCommandPool, CreateCommandPool);
+  MCSM_D(DestroyCommandPool, DestroyCommandPool);
+  MCSM_D(AllocateCommandBuffers, AllocateCommandBuffers);
+  MCSM_D(ResetCommandBuffer, ResetCommandBuffer);
+  MCSM_D(BeginCommandBuffer, BeginCommandBuffer);
+  MCSM_D(EndCommandBuffer, EndCommandBuffer);
+  MCSM_D(CmdPipelineBarrier, CmdPipelineBarrier);
+  MCSM_D(CmdCopyImage, CmdCopyImage);
+  MCSM_D(CmdClearColorImage, CmdClearColorImage);
+  MCSM_D(CreateFence, CreateFence);
+  MCSM_D(DestroyFence, DestroyFence);
+  MCSM_D(WaitForFences, WaitForFences);
+  MCSM_D(ResetFences, ResetFences);
+  MCSM_D(CreateSemaphore, CreateSemaphore);
+  MCSM_D(DestroySemaphore, DestroySemaphore);
+#undef MCSM_I
+#undef MCSM_D
+  self->procs_ = std::move(p);
+  auto& procs = *self->procs_;
+
+  VkBool32 supported = VK_FALSE;
+  procs.GetSurfaceSupport(device->physical_device(),
+                          device->queue_family_index(), surface, &supported);
+  if (!supported) {
+    FML_LOG(ERROR) << "The Vulkan queue can't present to this window.";
+    return nullptr;
+  }
+  VkDevice dev = device->device();
+  VkCommandPoolCreateInfo pool_info = {
+      VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  pool_info.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+  pool_info.queueFamilyIndex = device->queue_family_index();
+  procs.CreateCommandPool(dev, &pool_info, nullptr, &self->pool_);
+  VkCommandBufferAllocateInfo alloc = {
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  alloc.commandPool = self->pool_;
+  alloc.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+  alloc.commandBufferCount = 1;
+  procs.AllocateCommandBuffers(dev, &alloc, &self->cmd_);
+  VkFenceCreateInfo fence_info = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  procs.CreateFence(dev, &fence_info, nullptr, &self->fence_);
+  VkSemaphoreCreateInfo sem_info = {VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+  procs.CreateSemaphore(dev, &sem_info, nullptr, &self->acquired_);
+  if (!self->Build()) {
+    return nullptr;
+  }
+  return self;
+}
+
+McsmVulkanSwapchain::~McsmVulkanSwapchain() {
+  if (!procs_) {
+    return;
+  }
+  VkDevice dev = device_->device();
+  {
+    std::scoped_lock lock(device_->queue_mutex());
+    procs_->QueueWaitIdle(device_->queue());
+  }
+  DestroySwapchain(swapchain_);
+  for (VkSemaphore s : procs_->rendered) {
+    procs_->DestroySemaphore(dev, s, nullptr);
+  }
+  if (acquired_ != VK_NULL_HANDLE) {
+    procs_->DestroySemaphore(dev, acquired_, nullptr);
+  }
+  if (fence_ != VK_NULL_HANDLE) {
+    procs_->DestroyFence(dev, fence_, nullptr);
+  }
+  if (pool_ != VK_NULL_HANDLE) {
+    procs_->DestroyCommandPool(dev, pool_, nullptr);
+  }
+  if (surface_ != VK_NULL_HANDLE) {
+    procs_->DestroySurfaceKHR(device_->instance(), surface_, nullptr);
+  }
+}
+
+void McsmVulkanSwapchain::DestroySwapchain(VkSwapchainKHR swapchain) {
+  if (swapchain != VK_NULL_HANDLE) {
+    procs_->DestroySwapchainKHR(device_->device(), swapchain, nullptr);
+  }
+}
+
+bool McsmVulkanSwapchain::Build() {
+  auto& procs = *procs_;
+  VkPhysicalDevice phys = device_->physical_device();
+  VkDevice dev = device_->device();
+  VkSurfaceCapabilitiesKHR caps;
+  if (procs.GetSurfaceCapabilities(phys, surface_, &caps) != VK_SUCCESS) {
+    return false;
+  }
+  uint32_t count = 0;
+  procs.GetSurfaceFormats(phys, surface_, &count, nullptr);
+  std::vector<VkSurfaceFormatKHR> formats(count);
+  procs.GetSurfaceFormats(phys, surface_, &count, formats.data());
+  // BGRA8 unorm, as the backing stores (a plain copy; no sRGB encoding, as
+  // the GL path's blit).
+  auto chosen = std::find_if(formats.begin(), formats.end(), [](auto& f) {
+    return f.format == VK_FORMAT_B8G8R8A8_UNORM;
+  });
+  if (chosen == formats.end()) {
+    FML_LOG(ERROR) << "The window has no BGRA8 swapchain format.";
+    return false;
+  }
+  format_ = chosen->format;
+  count = 0;
+  procs.GetPresentModes(phys, surface_, &count, nullptr);
+  std::vector<VkPresentModeKHR> modes(count);
+  procs.GetPresentModes(phys, surface_, &count, modes.data());
+  auto has = [&](VkPresentModeKHR m) {
+    return std::find(modes.begin(), modes.end(), m) != modes.end();
+  };
+  VkPresentModeKHR mode = VK_PRESENT_MODE_FIFO_KHR;
+  if (!vsync_) {
+    if (has(VK_PRESENT_MODE_MAILBOX_KHR)) {
+      mode = VK_PRESENT_MODE_MAILBOX_KHR;
+    } else if (has(VK_PRESENT_MODE_IMMEDIATE_KHR)) {
+      mode = VK_PRESENT_MODE_IMMEDIATE_KHR;
+    }
+  }
+  VkExtent2D extent = {width_, height_};
+  if (caps.currentExtent.width != UINT32_MAX) {
+    extent = caps.currentExtent;
+  }
+  extent.width = std::clamp(extent.width, caps.minImageExtent.width,
+                            caps.maxImageExtent.width);
+  extent.height = std::clamp(extent.height, caps.minImageExtent.height,
+                             caps.maxImageExtent.height);
+  if (extent.width == 0 || extent.height == 0) {
+    return false;  // A minimized window.
+  }
+  uint32_t image_count = caps.minImageCount + 1;
+  if (caps.maxImageCount > 0) {
+    image_count = std::min(image_count, caps.maxImageCount);
+  }
+  VkSwapchainCreateInfoKHR info = {VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR};
+  info.surface = surface_;
+  info.minImageCount = image_count;
+  info.imageFormat = format_;
+  info.imageColorSpace = chosen->colorSpace;
+  info.imageExtent = extent;
+  info.imageArrayLayers = 1;
+  info.imageUsage =
+      VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+  info.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  info.preTransform = caps.currentTransform;
+  info.compositeAlpha =
+      (caps.supportedCompositeAlpha & VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR)
+          ? VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR
+          : static_cast<VkCompositeAlphaFlagBitsKHR>(
+                caps.supportedCompositeAlpha & (~caps.supportedCompositeAlpha + 1u));
+  info.presentMode = mode;
+  info.clipped = VK_TRUE;
+  info.oldSwapchain = swapchain_;
+  {
+    // Nothing of ours may still use the old images.
+    std::scoped_lock lock(device_->queue_mutex());
+    procs.QueueWaitIdle(device_->queue());
+  }
+  fence_pending_ = false;
+  VkSwapchainKHR created = VK_NULL_HANDLE;
+  VkResult result = procs.CreateSwapchainKHR(dev, &info, nullptr, &created);
+  DestroySwapchain(swapchain_);
+  swapchain_ = VK_NULL_HANDLE;
+  if (result != VK_SUCCESS) {
+    FML_LOG(ERROR) << "vkCreateSwapchainKHR failed: " << result;
+    return false;
+  }
+  swapchain_ = created;
+  count = 0;
+  procs.GetSwapchainImagesKHR(dev, swapchain_, &count, nullptr);
+  images_.resize(count);
+  procs.GetSwapchainImagesKHR(dev, swapchain_, &count, images_.data());
+  VkSemaphoreCreateInfo sem_info = {VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+  while (procs.rendered.size() < count) {
+    VkSemaphore s;
+    procs.CreateSemaphore(dev, &sem_info, nullptr, &s);
+    procs.rendered.push_back(s);
+  }
+  width_ = extent.width;
+  height_ = extent.height;
+  return true;
+}
+
+bool McsmVulkanSwapchain::Resize(uint32_t width, uint32_t height) {
+  if (swapchain_ != VK_NULL_HANDLE && width == width_ && height == height_) {
+    return true;
+  }
+  width_ = width;
+  height_ = height;
+  return Build();
+}
+
+bool McsmVulkanSwapchain::SetVsync(bool vsync) {
+  if (vsync == vsync_ && swapchain_ != VK_NULL_HANDLE) {
+    return true;
+  }
+  vsync_ = vsync;
+  return Build();
+}
+
+template <typename Record>
+bool McsmVulkanSwapchain::Frame(const Record& record) {
+  auto& procs = *procs_;
+  VkDevice dev = device_->device();
+  for (int attempt = 0; attempt < 2; attempt++) {
+    if (swapchain_ == VK_NULL_HANDLE && !Build()) {
+      return false;
+    }
+    if (fence_pending_) {
+      procs.WaitForFences(dev, 1, &fence_, VK_TRUE, UINT64_MAX);
+      fence_pending_ = false;
+    }
+    uint32_t index = 0;
+    VkResult acquired = procs.AcquireNextImageKHR(
+        dev, swapchain_, UINT64_MAX, acquired_, VK_NULL_HANDLE, &index);
+    if (acquired == VK_ERROR_OUT_OF_DATE_KHR) {
+      if (!Build()) {
+        return false;
+      }
+      continue;
+    }
+    if (acquired != VK_SUCCESS && acquired != VK_SUBOPTIMAL_KHR) {
+      FML_LOG(ERROR) << "vkAcquireNextImageKHR failed: " << acquired;
+      return false;
+    }
+    VkImage target = images_[index];
+    procs.ResetCommandBuffer(cmd_, 0);
+    VkCommandBufferBeginInfo begin = {
+        VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    procs.BeginCommandBuffer(cmd_, &begin);
+    VkImageMemoryBarrier to_dst = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    to_dst.srcAccessMask = 0;
+    to_dst.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    to_dst.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    to_dst.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    to_dst.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_dst.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_dst.image = target;
+    to_dst.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    procs.CmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                             nullptr, 1, &to_dst);
+    record(target);
+    VkImageMemoryBarrier to_present = to_dst;
+    to_present.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    to_present.dstAccessMask = 0;
+    to_present.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    to_present.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+    procs.CmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0,
+                             nullptr, 0, nullptr, 1, &to_present);
+    procs.EndCommandBuffer(cmd_);
+
+    VkSemaphore rendered = procs.rendered[index];
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkSubmitInfo submit = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit.waitSemaphoreCount = 1;
+    submit.pWaitSemaphores = &acquired_;
+    submit.pWaitDstStageMask = &wait_stage;
+    submit.commandBufferCount = 1;
+    submit.pCommandBuffers = &cmd_;
+    submit.signalSemaphoreCount = 1;
+    submit.pSignalSemaphores = &rendered;
+    procs.ResetFences(dev, 1, &fence_);
+    VkPresentInfoKHR present = {VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};
+    present.waitSemaphoreCount = 1;
+    present.pWaitSemaphores = &rendered;
+    present.swapchainCount = 1;
+    present.pSwapchains = &swapchain_;
+    present.pImageIndices = &index;
+    VkResult presented;
+    {
+      std::scoped_lock lock(device_->queue_mutex());
+      if (procs.QueueSubmit(device_->queue(), 1, &submit, fence_) !=
+          VK_SUCCESS) {
+        return false;
+      }
+      fence_pending_ = true;
+      presented = procs.QueuePresentKHR(device_->queue(), &present);
+    }
+    if (presented == VK_ERROR_OUT_OF_DATE_KHR ||
+        presented == VK_SUBOPTIMAL_KHR) {
+      Build();  // The next frame uses the rebuilt swapchain.
+      return true;
+    }
+    return presented == VK_SUCCESS;
+  }
+  return false;
+}
+
+bool McsmVulkanSwapchain::Present(const McsmVulkanDevice::Image* image) {
+  auto& procs = *procs_;
+  return Frame([&](VkImage target) {
+    VkImageMemoryBarrier to_src = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    to_src.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    to_src.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    to_src.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    to_src.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    to_src.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_src.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_src.image = image->image;
+    to_src.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    procs.CmdPipelineBarrier(cmd_,
+                             VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                             VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                             nullptr, 1, &to_src);
+    VkImageCopy region = {};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.extent = {std::min(image->width, width_),
+                     std::min(image->height, height_), 1};
+    procs.CmdCopyImage(cmd_, image->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                       target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1,
+                       &region);
+    VkImageMemoryBarrier back = to_src;
+    back.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    back.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    back.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    back.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    procs.CmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0,
+                             0, nullptr, 0, nullptr, 1, &back);
+  });
+}
+
+bool McsmVulkanSwapchain::Clear() {
+  auto& procs = *procs_;
+  return Frame([&](VkImage target) {
+    VkClearColorValue color = {};
+    VkImageSubresourceRange range = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    procs.CmdClearColorImage(cmd_, target,
+                             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &color, 1,
+                             &range);
+  });
+}
+
+}  // namespace flutter
