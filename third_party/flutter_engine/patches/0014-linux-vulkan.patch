+# mcsm8: the Vulkan instance/device, backing-store images and readback the
+# desktop embedders hand to Impeller's Vulkan backend.
+source_set("mcsm_vulkan") {
+  public = [
+    "mcsm_vulkan_device.h",
+    "mcsm_vulkan_swapchain.h",
+  ]
+  sources = [
+    "mcsm_vulkan_device.cc",
+    "mcsm_vulkan_swapchain.cc",
+  ]
+  public_configs = [ "//flutter:config" ]
+  deps = [
+    "//flutter/fml",
+    "//flutter/shell/platform/embedder:embedder_headers",
+  ]
+  public_deps = [
+    "//flutter/third_party/vulkan-deps/vulkan-headers/src:vulkan_headers",
+  ]
+}
+
 # The portion of common_cpp that has no dependencies on the public/
 # headers. This division should be revisited once the Linux GTK
 # embedding is further along and it's clearer how much, if any, shared
diff --git a/engine/src/flutter/shell/platform/common/mcsm_vulkan_device.cc b/engine/src/flutter/shell/platform/common/mcsm_vulkan_device.cc
new file mode 100644
index 00000000000..7dbac4566f1
--- /dev/null
+++ b/engine/src/flutter/shell/platform/common/mcsm_vulkan_device.cc
@@ -0,0 +1,877 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
