+// found in the LICENSE file.
+
+// mcsm8: a window's Vulkan swapchain for a desktop compositor: a backing
+// store's image (as the engine leaves it: COLOR_ATTACHMENT_OPTIMAL) is copied
+// into the next swapchain image and presented. One frame in flight.
+
+#ifndef FLUTTER_SHELL_PLATFORM_COMMON_MCSM_VULKAN_SWAPCHAIN_H_
+#define FLUTTER_SHELL_PLATFORM_COMMON_MCSM_VULKAN_SWAPCHAIN_H_
+
+#include <memory>
+#include <vector>
+
+#include "flutter/shell/platform/common/mcsm_vulkan_device.h"
+
+namespace flutter {
+
+class McsmVulkanSwapchain {
+ public:
+  // Takes ownership of [surface]. Null when the device's queue can't present
+  // to it or the swapchain can't be made.
+  static std::unique_ptr<McsmVulkanSwapchain> Create(McsmVulkanDevice* device,
+                                                     VkSurfaceKHR surface,
+                                                     uint32_t width,
+                                                     uint32_t height,
+                                                     bool vsync);
+
+  ~McsmVulkanSwapchain();
+
+  uint32_t width() const { return width_; }
+  uint32_t height() const { return height_; }
+  bool vsync() const { return vsync_; }
+  bool IsValid() const { return swapchain_ != VK_NULL_HANDLE; }
+
+  // Recreates the swapchain at the new size (a no-op at the same size).
+  bool Resize(uint32_t width, uint32_t height);
+
+  // FIFO when [vsync], else MAILBOX or IMMEDIATE (the embedder paces frames
+  // itself, as eglSwapInterval(0) did).
+  bool SetVsync(bool vsync);
+
+  // Copies [image]'s top-left [width]x[height] into the next image and
+  // presents it; the image is back in COLOR_ATTACHMENT_OPTIMAL afterwards.
+  bool Present(const McsmVulkanDevice::Image* image);
+
+  // Presents a transparent frame.
+  bool Clear();
+
+ private:
+  McsmVulkanSwapchain() = default;
+  bool Build();
+  void DestroySwapchain(VkSwapchainKHR swapchain);
+  // Acquires, records [record] between the layout transitions, submits and
+  // presents; rebuilds and retries once when the swapchain is out of date.
