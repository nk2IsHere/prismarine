diff --git a/engine/src/flutter/shell/platform/linux/fl_compositor_vulkan.cc b/engine/src/flutter/shell/platform/linux/fl_compositor_vulkan.cc
new file mode 100644
index 00000000000..5dd91e5b07b
--- /dev/null
+++ b/engine/src/flutter/shell/platform/linux/fl_compositor_vulkan.cc
@@ -0,0 +1,174 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/linux/fl_compositor_vulkan.h"
+
+#include <cstring>
+#include <vector>
+
+// mcsm8: the copy path. Each presented layer's VkImage (BGRA8, premultiplied,
+// which is cairo's ARGB32 in memory) is read back after the engine's host
+// sync and composited in order into one cairo surface that GTK's draw
+// callback paints.
+struct _FlCompositorVulkan {
+  FlCompositor parent_instance;
+
+  FlTaskRunner* task_runner;
+  flutter::McsmVulkanDevice* device;
+
+  // The last frame.
+  size_t width;
+  size_t height;
+  cairo_surface_t* surface;
+
+  // One layer read back.
+  std::vector<uint8_t>* scratch;
+
+  GMutex frame_mutex;
+};
+
+G_DEFINE_TYPE(FlCompositorVulkan, fl_compositor_vulkan, fl_compositor_get_type())
+
+static gboolean fl_compositor_vulkan_present_layers(FlCompositor* compositor,
+                                                    const FlutterLayer** layers,
+                                                    size_t layers_count) {
+  FlCompositorVulkan* self = FL_COMPOSITOR_VULKAN(compositor);
+
+  if (layers_count == 0) {
+    return TRUE;
+  }
+
+  const size_t width = layers[0]->size.width;
+  const size_t height = layers[0]->size.height;
+  cairo_surface_t* surface =
+      cairo_image_surface_create(CAIRO_FORMAT_ARGB32, width, height);
+  cairo_t* cr = cairo_create(surface);
+  for (size_t i = 0; i < layers_count; i++) {
+    const FlutterLayer* layer = layers[i];
+    if (layer->type != kFlutterLayerContentTypeBackingStore ||
+        layer->backing_store->type != kFlutterBackingStoreTypeVulkan) {
+      continue;
+    }
+    auto* image = static_cast<flutter::McsmVulkanDevice::Image*>(
+        layer->backing_store->vulkan.user_data);
+    const size_t row_bytes = static_cast<size_t>(image->width) * 4;
+    self->scratch->resize(row_bytes * image->height);
+    if (!self->device->ReadImage(image, self->scratch->data(), row_bytes)) {
+      g_warning("Failed to read back a Vulkan layer");
+      continue;
+    }
+    cairo_surface_t* layer_surface = cairo_image_surface_create_for_data(
+        self->scratch->data(), CAIRO_FORMAT_ARGB32, image->width,
+        image->height, row_bytes);
+    cairo_set_operator(cr, i == 0 ? CAIRO_OPERATOR_SOURCE : CAIRO_OPERATOR_OVER);
+    cairo_set_source_surface(cr, layer_surface, layer->offset.x,
+                             layer->offset.y);
+    cairo_paint(cr);
+    cairo_surface_destroy(layer_surface);
+  }
+  cairo_destroy(cr);
+  cairo_surface_flush(surface);
+
+  {
+    g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->frame_mutex);
+    g_clear_pointer(&self->surface, cairo_surface_destroy);
+    self->surface = surface;
+    self->width = width;
+    self->height = height;
+  }
+
+  fl_task_runner_stop_wait(self->task_runner);
+  return TRUE;
+}
+
+static void fl_compositor_vulkan_get_frame_size(FlCompositor* compositor,
+                                                size_t* width,
+                                                size_t* height) {
+  FlCompositorVulkan* self = FL_COMPOSITOR_VULKAN(compositor);
+  g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->frame_mutex);
+  if (width != nullptr) {
+    *width = self->width;
+  }
+  if (height != nullptr) {
+    *height = self->height;
+  }
+}
+
+static gboolean fl_compositor_vulkan_render(FlCompositor* compositor,
+                                            cairo_t* cr,
+                                            GdkWindow* window,
+                                            gboolean wait_for_frame) {
+  FlCompositorVulkan* self = FL_COMPOSITOR_VULKAN(compositor);
+
+  g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->frame_mutex);
+
+  if (self->surface == nullptr) {
+    return FALSE;
+  }
+
+  // As the software compositor: wait for a frame of the window's size.
+  gint scale_factor = gdk_window_get_scale_factor(window);
+  if (wait_for_frame) {
+    gint64 expiry_time =
+        g_get_monotonic_time() + kCompositorRenderTimeoutMicroseconds;
+    while (true) {
+      size_t width = gdk_window_get_width(window) * scale_factor;
+      size_t height = gdk_window_get_height(window) * scale_factor;
+      if (self->width == width && self->height == height) {
+        break;
+      }
+      if (g_get_monotonic_time() > expiry_time) {
+        g_warning(
+            "Timed out waiting for Vulkan frame of size %zdx%zd (have "
+            "%zdx%zd)",
+            width, height, self->width, self->height);
+        break;
+      }
+      g_mutex_unlock(&self->frame_mutex);
+      fl_task_runner_wait(self->task_runner, expiry_time);
+      g_mutex_lock(&self->frame_mutex);
+    }
+  }
+
+  cairo_surface_set_device_scale(self->surface, scale_factor, scale_factor);
+  cairo_set_source_surface(cr, self->surface, 0.0, 0.0);
+  cairo_paint(cr);
+  return TRUE;
+}
+
+static void fl_compositor_vulkan_dispose(GObject* object) {
+  FlCompositorVulkan* self = FL_COMPOSITOR_VULKAN(object);
+
+  g_clear_object(&self->task_runner);
+  g_clear_pointer(&self->surface, cairo_surface_destroy);
+  delete self->scratch;
+  self->scratch = nullptr;
+  g_mutex_clear(&self->frame_mutex);
+
+  G_OBJECT_CLASS(fl_compositor_vulkan_parent_class)->dispose(object);
+}
+
+static void fl_compositor_vulkan_class_init(FlCompositorVulkanClass* klass) {
+  FL_COMPOSITOR_CLASS(klass)->present_layers =
+      fl_compositor_vulkan_present_layers;
+  FL_COMPOSITOR_CLASS(klass)->get_frame_size =
+      fl_compositor_vulkan_get_frame_size;
+  FL_COMPOSITOR_CLASS(klass)->render = fl_compositor_vulkan_render;
+  G_OBJECT_CLASS(klass)->dispose = fl_compositor_vulkan_dispose;
+}
+
+static void fl_compositor_vulkan_init(FlCompositorVulkan* self) {
+  g_mutex_init(&self->frame_mutex);
+  self->scratch = new std::vector<uint8_t>();
+}
+
+FlCompositorVulkan* fl_compositor_vulkan_new(
+    FlTaskRunner* task_runner,
+    flutter::McsmVulkanDevice* device) {
+  FlCompositorVulkan* self = FL_COMPOSITOR_VULKAN(
+      g_object_new(fl_compositor_vulkan_get_type(), nullptr));
+  self->task_runner = FL_TASK_RUNNER(g_object_ref(task_runner));
+  self->device = device;
+  return self;
+}
