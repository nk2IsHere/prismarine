@@ -0,0 +1,327 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/common/mcsm_vulkan_export_ring.h"
+
+#include <algorithm>
+#include <utility>
+
+#if !defined(_WIN32)
+#include <unistd.h>
+#endif
+
+#include "flutter/fml/logging.h"
+
+namespace flutter {
+
+struct McsmVulkanExportRing::Procs {
+  PFN_vkCreateImage CreateImage = nullptr;
+  PFN_vkDestroyImage DestroyImage = nullptr;
+  PFN_vkGetImageMemoryRequirements GetImageMemoryRequirements = nullptr;
+  PFN_vkAllocateMemory AllocateMemory = nullptr;
+  PFN_vkFreeMemory FreeMemory = nullptr;
+  PFN_vkBindImageMemory BindImageMemory = nullptr;
+  PFN_vkGetMemoryFdKHR GetMemoryFdKHR = nullptr;
+  PFN_vkCreateSemaphore CreateSemaphore = nullptr;
+  PFN_vkDestroySemaphore DestroySemaphore = nullptr;
+  PFN_vkGetSemaphoreFdKHR GetSemaphoreFdKHR = nullptr;
+  PFN_vkCreateCommandPool CreateCommandPool = nullptr;
+  PFN_vkDestroyCommandPool DestroyCommandPool = nullptr;
+  PFN_vkAllocateCommandBuffers AllocateCommandBuffers = nullptr;
+  PFN_vkResetCommandBuffer ResetCommandBuffer = nullptr;
+  PFN_vkBeginCommandBuffer BeginCommandBuffer = nullptr;
+  PFN_vkEndCommandBuffer EndCommandBuffer = nullptr;
+  PFN_vkCmdPipelineBarrier CmdPipelineBarrier = nullptr;
+  PFN_vkCmdBlitImage CmdBlitImage = nullptr;
+  PFN_vkCreateFence CreateFence = nullptr;
+  PFN_vkDestroyFence DestroyFence = nullptr;
+  PFN_vkWaitForFences WaitForFences = nullptr;
+  PFN_vkResetFences ResetFences = nullptr;
+  PFN_vkQueueSubmit QueueSubmit = nullptr;
+  PFN_vkQueueWaitIdle QueueWaitIdle = nullptr;
+  PFN_vkGetPhysicalDeviceMemoryProperties GetMemoryProperties = nullptr;
+};
+
+std::unique_ptr<McsmVulkanExportRing> McsmVulkanExportRing::Create(
+    McsmVulkanDevice* device,
+    uint32_t width,
+    uint32_t height) {
+#if defined(_WIN32)
+  return nullptr;
+#else
+  if (!device->external_fd() || width == 0 || height == 0) {
+    return nullptr;
+  }
+  std::unique_ptr<McsmVulkanExportRing> ring(new McsmVulkanExportRing());
+  ring->device_ = device;
+  ring->width_ = width;
+  ring->height_ = height;
+  if (!ring->Init()) {
+    return nullptr;
+  }
+  return ring;
+#endif
+}
+
+bool McsmVulkanExportRing::Init() {
+#if defined(_WIN32)
+  return false;
+#else
+  auto p = std::make_unique<Procs>();
+#define MCSM_D(name) \
+  p->name = reinterpret_cast<PFN_vk##name>(device_->DeviceProc("vk" #name))
+  MCSM_D(CreateImage);
+  MCSM_D(DestroyImage);
+  MCSM_D(GetImageMemoryRequirements);
+  MCSM_D(AllocateMemory);
+  MCSM_D(FreeMemory);
+  MCSM_D(BindImageMemory);
+  MCSM_D(GetMemoryFdKHR);
+  MCSM_D(CreateSemaphore);
+  MCSM_D(DestroySemaphore);
+  MCSM_D(GetSemaphoreFdKHR);
+  MCSM_D(CreateCommandPool);
+  MCSM_D(DestroyCommandPool);
+  MCSM_D(AllocateCommandBuffers);
+  MCSM_D(ResetCommandBuffer);
+  MCSM_D(BeginCommandBuffer);
+  MCSM_D(EndCommandBuffer);
+  MCSM_D(CmdPipelineBarrier);
+  MCSM_D(CmdBlitImage);
+  MCSM_D(CreateFence);
+  MCSM_D(DestroyFence);
+  MCSM_D(WaitForFences);
+  MCSM_D(ResetFences);
+  MCSM_D(QueueSubmit);
+  MCSM_D(QueueWaitIdle);
+#undef MCSM_D
+  p->GetMemoryProperties =
+      reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(
+          device_->InstanceProc("vkGetPhysicalDeviceMemoryProperties"));
+  procs_ = std::move(p);
+  auto& procs = *procs_;
+  if (procs.GetMemoryFdKHR == nullptr || procs.GetSemaphoreFdKHR == nullptr) {
+    return false;
+  }
+  VkDevice dev = device_->device();
+  VkPhysicalDeviceMemoryProperties memory_properties;
+  procs.GetMemoryProperties(device_->physical_device(), &memory_properties);
+
+  VkCommandPoolCreateInfo pool_info = {
+      VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  pool_info.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+  pool_info.queueFamilyIndex = device_->queue_family_index();
+  if (procs.CreateCommandPool(dev, &pool_info, nullptr, &pool_) !=
+      VK_SUCCESS) {
+    return false;
+  }
+
+  for (auto& slot : slots_) {
+    VkExternalMemoryImageCreateInfo external = {
+        VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO};
+    external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    VkImageCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    info.pNext = &external;
+    info.imageType = VK_IMAGE_TYPE_2D;
+    info.format = VK_FORMAT_R8G8B8A8_UNORM;
+    info.extent = {width_, height_, 1};
+    info.mipLevels = 1;
+    info.arrayLayers = 1;
+    info.samples = VK_SAMPLE_COUNT_1_BIT;
+    info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    info.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                 VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                 VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (procs.CreateImage(dev, &info, nullptr, &slot.image) != VK_SUCCESS) {
+      return false;
+    }
+    VkMemoryRequirements req;
+    procs.GetImageMemoryRequirements(dev, slot.image, &req);
+    uint32_t type = UINT32_MAX;
+    for (uint32_t i = 0; i < memory_properties.memoryTypeCount; i++) {
+      if ((req.memoryTypeBits & (1u << i)) &&
+          (memory_properties.memoryTypes[i].propertyFlags &
+           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+        type = i;
+        break;
+      }
+    }
+    if (type == UINT32_MAX) {
+      return false;
+    }
+    VkMemoryDedicatedAllocateInfo dedicated = {
+        VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO};
+    dedicated.image = slot.image;
+    VkExportMemoryAllocateInfo export_info = {
+        VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO};
+    export_info.pNext = &dedicated;
+    export_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    VkMemoryAllocateInfo alloc = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    alloc.pNext = &export_info;
+    alloc.allocationSize = req.size;
+    alloc.memoryTypeIndex = type;
+    if (procs.AllocateMemory(dev, &alloc, nullptr, &slot.memory) !=
+            VK_SUCCESS ||
+        procs.BindImageMemory(dev, slot.image, slot.memory, 0) != VK_SUCCESS) {
+      return false;
+    }
+    slot.size = req.size;
+    VkMemoryGetFdInfoKHR fd_info = {VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR};
+    fd_info.memory = slot.memory;
+    fd_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    if (procs.GetMemoryFdKHR(dev, &fd_info, &slot.memory_fd) != VK_SUCCESS) {
+      return false;
+    }
+    for (auto [sem, fd] : {std::pair{&slot.ready, &slot.ready_fd},
+                           std::pair{&slot.released, &slot.released_fd}}) {
+      VkExportSemaphoreCreateInfo export_sem = {
+          VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO};
+      export_sem.handleTypes = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT;
+      VkSemaphoreCreateInfo sem_info = {
+          VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+      sem_info.pNext = &export_sem;
+      if (procs.CreateSemaphore(dev, &sem_info, nullptr, sem) != VK_SUCCESS) {
+        return false;
+      }
+      VkSemaphoreGetFdInfoKHR sem_fd = {
+          VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR};
+      sem_fd.semaphore = *sem;
+      sem_fd.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT;
+      if (procs.GetSemaphoreFdKHR(dev, &sem_fd, fd) != VK_SUCCESS) {
+        return false;
+      }
+    }
+    VkCommandBufferAllocateInfo cmd_info = {
+        VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    cmd_info.commandPool = pool_;
+    cmd_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cmd_info.commandBufferCount = 1;
+    procs.AllocateCommandBuffers(dev, &cmd_info, &slot.cmd);
+    VkFenceCreateInfo fence_info = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    procs.CreateFence(dev, &fence_info, nullptr, &slot.fence);
+  }
+  return true;
+#endif
+}
+
+McsmVulkanExportRing::~McsmVulkanExportRing() {
+  if (!procs_) {
+    return;
+  }
+  VkDevice dev = device_->device();
+  {
+    std::scoped_lock lock(device_->queue_mutex());
+    procs_->QueueWaitIdle(device_->queue());
+  }
+  for (auto& slot : slots_) {
+#if !defined(_WIN32)
+    for (int fd : {slot.memory_fd, slot.ready_fd, slot.released_fd}) {
+      if (fd >= 0) {
+        close(fd);
+      }
+    }
+#endif
+    if (slot.fence != VK_NULL_HANDLE) {
+      procs_->DestroyFence(dev, slot.fence, nullptr);
+    }
+    if (slot.ready != VK_NULL_HANDLE) {
+      procs_->DestroySemaphore(dev, slot.ready, nullptr);
+    }
+    if (slot.released != VK_NULL_HANDLE) {
+      procs_->DestroySemaphore(dev, slot.released, nullptr);
+    }
+    if (slot.image != VK_NULL_HANDLE) {
+      procs_->DestroyImage(dev, slot.image, nullptr);
+    }
+    if (slot.memory != VK_NULL_HANDLE) {
+      procs_->FreeMemory(dev, slot.memory, nullptr);
+    }
+  }
+  if (pool_ != VK_NULL_HANDLE) {
+    procs_->DestroyCommandPool(dev, pool_, nullptr);
+  }
+}
+
+bool McsmVulkanExportRing::Blit(int k,
+                                const McsmVulkanDevice::Image* src,
+                                bool wait_released) {
+  auto& procs = *procs_;
+  auto& slot = slots_[k];
+  VkDevice dev = device_->device();
+  if (slot.fence_pending) {
+    // The slot's previous blit (three frames ago): long done in practice.
+    procs.WaitForFences(dev, 1, &slot.fence, VK_TRUE, UINT64_MAX);
+    slot.fence_pending = false;
+  }
+  procs.ResetCommandBuffer(slot.cmd, 0);
+  VkCommandBufferBeginInfo begin = {
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  procs.BeginCommandBuffer(slot.cmd, &begin);
+  VkImageMemoryBarrier barriers[2] = {};
+  barriers[0].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+  barriers[0].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  barriers[0].oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  barriers[0].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barriers[0].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barriers[0].image = src->image;
+  barriers[0].subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  barriers[1] = barriers[0];
+  barriers[1].srcAccessMask = 0;
+  barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barriers[1].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+  barriers[1].image = slot.image;
+  procs.CmdPipelineBarrier(
+      slot.cmd,
+      VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT |
+          VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+  VkImageBlit region = {};
+  region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  const int32_t w = static_cast<int32_t>(std::min(src->width, width_));
+  const int32_t h = static_cast<int32_t>(std::min(src->height, height_));
+  region.srcOffsets[1] = {w, h, 1};
+  region.dstOffsets[1] = {w, h, 1};
+  procs.CmdBlitImage(slot.cmd, src->image,
+                     VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, slot.image,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region,
+                     VK_FILTER_NEAREST);
+  VkImageMemoryBarrier back = barriers[0];
+  back.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  back.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  back.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  back.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  procs.CmdPipelineBarrier(slot.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, 0,
+                           nullptr, 0, nullptr, 1, &back);
+  procs.EndCommandBuffer(slot.cmd);
+
+  VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  VkSubmitInfo submit = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  if (wait_released) {
+    submit.waitSemaphoreCount = 1;
+    submit.pWaitSemaphores = &slot.released;
+    submit.pWaitDstStageMask = &wait_stage;
+  }
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &slot.cmd;
+  submit.signalSemaphoreCount = 1;
+  submit.pSignalSemaphores = &slot.ready;
+  procs.ResetFences(dev, 1, &slot.fence);
+  std::scoped_lock lock(device_->queue_mutex());
+  if (procs.QueueSubmit(device_->queue(), 1, &submit, slot.fence) !=
+      VK_SUCCESS) {
+    return false;
+  }
+  slot.fence_pending = true;
+  return true;
+}
+
+}  // namespace flutter
diff --git a/engine/src/flutter/shell/platform/common/mcsm_vulkan_export_ring.h b/engine/src/flutter/shell/platform/common/mcsm_vulkan_export_ring.h
new file mode 100644
index 00000000000..0e56d42197e
--- /dev/null
+++ b/engine/src/flutter/shell/platform/common/mcsm_vulkan_export_ring.h
@@ -0,0 +1,74 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// mcsm8: images and semaphores a GL compositor imports by fd (Linux): each
+// frame a layer's backing store is blitted (BGRA8 -> RGBA8) into the next of
+// three exportable images on the GPU, which signals that slot's "ready"
+// semaphore; GL waits on it, draws the image and signals the slot's
+// "released" semaphore, which the next blit into that slot waits on. No CPU
+// wait on the GPU per frame.
+
+#ifndef FLUTTER_SHELL_PLATFORM_COMMON_MCSM_VULKAN_EXPORT_RING_H_
+#define FLUTTER_SHELL_PLATFORM_COMMON_MCSM_VULKAN_EXPORT_RING_H_
+
+#include <array>
+#include <memory>
+
+#include "flutter/shell/platform/common/mcsm_vulkan_device.h"
+
+namespace flutter {
+
+class McsmVulkanExportRing {
+ public:
+  static constexpr int kSlots = 3;
+
+  struct Slot {
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkDeviceSize size = 0;
+    // fds for GL to import (each consumed by the import); -1 once taken.
+    int memory_fd = -1;
+    VkSemaphore ready = VK_NULL_HANDLE;
+    int ready_fd = -1;
+    VkSemaphore released = VK_NULL_HANDLE;
+    int released_fd = -1;
+    VkCommandBuffer cmd = VK_NULL_HANDLE;
+    VkFence fence = VK_NULL_HANDLE;
+    bool fence_pending = false;
+  };
+
+  // Null where the device can't share with GL by fd.
+  static std::unique_ptr<McsmVulkanExportRing> Create(McsmVulkanDevice* device,
+                                                      uint32_t width,
+                                                      uint32_t height);
+
+  ~McsmVulkanExportRing();
+
+  uint32_t width() const { return width_; }
+  uint32_t height() const { return height_; }
+  Slot& slot(int k) { return slots_[k]; }
+
+  // Blits [src] (COLOR_ATTACHMENT_OPTIMAL, left so) into slot [k], leaving
+  // the slot image in TRANSFER_DST_OPTIMAL; waits on the slot's released
+  // semaphore first when [wait_released] (GL signalled it since the last
+  // blit), signals its ready semaphore.
+  bool Blit(int k, const McsmVulkanDevice::Image* src, bool wait_released);
+
+ private:
+  McsmVulkanExportRing() = default;
+  bool Init();
+
+  McsmVulkanDevice* device_ = nullptr;
+  uint32_t width_ = 0;
+  uint32_t height_ = 0;
+  VkCommandPool pool_ = VK_NULL_HANDLE;
+  std::array<Slot, kSlots> slots_;
+
+  struct Procs;
+  std::unique_ptr<Procs> procs_;
+};
+
+}  // namespace flutter
+
+#endif  // FLUTTER_SHELL_PLATFORM_COMMON_MCSM_VULKAN_EXPORT_RING_H_
