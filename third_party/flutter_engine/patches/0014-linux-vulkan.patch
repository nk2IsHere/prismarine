+
+// mcsm8: the Vulkan instance and device a desktop embedder (Windows, Linux)
+// hands to the engine for Impeller's Vulkan backend, plus the backing-store
+// images and the copies its compositor needs. One per process.
+
+#ifndef FLUTTER_SHELL_PLATFORM_COMMON_MCSM_VULKAN_DEVICE_H_
+#define FLUTTER_SHELL_PLATFORM_COMMON_MCSM_VULKAN_DEVICE_H_
+
+#ifndef VK_NO_PROTOTYPES
+#define VK_NO_PROTOTYPES
+#endif
+#include <vulkan/vulkan.h>
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "flutter/shell/platform/embedder/embedder.h"
+
+namespace flutter {
+
+struct McsmVulkanProcs;
+
+class McsmVulkanDevice {
+ public:
+  struct Options {
+    // Window-system instance extensions to enable where the loader has them
+    // (Impeller wants VK_KHR_surface and at least one of these listed).
+    std::vector<std::string> wsi_instance_extensions;
+    // A device LUID to prefer (Windows' GPU preference).
+    std::optional<std::array<uint8_t, 8>> luid;
+  };
+
+  // A backing-store image: device-local, optimal tiling, colour/input
+  // attachment, transfer source and sampled. Freed when both the engine's
+  // destruction callback and the compositor's collect have released it.
+  struct Image {
+    McsmVulkanDevice* device = nullptr;
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    FlutterVulkanImage flutter_image = {};
+    uint32_t width = 0;
+    uint32_t height = 0;
+    std::atomic<int> refs{2};
+  };
+
+  // Null with [error] set when there is no usable Vulkan (no loader, no
+  // instance, no device that meets Impeller's needs).
+  static std::unique_ptr<McsmVulkanDevice> Create(const Options& options,
+                                                  std::string* error);
+
+  ~McsmVulkanDevice();
+
+  // A kVulkan renderer config for FlutterEngineRun. The image callbacks are
+  // stubs: with a compositor the engine renders into backing stores.
+  void FillRendererConfig(FlutterRendererConfig* config) const;
+
+  // "Vulkan <device> (api x.y.z, driver <v>, <type>)".
+  std::string Describe() const;
+
+  // Fills a kFlutterBackingStoreTypeVulkan backing store; false when the
+  // image can't be made.
+  bool CreateBackingStore(const FlutterBackingStoreConfig& config,
+                          FlutterBackingStore* out);
+  // The compositor's collect (the engine's destruction callback is the
+  // other release).
+  static void CollectBackingStore(const FlutterBackingStore* store);
+
+  // Copies [image] (in VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, as the
+  // engine leaves a rendered backing store) into [out] with [row_bytes] per
+  // row, restoring the layout. Blocks until the copy is done.
+  bool ReadImage(Image* image, uint8_t* out, size_t row_bytes);
+
+  VkInstance instance() const { return instance_; }
+  VkPhysicalDevice physical_device() const { return physical_device_; }
+  VkDevice device() const { return device_; }
+  VkQueue queue() const { return queue_; }
+  uint32_t queue_family_index() const { return queue_family_; }
+  uint32_t api_version() const { return api_version_; }
+  bool multi_viewport() const { return multi_viewport_; }
+  bool viewport_index_from_vertex() const { return viewport_index_; }
+
+  // The engine's and our queue submissions go through this (Vulkan requires
+  // external synchronization of a VkQueue; Flutter GPU submits from the UI
+  // thread, the rasterizer from the raster thread).
+  std::mutex& queue_mutex() { return queue_mutex_; }
+
+  // The loader's own functions (no locking), for embedder code such as a
+  // swapchain: lock queue_mutex() around queue calls.
+  PFN_vkVoidFunction InstanceProc(const char* name) const;
+  PFN_vkVoidFunction DeviceProc(const char* name) const;
+
+  // vkGetInstanceProcAddr as the engine sees it: queue functions wrapped
+  // with the mutex, everything else the loader's.
+  static void* GetInstanceProcAddress(void* user_data,
+                                      FlutterVulkanInstanceHandle instance,
+                                      const char* name);
+
+ private:
+  McsmVulkanDevice() = default;
+  bool Init(const Options& options, std::string* error);
+  void ReleaseImage(Image* image);
+  uint32_t FindMemoryType(uint32_t bits, VkMemoryPropertyFlags flags) const;
+  bool EnsureReadback(size_t bytes);
+
+  void* library_ = nullptr;
+  PFN_vkGetInstanceProcAddr gipa_ = nullptr;
+  VkInstance instance_ = VK_NULL_HANDLE;
+  VkPhysicalDevice physical_device_ = VK_NULL_HANDLE;
+  VkDevice device_ = VK_NULL_HANDLE;
+  VkQueue queue_ = VK_NULL_HANDLE;
+  uint32_t queue_family_ = 0;
+  uint32_t api_version_ = 0;
+  bool multi_viewport_ = false;
+  bool viewport_index_ = false;
+  VkPhysicalDeviceProperties properties_ = {};
+  VkPhysicalDeviceMemoryProperties memory_properties_ = {};
+  std::vector<std::string> instance_extensions_;
+  std::vector<std::string> device_extensions_;
+  std::vector<const char*> instance_extension_ptrs_;
+  std::vector<const char*> device_extension_ptrs_;
+  std::mutex queue_mutex_;
+
+  // Readback (ReadImage).
+  std::mutex readback_mutex_;
+  VkCommandPool pool_ = VK_NULL_HANDLE;
+  VkCommandBuffer cmd_ = VK_NULL_HANDLE;
+  VkFence fence_ = VK_NULL_HANDLE;
+  VkBuffer readback_buffer_ = VK_NULL_HANDLE;
+  VkDeviceMemory readback_memory_ = VK_NULL_HANDLE;
+  void* readback_map_ = nullptr;
+  size_t readback_size_ = 0;
+
+  std::unique_ptr<McsmVulkanProcs> procs_;
+};
+
+}  // namespace flutter
