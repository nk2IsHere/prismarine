+// found in the LICENSE file.
+
+#include "flutter/shell/platform/common/mcsm_vulkan_device.h"
+
+#include <algorithm>
+#include <cstring>
+#include <sstream>
+
+#include "flutter/fml/logging.h"
+
+#if defined(_WIN32)
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+namespace flutter {
+
+// Instance and device functions McsmVulkanDevice calls itself.
+struct McsmVulkanProcs {
+  PFN_vkDestroyInstance DestroyInstance = nullptr;
+  PFN_vkEnumeratePhysicalDevices EnumeratePhysicalDevices = nullptr;
+  PFN_vkGetPhysicalDeviceProperties GetPhysicalDeviceProperties = nullptr;
+  PFN_vkGetPhysicalDeviceProperties2 GetPhysicalDeviceProperties2 = nullptr;
+  PFN_vkGetPhysicalDeviceFeatures GetPhysicalDeviceFeatures = nullptr;
+  PFN_vkGetPhysicalDeviceFeatures2 GetPhysicalDeviceFeatures2 = nullptr;
+  PFN_vkGetPhysicalDeviceQueueFamilyProperties
+      GetPhysicalDeviceQueueFamilyProperties = nullptr;
+  PFN_vkGetPhysicalDeviceMemoryProperties GetPhysicalDeviceMemoryProperties =
+      nullptr;
+  PFN_vkGetPhysicalDeviceFormatProperties GetPhysicalDeviceFormatProperties =
+      nullptr;
+  PFN_vkEnumerateDeviceExtensionProperties EnumerateDeviceExtensionProperties =
+      nullptr;
+  PFN_vkCreateDevice CreateDevice = nullptr;
+  PFN_vkGetDeviceProcAddr GetDeviceProcAddr = nullptr;
+  // Device.
+  PFN_vkDestroyDevice DestroyDevice = nullptr;
+  PFN_vkDeviceWaitIdle DeviceWaitIdle = nullptr;
+  PFN_vkGetDeviceQueue GetDeviceQueue = nullptr;
+  PFN_vkCreateImage CreateImage = nullptr;
+  PFN_vkDestroyImage DestroyImage = nullptr;
+  PFN_vkGetImageMemoryRequirements GetImageMemoryRequirements = nullptr;
+  PFN_vkAllocateMemory AllocateMemory = nullptr;
+  PFN_vkFreeMemory FreeMemory = nullptr;
+  PFN_vkBindImageMemory BindImageMemory = nullptr;
+  PFN_vkCreateBuffer CreateBuffer = nullptr;
+  PFN_vkDestroyBuffer DestroyBuffer = nullptr;
+  PFN_vkGetBufferMemoryRequirements GetBufferMemoryRequirements = nullptr;
+  PFN_vkBindBufferMemory BindBufferMemory = nullptr;
+  PFN_vkMapMemory MapMemory = nullptr;
+  PFN_vkUnmapMemory UnmapMemory = nullptr;
+  PFN_vkInvalidateMappedMemoryRanges InvalidateMappedMemoryRanges = nullptr;
+  PFN_vkCreateCommandPool CreateCommandPool = nullptr;
+  PFN_vkDestroyCommandPool DestroyCommandPool = nullptr;
+  PFN_vkAllocateCommandBuffers AllocateCommandBuffers = nullptr;
+  PFN_vkResetCommandBuffer ResetCommandBuffer = nullptr;
+  PFN_vkBeginCommandBuffer BeginCommandBuffer = nullptr;
+  PFN_vkEndCommandBuffer EndCommandBuffer = nullptr;
+  PFN_vkCmdPipelineBarrier CmdPipelineBarrier = nullptr;
+  PFN_vkCmdCopyImageToBuffer CmdCopyImageToBuffer = nullptr;
+  PFN_vkCreateFence CreateFence = nullptr;
+  PFN_vkDestroyFence DestroyFence = nullptr;
+  PFN_vkWaitForFences WaitForFences = nullptr;
+  PFN_vkResetFences ResetFences = nullptr;
+  // The real queue functions (the engine gets the locked wrappers).
+  PFN_vkQueueSubmit QueueSubmit = nullptr;
+  PFN_vkQueueSubmit2 QueueSubmit2 = nullptr;
+  PFN_vkQueueSubmit2KHR QueueSubmit2KHR = nullptr;
+  PFN_vkQueueWaitIdle QueueWaitIdle = nullptr;
+  PFN_vkQueuePresentKHR QueuePresentKHR = nullptr;
+  PFN_vkQueueBindSparse QueueBindSparse = nullptr;
+};
+
+namespace {
+
+McsmVulkanDevice* g_device = nullptr;
+McsmVulkanProcs* g_procs = nullptr;
+
+VKAPI_ATTR VkResult VKAPI_CALL LockedQueueSubmit(VkQueue queue,
+                                                 uint32_t count,
+                                                 const VkSubmitInfo* submits,
+                                                 VkFence fence) {
+  std::scoped_lock lock(g_device->queue_mutex());
+  return g_procs->QueueSubmit(queue, count, submits, fence);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+LockedQueueSubmit2(VkQueue queue,
+                   uint32_t count,
+                   const VkSubmitInfo2* submits,
+                   VkFence fence) {
+  std::scoped_lock lock(g_device->queue_mutex());
+  return g_procs->QueueSubmit2 != nullptr
+             ? g_procs->QueueSubmit2(queue, count, submits, fence)
+             : g_procs->QueueSubmit2KHR(queue, count, submits, fence);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL LockedQueueWaitIdle(VkQueue queue) {
+  std::scoped_lock lock(g_device->queue_mutex());
+  return g_procs->QueueWaitIdle(queue);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+LockedQueuePresentKHR(VkQueue queue, const VkPresentInfoKHR* info) {
+  std::scoped_lock lock(g_device->queue_mutex());
+  return g_procs->QueuePresentKHR(queue, info);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+LockedQueueBindSparse(VkQueue queue,
+                      uint32_t count,
+                      const VkBindSparseInfo* info,
+                      VkFence fence) {
+  std::scoped_lock lock(g_device->queue_mutex());
+  return g_procs->QueueBindSparse(queue, count, info, fence);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL LockedDeviceWaitIdle(VkDevice device) {
+  std::scoped_lock lock(g_device->queue_mutex());
+  return g_procs->DeviceWaitIdle(device);
+}
+
+PFN_vkVoidFunction LockedFunction(const char* name) {
+  if (g_device == nullptr || name == nullptr) {
+    return nullptr;
+  }
+  if (strcmp(name, "vkQueueSubmit") == 0) {
+    return reinterpret_cast<PFN_vkVoidFunction>(&LockedQueueSubmit);
+  }
+  if ((strcmp(name, "vkQueueSubmit2") == 0 ||
+       strcmp(name, "vkQueueSubmit2KHR") == 0) &&
+      (g_procs->QueueSubmit2 != nullptr ||
+       g_procs->QueueSubmit2KHR != nullptr)) {
+    return reinterpret_cast<PFN_vkVoidFunction>(&LockedQueueSubmit2);
+  }
+  if (strcmp(name, "vkQueueWaitIdle") == 0) {
+    return reinterpret_cast<PFN_vkVoidFunction>(&LockedQueueWaitIdle);
+  }
+  if (strcmp(name, "vkQueuePresentKHR") == 0 &&
+      g_procs->QueuePresentKHR != nullptr) {
+    return reinterpret_cast<PFN_vkVoidFunction>(&LockedQueuePresentKHR);
+  }
+  if (strcmp(name, "vkQueueBindSparse") == 0) {
+    return reinterpret_cast<PFN_vkVoidFunction>(&LockedQueueBindSparse);
+  }
+  if (strcmp(name, "vkDeviceWaitIdle") == 0) {
+    return reinterpret_cast<PFN_vkVoidFunction>(&LockedDeviceWaitIdle);
+  }
+  return nullptr;
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL HookedGetDeviceProcAddr(
+    VkDevice device,
+    const char* name) {
+  if (auto locked = LockedFunction(name)) {
+    return locked;
+  }
+  if (name != nullptr && strcmp(name, "vkGetDeviceProcAddr") == 0) {
+    return reinterpret_cast<PFN_vkVoidFunction>(&HookedGetDeviceProcAddr);
+  }
+  return g_procs->GetDeviceProcAddr(device, name);
+}
+
+// The engine asks for vkGetInstanceProcAddr itself and loads everything
+// through it (embedder.cc, Impeller's dispatcher), so that one is hooked too.
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL HookedGetInstanceProcAddr(
+    VkInstance instance,
+    const char* name);
+
+bool HasExtension(const std::vector<VkExtensionProperties>& list,
+                  const char* name) {
+  return std::any_of(list.begin(), list.end(), [&](const auto& e) {
+    return strcmp(e.extensionName, name) == 0;
+  });
+}
+
+const char* DeviceTypeName(VkPhysicalDeviceType type) {
+  switch (type) {
+    case VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU:
+      return "discrete";
+    case VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU:
+      return "integrated";
+    case VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU:
+      return "virtual";
+    case VK_PHYSICAL_DEVICE_TYPE_CPU:
+      return "cpu";
+    default:
+      return "other";
+  }
+}
+
+}  // namespace
+
+std::unique_ptr<McsmVulkanDevice> McsmVulkanDevice::Create(
+    const Options& options,
+    std::string* error) {
+  if (g_device != nullptr) {
+    *error = "a Vulkan device already exists in this process";
+    return nullptr;
+  }
+  std::unique_ptr<McsmVulkanDevice> device(new McsmVulkanDevice());
+  if (!device->Init(options, error)) {
+    return nullptr;
+  }
+  g_device = device.get();
+  g_procs = device->procs_.get();
+  return device;
+}
+
+bool McsmVulkanDevice::Init(const Options& options, std::string* error) {
+  procs_ = std::make_unique<McsmVulkanProcs>();
+#if defined(_WIN32)
+  HMODULE module = LoadLibraryA("vulkan-1.dll");
+  library_ = module;
+  if (module != nullptr) {
+    gipa_ = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+        GetProcAddress(module, "vkGetInstanceProcAddr"));
+  }
+#else
+  library_ = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+  if (library_ == nullptr) {
+    library_ = dlopen("libvulkan.so", RTLD_NOW | RTLD_LOCAL);
+  }
+  if (library_ != nullptr) {
+    gipa_ = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+        dlsym(library_, "vkGetInstanceProcAddr"));
+  }
+#endif
+  if (gipa_ == nullptr) {
+    *error = "no Vulkan loader";
+    return false;
+  }
+
+  auto enumerate_version = reinterpret_cast<PFN_vkEnumerateInstanceVersion>(
+      gipa_(VK_NULL_HANDLE, "vkEnumerateInstanceVersion"));
+  uint32_t loader_version = VK_API_VERSION_1_0;
+  if (enumerate_version != nullptr) {
+    enumerate_version(&loader_version);
+  }
+  if (loader_version < VK_API_VERSION_1_1) {
+    *error = "the Vulkan loader is older than 1.1";
+    return false;
+  }
+  // Impeller targets 1.1 (SPIR-V 1.3); ask for 1.3 where the loader has it so
+  // 1.2/1.3 core features can be enabled on devices that have them.
+  const uint32_t instance_version =
+      std::min<uint32_t>(loader_version, VK_API_VERSION_1_3);
+
+  auto enumerate_instance_extensions =
+      reinterpret_cast<PFN_vkEnumerateInstanceExtensionProperties>(
+          gipa_(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties"));
+  uint32_t count = 0;
+  enumerate_instance_extensions(nullptr, &count, nullptr);
+  std::vector<VkExtensionProperties> instance_exts(count);
+  enumerate_instance_extensions(nullptr, &count, instance_exts.data());
+  if (!HasExtension(instance_exts, VK_KHR_SURFACE_EXTENSION_NAME)) {
+    *error = "no VK_KHR_surface";
+    return false;
+  }
+  instance_extensions_.push_back(VK_KHR_SURFACE_EXTENSION_NAME);
+  bool has_wsi = false;
+  for (const auto& wsi : options.wsi_instance_extensions) {
+    if (HasExtension(instance_exts, wsi.c_str())) {
+      instance_extensions_.push_back(wsi);
+      has_wsi = true;
+    }
+  }
+  if (!has_wsi) {
+    *error = "no window-system surface extension";
+    return false;
+  }
+  for (const auto& e : instance_extensions_) {
+    instance_extension_ptrs_.push_back(e.c_str());
+  }
+
+  VkApplicationInfo app = {VK_STRUCTURE_TYPE_APPLICATION_INFO};
+  app.pApplicationName = "flutter";
+  app.pEngineName = "flutter (mcsm8)";
+  app.apiVersion = instance_version;
+  VkInstanceCreateInfo instance_info = {VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+  instance_info.pApplicationInfo = &app;
+  instance_info.enabledExtensionCount =
+      static_cast<uint32_t>(instance_extension_ptrs_.size());
+  instance_info.ppEnabledExtensionNames = instance_extension_ptrs_.data();
+  auto create_instance = reinterpret_cast<PFN_vkCreateInstance>(
+      gipa_(VK_NULL_HANDLE, "vkCreateInstance"));
+  VkResult result = create_instance(&instance_info, nullptr, &instance_);
+  if (result != VK_SUCCESS) {
+    *error = "vkCreateInstance failed (" + std::to_string(result) + ")";
+    return false;
+  }
+
+#define MCSM_INSTANCE_PROC(name) \
+  procs_->name = reinterpret_cast<PFN_vk##name>(gipa_(instance_, "vk" #name))
+  MCSM_INSTANCE_PROC(DestroyInstance);
+  MCSM_INSTANCE_PROC(EnumeratePhysicalDevices);
+  MCSM_INSTANCE_PROC(GetPhysicalDeviceProperties);
+  MCSM_INSTANCE_PROC(GetPhysicalDeviceProperties2);
+  MCSM_INSTANCE_PROC(GetPhysicalDeviceFeatures);
+  MCSM_INSTANCE_PROC(GetPhysicalDeviceFeatures2);
+  MCSM_INSTANCE_PROC(GetPhysicalDeviceQueueFamilyProperties);
+  MCSM_INSTANCE_PROC(GetPhysicalDeviceMemoryProperties);
+  MCSM_INSTANCE_PROC(GetPhysicalDeviceFormatProperties);
+  MCSM_INSTANCE_PROC(EnumerateDeviceExtensionProperties);
+  MCSM_INSTANCE_PROC(CreateDevice);
+  MCSM_INSTANCE_PROC(GetDeviceProcAddr);
+#undef MCSM_INSTANCE_PROC
+
+  // Pick a device that meets Impeller's needs: 1.1, a graphics + compute
+  // queue family, VK_KHR_swapchain, BGRA8 colour attachments and a
+  // depth/stencil format. Discrete over integrated over the rest; the
+  // preferred LUID first when given.
+  count = 0;
+  procs_->EnumeratePhysicalDevices(instance_, &count, nullptr);
+  std::vector<VkPhysicalDevice> devices(count);
+  procs_->EnumeratePhysicalDevices(instance_, &count, devices.data());
+  int best_score = -1;
+  std::string rejected;
+  for (VkPhysicalDevice candidate : devices) {
+    VkPhysicalDeviceProperties props;
+    procs_->GetPhysicalDeviceProperties(candidate, &props);
+    auto reject = [&](const char* why) {
+      rejected += std::string(props.deviceName) + ": " + why + "; ";
+    };
+    if (props.apiVersion < VK_API_VERSION_1_1) {
+      reject("api < 1.1");
+      continue;
+    }
+    uint32_t ext_count = 0;
+    procs_->EnumerateDeviceExtensionProperties(candidate, nullptr, &ext_count,
+                                               nullptr);
+    std::vector<VkExtensionProperties> exts(ext_count);
+    procs_->EnumerateDeviceExtensionProperties(candidate, nullptr, &ext_count,
+                                               exts.data());
+    if (!HasExtension(exts, VK_KHR_SWAPCHAIN_EXTENSION_NAME)) {
+      reject("no VK_KHR_swapchain");
+      continue;
+    }
+    uint32_t family_count = 0;
+    procs_->GetPhysicalDeviceQueueFamilyProperties(candidate, &family_count,
+                                                   nullptr);
+    std::vector<VkQueueFamilyProperties> families(family_count);
+    procs_->GetPhysicalDeviceQueueFamilyProperties(candidate, &family_count,
+                                                   families.data());
+    std::optional<uint32_t> family;
+    for (uint32_t i = 0; i < family_count; i++) {
+      const auto need = VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT;
+      if ((families[i].queueFlags & need) == need) {
+        family = i;
+        break;
+      }
+    }
+    if (!family.has_value()) {
+      reject("no graphics + compute queue");
+      continue;
+    }
+    VkFormatProperties bgra;
+    procs_->GetPhysicalDeviceFormatProperties(candidate,
+                                              VK_FORMAT_B8G8R8A8_UNORM, &bgra);
+    if (!(bgra.optimalTilingFeatures &
+          VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT)) {
+      reject("no BGRA8 colour attachments");
+      continue;
+    }
+    VkFormatProperties d32s8, d24s8;
+    procs_->GetPhysicalDeviceFormatProperties(
+        candidate, VK_FORMAT_D32_SFLOAT_S8_UINT, &d32s8);
+    procs_->GetPhysicalDeviceFormatProperties(
+        candidate, VK_FORMAT_D24_UNORM_S8_UINT, &d24s8);
+    if (!((d32s8.optimalTilingFeatures | d24s8.optimalTilingFeatures) &
+          VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT)) {
+      reject("no depth/stencil format");
+      continue;
+    }
+    int score = 0;
+    switch (props.deviceType) {
+      case VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU:
+        score = 40;
+        break;
+      case VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU:
+        score = 30;
+        break;
+      case VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU:
+        score = 20;
+        break;
+      default:
+        score = 10;
+        break;
+    }
+    if (options.luid.has_value() &&
+        procs_->GetPhysicalDeviceProperties2 != nullptr) {
+      VkPhysicalDeviceIDProperties id = {
+          VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES};
+      VkPhysicalDeviceProperties2 props2 = {
+          VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+      props2.pNext = &id;
+      procs_->GetPhysicalDeviceProperties2(candidate, &props2);
+      if (id.deviceLUIDValid &&
+          memcmp(id.deviceLUID, options.luid->data(), VK_LUID_SIZE) == 0) {
+        score += 100;
+      }
+    }
+    if (score > best_score) {
+      best_score = score;
+      physical_device_ = candidate;
+      queue_family_ = family.value();
+      properties_ = props;
+      device_extensions_.clear();
+      device_extensions_.push_back(VK_KHR_SWAPCHAIN_EXTENSION_NAME);
+      // Optional: the viewport index from the vertex stage on 1.1 devices.
+      if (props.apiVersion < VK_API_VERSION_1_2 &&
+          HasExtension(exts, VK_EXT_SHADER_VIEWPORT_INDEX_LAYER_EXTENSION_NAME)) {
+        device_extensions_.push_back(
+            VK_EXT_SHADER_VIEWPORT_INDEX_LAYER_EXTENSION_NAME);
+      }
+    }
+  }
+  if (physical_device_ == VK_NULL_HANDLE) {
+    *error = "no suitable Vulkan device (" + rejected + ")";
+    return false;
+  }
+  procs_->GetPhysicalDeviceMemoryProperties(physical_device_,
+                                            &memory_properties_);
+  api_version_ = std::min(properties_.apiVersion, instance_version);
+
+  // Features: what Impeller enables itself when it creates the device
+  // (capabilities_vk.cc), plus multiViewport and the vertex stage's viewport
+  // index for viewport arrays (mcsm8).
+  VkPhysicalDeviceFeatures supported = {};
+  procs_->GetPhysicalDeviceFeatures(physical_device_, &supported);
+  VkPhysicalDevice16BitStorageFeatures storage16_supported = {
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES};
+  VkPhysicalDeviceVulkan12Features v12_supported = {
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+  const bool has_12 = api_version_ >= VK_API_VERSION_1_2;
+  if (procs_->GetPhysicalDeviceFeatures2 != nullptr) {
+    VkPhysicalDeviceFeatures2 features2 = {
+        VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+    features2.pNext = &storage16_supported;
+    if (has_12) {
+      storage16_supported.pNext = &v12_supported;
+    }
+    procs_->GetPhysicalDeviceFeatures2(physical_device_, &features2);
+  }
+  VkPhysicalDeviceFeatures enabled = {};
+  enabled.fillModeNonSolid = supported.fillModeNonSolid;
+  enabled.samplerAnisotropy = supported.samplerAnisotropy;
+  enabled.multiViewport = supported.multiViewport;
+  multi_viewport_ = supported.multiViewport == VK_TRUE;
+  VkPhysicalDevice16BitStorageFeatures storage16 = {
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES};
+  storage16.uniformAndStorageBuffer16BitAccess =
+      storage16_supported.uniformAndStorageBuffer16BitAccess;
+  VkPhysicalDeviceVulkan12Features v12 = {
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+  if (has_12) {
+    v12.shaderOutputViewportIndex = v12_supported.shaderOutputViewportIndex;
+    v12.shaderOutputLayer = v12_supported.shaderOutputLayer;
+    viewport_index_ = v12_supported.shaderOutputViewportIndex == VK_TRUE;
+    storage16.pNext = &v12;
+  } else {
+    viewport_index_ =
+        std::find(device_extensions_.begin(), device_extensions_.end(),
+                  std::string(VK_EXT_SHADER_VIEWPORT_INDEX_LAYER_EXTENSION_NAME)) !=
+        device_extensions_.end();
+  }
+  for (const auto& e : device_extensions_) {
+    device_extension_ptrs_.push_back(e.c_str());
+  }
+
+  const float priority = 1.0f;
+  VkDeviceQueueCreateInfo queue_info = {
+      VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+  queue_info.queueFamilyIndex = queue_family_;
+  queue_info.queueCount = 1;
+  queue_info.pQueuePriorities = &priority;
+  VkDeviceCreateInfo device_info = {VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+  device_info.pNext = &storage16;
+  device_info.queueCreateInfoCount = 1;
+  device_info.pQueueCreateInfos = &queue_info;
+  device_info.enabledExtensionCount =
+      static_cast<uint32_t>(device_extension_ptrs_.size());
+  device_info.ppEnabledExtensionNames = device_extension_ptrs_.data();
+  device_info.pEnabledFeatures = &enabled;
+  result = procs_->CreateDevice(physical_device_, &device_info, nullptr,
+                                &device_);
+  if (result != VK_SUCCESS) {
+    *error = "vkCreateDevice failed (" + std::to_string(result) + ")";
+    return false;
+  }
+
+#define MCSM_DEVICE_PROC(name) \
+  procs_->name =               \
+      reinterpret_cast<PFN_vk##name>(procs_->GetDeviceProcAddr(device_, "vk" #name))
+  MCSM_DEVICE_PROC(DestroyDevice);
+  MCSM_DEVICE_PROC(DeviceWaitIdle);
+  MCSM_DEVICE_PROC(GetDeviceQueue);
+  MCSM_DEVICE_PROC(CreateImage);
+  MCSM_DEVICE_PROC(DestroyImage);
+  MCSM_DEVICE_PROC(GetImageMemoryRequirements);
+  MCSM_DEVICE_PROC(AllocateMemory);
+  MCSM_DEVICE_PROC(FreeMemory);
+  MCSM_DEVICE_PROC(BindImageMemory);
+  MCSM_DEVICE_PROC(CreateBuffer);
+  MCSM_DEVICE_PROC(DestroyBuffer);
+  MCSM_DEVICE_PROC(GetBufferMemoryRequirements);
+  MCSM_DEVICE_PROC(BindBufferMemory);
+  MCSM_DEVICE_PROC(MapMemory);
+  MCSM_DEVICE_PROC(UnmapMemory);
+  MCSM_DEVICE_PROC(InvalidateMappedMemoryRanges);
+  MCSM_DEVICE_PROC(CreateCommandPool);
+  MCSM_DEVICE_PROC(DestroyCommandPool);
+  MCSM_DEVICE_PROC(AllocateCommandBuffers);
+  MCSM_DEVICE_PROC(ResetCommandBuffer);
+  MCSM_DEVICE_PROC(BeginCommandBuffer);
+  MCSM_DEVICE_PROC(EndCommandBuffer);
+  MCSM_DEVICE_PROC(CmdPipelineBarrier);
+  MCSM_DEVICE_PROC(CmdCopyImageToBuffer);
+  MCSM_DEVICE_PROC(CreateFence);
+  MCSM_DEVICE_PROC(DestroyFence);
+  MCSM_DEVICE_PROC(WaitForFences);
+  MCSM_DEVICE_PROC(ResetFences);
+  MCSM_DEVICE_PROC(QueueSubmit);
+  MCSM_DEVICE_PROC(QueueSubmit2);
+  MCSM_DEVICE_PROC(QueueSubmit2KHR);
+  MCSM_DEVICE_PROC(QueueWaitIdle);
+  MCSM_DEVICE_PROC(QueuePresentKHR);
+  MCSM_DEVICE_PROC(QueueBindSparse);
+#undef MCSM_DEVICE_PROC
+  procs_->GetDeviceQueue(device_, queue_family_, 0, &queue_);
+
+  VkCommandPoolCreateInfo pool_info = {
+      VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  pool_info.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+  pool_info.queueFamilyIndex = queue_family_;
+  if (procs_->CreateCommandPool(device_, &pool_info, nullptr, &pool_) !=
+      VK_SUCCESS) {
+    *error = "vkCreateCommandPool failed";
+    return false;
+  }
+  VkCommandBufferAllocateInfo alloc = {
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  alloc.commandPool = pool_;
+  alloc.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+  alloc.commandBufferCount = 1;
+  procs_->AllocateCommandBuffers(device_, &alloc, &cmd_);
+  VkFenceCreateInfo fence_info = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  procs_->CreateFence(device_, &fence_info, nullptr, &fence_);
+  return true;
+}
+
+McsmVulkanDevice::~McsmVulkanDevice() {
+  if (device_ != VK_NULL_HANDLE) {
+    {
+      std::scoped_lock lock(queue_mutex_);
+      procs_->DeviceWaitIdle(device_);
+    }
+    if (readback_map_ != nullptr) {
+      procs_->UnmapMemory(device_, readback_memory_);
+    }
+    if (readback_buffer_ != VK_NULL_HANDLE) {
+      procs_->DestroyBuffer(device_, readback_buffer_, nullptr);
+    }
+    if (readback_memory_ != VK_NULL_HANDLE) {
+      procs_->FreeMemory(device_, readback_memory_, nullptr);
+    }
+    if (fence_ != VK_NULL_HANDLE) {
+      procs_->DestroyFence(device_, fence_, nullptr);
+    }
+    if (pool_ != VK_NULL_HANDLE) {
+      procs_->DestroyCommandPool(device_, pool_, nullptr);
+    }
+    procs_->DestroyDevice(device_, nullptr);
+  }
+  if (instance_ != VK_NULL_HANDLE && procs_ && procs_->DestroyInstance) {
+    procs_->DestroyInstance(instance_, nullptr);
+  }
+  if (g_device == this) {
+    g_device = nullptr;
+    g_procs = nullptr;
+  }
+  // The loader stays loaded (the engine may still hold function pointers).
+}
+
+namespace {
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL HookedGetInstanceProcAddr(
+    VkInstance instance,
+    const char* name) {
+  return reinterpret_cast<PFN_vkVoidFunction>(
+      McsmVulkanDevice::GetInstanceProcAddress(nullptr, instance, name));
+}
+}  // namespace
+
+void* McsmVulkanDevice::GetInstanceProcAddress(
+    void* user_data,
+    FlutterVulkanInstanceHandle instance,
+    const char* name) {
+  if (g_device == nullptr) {
+    return nullptr;
+  }
+  if (auto locked = LockedFunction(name)) {
+    return reinterpret_cast<void*>(locked);
+  }
+  if (name != nullptr && strcmp(name, "vkGetDeviceProcAddr") == 0) {
+    return reinterpret_cast<void*>(&HookedGetDeviceProcAddr);
+  }
+  if (name != nullptr && strcmp(name, "vkGetInstanceProcAddr") == 0) {
+    return reinterpret_cast<void*>(&HookedGetInstanceProcAddr);
+  }
+  return reinterpret_cast<void*>(
+      g_device->gipa_(static_cast<VkInstance>(instance), name));
+}
+
+PFN_vkVoidFunction McsmVulkanDevice::InstanceProc(const char* name) const {
+  return gipa_(instance_, name);
+}
+
+PFN_vkVoidFunction McsmVulkanDevice::DeviceProc(const char* name) const {
+  return procs_->GetDeviceProcAddr(device_, name);
+}
+
+void McsmVulkanDevice::FillRendererConfig(
+    FlutterRendererConfig* config) const {
+  config->type = kVulkan;
+  FlutterVulkanRendererConfig& vk = config->vulkan;
+  vk = {};
+  vk.struct_size = sizeof(FlutterVulkanRendererConfig);
+  vk.version = api_version_;
+  vk.instance = instance_;
+  vk.physical_device = physical_device_;
+  vk.device = device_;
+  vk.queue_family_index = queue_family_;
+  vk.queue = queue_;
+  vk.enabled_instance_extension_count = instance_extension_ptrs_.size();
+  vk.enabled_instance_extensions =
+      const_cast<const char**>(instance_extension_ptrs_.data());
+  vk.enabled_device_extension_count = device_extension_ptrs_.size();
+  vk.enabled_device_extensions =
+      const_cast<const char**>(device_extension_ptrs_.data());
+  vk.get_instance_proc_address_callback = &GetInstanceProcAddress;
+  // With a compositor the engine renders into backing stores and never asks
+  // for an image of its own.
+  vk.get_next_image_callback = [](void*, const FlutterFrameInfo*) {
+    FlutterVulkanImage image = {};
+    image.struct_size = sizeof(FlutterVulkanImage);
+    return image;
+  };
+  vk.present_image_callback = [](void*, const FlutterVulkanImage*) {
+    return false;
+  };
+}
+
+std::string McsmVulkanDevice::Describe() const {
+  std::ostringstream out;
+  out << "Vulkan " << properties_.deviceName << " (api "
+      << VK_API_VERSION_MAJOR(properties_.apiVersion) << "."
+      << VK_API_VERSION_MINOR(properties_.apiVersion) << "."
+      << VK_API_VERSION_PATCH(properties_.apiVersion) << ", driver 0x"
+      << std::hex << properties_.driverVersion << std::dec << ", "
+      << DeviceTypeName(properties_.deviceType)
+      << (multi_viewport_ ? ", multiViewport" : "")
+      << (viewport_index_ ? ", vertex viewport index" : "") << ")";
+  return out.str();
+}
+
+uint32_t McsmVulkanDevice::FindMemoryType(uint32_t bits,
+                                          VkMemoryPropertyFlags flags) const {
+  for (uint32_t i = 0; i < memory_properties_.memoryTypeCount; i++) {
+    if ((bits & (1u << i)) &&
+        (memory_properties_.memoryTypes[i].propertyFlags & flags) == flags) {
+      return i;
+    }
+  }
+  return UINT32_MAX;
+}
+
+bool McsmVulkanDevice::CreateBackingStore(
+    const FlutterBackingStoreConfig& config,
+    FlutterBackingStore* out) {
+  auto* image = new Image();
+  image->device = this;
+  image->width = static_cast<uint32_t>(config.size.width);
+  image->height = static_cast<uint32_t>(config.size.height);
+  VkImageCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+  info.imageType = VK_IMAGE_TYPE_2D;
+  info.format = VK_FORMAT_B8G8R8A8_UNORM;
+  info.extent = {image->width, image->height, 1};
+  info.mipLevels = 1;
+  info.arrayLayers = 1;
+  info.samples = VK_SAMPLE_COUNT_1_BIT;
+  info.tiling = VK_IMAGE_TILING_OPTIMAL;
+  info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+               VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT |
+               VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+  info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  if (procs_->CreateImage(device_, &info, nullptr, &image->image) !=
+      VK_SUCCESS) {
+    delete image;
+    return false;
+  }
+  VkMemoryRequirements req;
+  procs_->GetImageMemoryRequirements(device_, image->image, &req);
+  VkMemoryAllocateInfo alloc = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+  alloc.allocationSize = req.size;
+  alloc.memoryTypeIndex =
+      FindMemoryType(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+  if (alloc.memoryTypeIndex == UINT32_MAX ||
+      procs_->AllocateMemory(device_, &alloc, nullptr, &image->memory) !=
+          VK_SUCCESS ||
+      procs_->BindImageMemory(device_, image->image, image->memory, 0) !=
+          VK_SUCCESS) {
+    if (image->memory != VK_NULL_HANDLE) {
+      procs_->FreeMemory(device_, image->memory, nullptr);
+    }
+    procs_->DestroyImage(device_, image->image, nullptr);
+    delete image;
+    return false;
+  }
+  image->flutter_image.struct_size = sizeof(FlutterVulkanImage);
+  image->flutter_image.image = reinterpret_cast<uint64_t>(image->image);
+  image->flutter_image.format = VK_FORMAT_B8G8R8A8_UNORM;
+
+  out->struct_size = sizeof(FlutterBackingStore);
+  out->type = kFlutterBackingStoreTypeVulkan;
+  out->user_data = image;
+  out->vulkan.struct_size = sizeof(FlutterVulkanBackingStore);
+  out->vulkan.image = &image->flutter_image;
+  out->vulkan.user_data = image;
+  out->vulkan.destruction_callback = [](void* user_data) {
+    auto* img = static_cast<Image*>(user_data);
+    img->device->ReleaseImage(img);
+  };
+  return true;
+}
+
+void McsmVulkanDevice::CollectBackingStore(const FlutterBackingStore* store) {
+  if (store == nullptr || store->type != kFlutterBackingStoreTypeVulkan) {
+    return;
+  }
+  auto* image = static_cast<Image*>(store->vulkan.user_data);
+  image->device->ReleaseImage(image);
+}
+
+void McsmVulkanDevice::ReleaseImage(Image* image) {
+  if (image->refs.fetch_sub(1) != 1) {
+    return;
+  }
+  {
+    // The engine waited for its own work on the image; ours is synchronous.
+    std::scoped_lock lock(queue_mutex_);
+    procs_->QueueWaitIdle(queue_);
+  }
+  procs_->DestroyImage(device_, image->image, nullptr);
+  procs_->FreeMemory(device_, image->memory, nullptr);
+  delete image;
+}
+
+bool McsmVulkanDevice::EnsureReadback(size_t bytes) {
+  if (readback_size_ >= bytes) {
+    return true;
+  }
+  if (readback_map_ != nullptr) {
+    procs_->UnmapMemory(device_, readback_memory_);
+    readback_map_ = nullptr;
+  }
+  if (readback_buffer_ != VK_NULL_HANDLE) {
+    procs_->DestroyBuffer(device_, readback_buffer_, nullptr);
+    readback_buffer_ = VK_NULL_HANDLE;
+  }
+  if (readback_memory_ != VK_NULL_HANDLE) {
+    procs_->FreeMemory(device_, readback_memory_, nullptr);
+    readback_memory_ = VK_NULL_HANDLE;
+  }
+  readback_size_ = 0;
+  VkBufferCreateInfo info = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+  info.size = bytes;
+  info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+  info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  if (procs_->CreateBuffer(device_, &info, nullptr, &readback_buffer_) !=
+      VK_SUCCESS) {
+    return false;
+  }
+  VkMemoryRequirements req;
+  procs_->GetBufferMemoryRequirements(device_, readback_buffer_, &req);
+  VkMemoryAllocateInfo alloc = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+  alloc.allocationSize = req.size;
+  alloc.memoryTypeIndex = FindMemoryType(
+      req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                              VK_MEMORY_PROPERTY_HOST_CACHED_BIT);
+  if (alloc.memoryTypeIndex == UINT32_MAX) {
+    alloc.memoryTypeIndex =
+        FindMemoryType(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT);
+  }
+  if (alloc.memoryTypeIndex == UINT32_MAX ||
+      procs_->AllocateMemory(device_, &alloc, nullptr, &readback_memory_) !=
+          VK_SUCCESS ||
+      procs_->BindBufferMemory(device_, readback_buffer_, readback_memory_,
+                               0) != VK_SUCCESS ||
+      procs_->MapMemory(device_, readback_memory_, 0, VK_WHOLE_SIZE, 0,
+                        &readback_map_) != VK_SUCCESS) {
+    return false;
+  }
+  readback_size_ = bytes;
+  return true;
+}
+
+bool McsmVulkanDevice::ReadImage(Image* image,
+                                 uint8_t* out,
+                                 size_t row_bytes) {
+  std::scoped_lock lock(readback_mutex_);
+  const size_t tight = static_cast<size_t>(image->width) * 4;
+  const size_t bytes = tight * image->height;
+  if (!EnsureReadback(bytes)) {
+    return false;
+  }
+  procs_->ResetCommandBuffer(cmd_, 0);
+  VkCommandBufferBeginInfo begin = {
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  procs_->BeginCommandBuffer(cmd_, &begin);
+  VkImageMemoryBarrier to_src = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+  to_src.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  to_src.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  to_src.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  to_src.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  to_src.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  to_src.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  to_src.image = image->image;
+  to_src.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  procs_->CmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                             VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                             nullptr, 1, &to_src);
+  VkBufferImageCopy region = {};
+  region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.imageExtent = {image->width, image->height, 1};
+  procs_->CmdCopyImageToBuffer(cmd_, image->image,
+                               VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                               readback_buffer_, 1, &region);
+  VkImageMemoryBarrier back = to_src;
+  back.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  back.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  back.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  back.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  procs_->CmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0,
+                             0, nullptr, 0, nullptr, 1, &back);
+  procs_->EndCommandBuffer(cmd_);
+  VkSubmitInfo submit = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &cmd_;
+  procs_->ResetFences(device_, 1, &fence_);
+  {
+    std::scoped_lock queue_lock(queue_mutex_);
+    if (procs_->QueueSubmit(queue_, 1, &submit, fence_) != VK_SUCCESS) {
+      return false;
+    }
+  }
+  if (procs_->WaitForFences(device_, 1, &fence_, VK_TRUE, UINT64_MAX) !=
+      VK_SUCCESS) {
+    return false;
+  }
+  VkMappedMemoryRange range = {VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+  range.memory = readback_memory_;
+  range.size = VK_WHOLE_SIZE;
+  procs_->InvalidateMappedMemoryRanges(device_, 1, &range);
+  const auto* src = static_cast<const uint8_t*>(readback_map_);
+  for (uint32_t y = 0; y < image->height; y++) {
+    memcpy(out + y * row_bytes, src + y * tight, tight);
+  }
+  return true;
+}
