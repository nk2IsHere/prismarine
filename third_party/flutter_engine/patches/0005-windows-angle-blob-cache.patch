@@ -4,6 +4,15 @@
 
 #include "flutter/shell/platform/windows/egl/manager.h"
 
+#include <windows.h>
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
