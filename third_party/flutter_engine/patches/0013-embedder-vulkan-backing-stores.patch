+#if defined(SHELL_ENABLE_VULKAN) && defined(IMPELLER_SUPPORTS_RENDERING)
+namespace {
+// mcsm8: an embedder's VkImage as an Impeller texture source.
+class EmbedderTextureSourceVK final : public impeller::TextureSourceVK {
+ public:
+  EmbedderTextureSourceVK(impeller::TextureDescriptor desc,
+                          impeller::vk::Image image,
+                          impeller::vk::UniqueImageView view,
+                          fml::closure on_destruct)
+      : TextureSourceVK(desc),
+        image_(image),
+        view_(std::move(view)),
+        on_destruct_(std::move(on_destruct)) {}
+
+  ~EmbedderTextureSourceVK() override {
+    view_.reset();
+    if (on_destruct_) {
+      on_destruct_();
+    }
+  }
+
+ private:
+  impeller::vk::Image GetImage() const override { return image_; }
+  impeller::vk::ImageView GetImageView() const override { return view_.get(); }
+  impeller::vk::ImageView GetRenderTargetView(
+      uint32_t mip_level,
+      uint32_t array_layer) const override {
+    return view_.get();
+  }
+  bool IsSwapchainImage() const override { return false; }
+
+  impeller::vk::Image image_;
+  impeller::vk::UniqueImageView view_;
+  fml::closure on_destruct_;
+};
+}  // namespace
+#endif  // SHELL_ENABLE_VULKAN && IMPELLER_SUPPORTS_RENDERING
+
+// mcsm8: a Vulkan backing store for Impeller (upstream: "Unimplemented").
+// The layer renders into a 4x MSAA transient resolved into the embedder's
+// image, as the Metal backing store does. After the layer is rendered the
+// image is moved to VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL on the engine's
+// queue. Unlike Skia's path there is no host sync: the embedder's own work
+// on the image must be submitted to the same queue (or wait on it), behind a
+// barrier; it returns the image to that layout before the engine renders
+// into it again.
+static std::unique_ptr<flutter::EmbedderRenderTarget>
+MakeRenderTargetFromBackingStoreImpeller(
+    FlutterBackingStore backing_store,
+    const fml::closure& on_release,
+    const std::shared_ptr<impeller::AiksContext>& aiks_context,
+    const FlutterBackingStoreConfig& config,
+    const FlutterVulkanBackingStore* vulkan) {
+#if defined(SHELL_ENABLE_VULKAN) && defined(IMPELLER_SUPPORTS_RENDERING)
+  if (!vulkan->image || !vulkan->image->image) {
+    FML_LOG(ERROR) << "Embedder supplied null Vulkan image.";
+    return nullptr;
+  }
+  const auto vk_format =
+      static_cast<impeller::vk::Format>(vulkan->image->format);
+  const auto format = impeller::VkFormatToImpellerFormat(vk_format);
+  if (!format.has_value()) {
+    FML_LOG(ERROR) << "Unsupported Vulkan backing store format: "
+                   << impeller::vk::to_string(vk_format);
+    return nullptr;
+  }
+  const auto& context = aiks_context->GetContext();
+  auto& context_vk = impeller::ContextVK::Cast(*context);
+  const auto size = impeller::ISize(config.size.width, config.size.height);
+
+  impeller::TextureDescriptor resolve_desc;
+  resolve_desc.format = format.value();
+  resolve_desc.size = size;
+  resolve_desc.mip_count = 1;
+  resolve_desc.sample_count = impeller::SampleCount::kCount1;
+  resolve_desc.storage_mode = impeller::StorageMode::kDevicePrivate;
+  resolve_desc.usage = impeller::TextureUsage::kRenderTarget |
+                       impeller::TextureUsage::kShaderRead;
+
+  const auto image = impeller::vk::Image(
+      reinterpret_cast<VkImage>(vulkan->image->image));
+  impeller::vk::ImageViewCreateInfo view_info = {};
+  view_info.viewType = impeller::vk::ImageViewType::e2D;
+  view_info.format = vk_format;
+  view_info.subresourceRange.aspectMask =
+      impeller::vk::ImageAspectFlagBits::eColor;
+  view_info.subresourceRange.levelCount = 1;
+  view_info.subresourceRange.layerCount = 1;
+  view_info.image = image;
+  auto [result, view] = context_vk.GetDevice().createImageViewUnique(view_info);
+  if (result != impeller::vk::Result::eSuccess) {
+    FML_LOG(ERROR) << "Could not create a view of the embedder's VkImage: "
+                   << impeller::vk::to_string(result);
+    return nullptr;
+  }
+  auto source = std::make_shared<EmbedderTextureSourceVK>(
+      resolve_desc, image, std::move(view),
+      [callback = vulkan->destruction_callback,
+       user_data = vulkan->user_data]() {
+        if (callback) {
+          callback(user_data);
+        }
+      });
+  std::shared_ptr<impeller::Texture> resolve_tex =
+      std::make_shared<impeller::TextureVK>(context, source);
+  resolve_tex->SetLabel("ImpellerBackingStoreResolve");
+  context->UpdateOffscreenLayerPixelFormat(format.value());
+
+  impeller::TextureDescriptor msaa_desc;
+  msaa_desc.storage_mode = impeller::StorageMode::kDeviceTransient;
+  msaa_desc.type = impeller::TextureType::kTexture2DMultisample;
+  msaa_desc.sample_count = impeller::SampleCount::kCount4;
+  msaa_desc.format = format.value();
+  msaa_desc.size = size;
+  msaa_desc.usage = impeller::TextureUsage::kRenderTarget;
+  auto msaa_tex = context->GetResourceAllocator()->CreateTexture(msaa_desc);
+  if (!msaa_tex) {
+    FML_LOG(ERROR) << "Could not allocate MSAA color texture.";
+    return nullptr;
+  }
+  msaa_tex->SetLabel("ImpellerBackingStoreColorMSAA");
+
+  impeller::ColorAttachment color0;
+  color0.texture = msaa_tex;
+  color0.clear_color = impeller::Color::DarkSlateGray();
+  color0.load_action = impeller::LoadAction::kClear;
+  color0.store_action = impeller::StoreAction::kMultisampleResolve;
+  color0.resolve_texture = resolve_tex;
+
+  impeller::RenderTarget render_target_desc;
+  render_target_desc.SetColorAttachment(color0, 0u);
+  // A depth/stencil of the backing store's own, as Impeller's swapchain keeps
+  // one per image: RenderPassVK caches the framebuffer on the resolve texture
+  // and assumes the other attachments don't change, so a stencil Impeller
+  // would allocate per frame leaves the cached framebuffer pointing at a
+  // destroyed view.
+  render_target_desc.SetupDepthStencilAttachments(
+      *context, *context->GetResourceAllocator(), size, /*msaa=*/true,
+      "ImpellerBackingStore");
+
+  auto target = std::make_unique<flutter::EmbedderRenderTargetImpeller>(
+      backing_store, aiks_context,
+      std::make_unique<impeller::RenderTarget>(std::move(render_target_desc)),
+      on_release, fml::closure());
+  std::weak_ptr<impeller::Context> weak_context = context;
+  target->SetDidRenderCallback([weak_context, resolve_tex]() {
+    auto strong = weak_context.lock();
+    if (!strong) {
+      return;
+    }
+    const auto& vk_context = impeller::ContextVK::Cast(*strong);
+    auto cmd_buffer = vk_context.CreateCommandBuffer();
+    if (!cmd_buffer) {
+      return;
+    }
+    impeller::BarrierVK barrier;
+    barrier.cmd_buffer =
+        impeller::CommandBufferVK::Cast(*cmd_buffer).GetCommandBuffer();
+    barrier.new_layout = impeller::vk::ImageLayout::eColorAttachmentOptimal;
+    barrier.src_access = impeller::vk::AccessFlagBits::eColorAttachmentWrite |
+                         impeller::vk::AccessFlagBits::eTransferWrite;
+    barrier.src_stage =
+        impeller::vk::PipelineStageFlagBits::eColorAttachmentOutput |
+        impeller::vk::PipelineStageFlagBits::eTransfer;
+    barrier.dst_access = {};
+    barrier.dst_stage = impeller::vk::PipelineStageFlagBits::eBottomOfPipe;
+    if (!impeller::TextureVK::Cast(*resolve_tex).SetLayout(barrier)) {
+      return;
+    }
+    // No host wait: the desktop compositors (shell/platform/common's
+    // McsmVulkanDevice and swapchain) submit their copies on the same queue
+    // after this, behind a barrier, so the GPU orders them; the CPU doesn't
+    // stall on every layer.
+    vk_context.GetCommandQueue()->Submit({cmd_buffer});
+  });
+  return target;
+#else
+  return nullptr;
+#endif
+}
