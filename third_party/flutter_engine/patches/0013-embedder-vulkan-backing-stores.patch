@@ -97,6 +98,14 @@ std::unique_ptr<SurfaceFrame> GPUSurfaceVulkanImpeller::AcquireFrame(
   // mcsm8: the external view embedder renders into the compositor's backing
   // stores; this frame only carries the layer tree.
   if (!render_to_surface_) {
+    // Once a frame, as SurfaceContextVK::MarkFrameEnd does for Impeller's own
+    // swapchain: the pipeline cache persists every 50 frames and per-thread
+    // command pools are recycled.
+    auto& context_vk = impeller::ContextVK::Cast(*impeller_context_);
+    if (auto library = context_vk.GetPipelineLibrary()) {
+      impeller::PipelineLibraryVK::Cast(*library).DidAcquireSurfaceFrame();
+    }
+    context_vk.DisposeThreadLocalCachedResources();
     return std::make_unique<SurfaceFrame>(
         nullptr, SurfaceFrame::FramebufferInfo(),
         [](const SurfaceFrame& surface_frame, DlCanvas* canvas) {
