 namespace flutter {
 
+// mcsm8: %LOCALAPPDATA%\<exe>\flutter_vk_cache (Windows) or
+// $XDG_CACHE_HOME (else ~/.cache)/<exe>/flutter_vk_cache;
+// FLUTTER_VK_CACHE_DIR overrides it, "0" turns it off.
+static fml::UniqueFD McsmPipelineCacheDirectory() {
+  const char* override_dir = std::getenv("FLUTTER_VK_CACHE_DIR");
+  if (override_dir != nullptr && std::string(override_dir) == "0") {
+    return {};
+  }
+  std::string base;
+  if (override_dir != nullptr && override_dir[0] != '\0') {
+    base = override_dir;
+  } else {
+    auto [ok, exe] = fml::paths::GetExecutablePath();
+    if (!ok) {
+      return {};
+    }
+    std::string name = fml::paths::GetDirectoryName(exe);
+    name = exe.substr(name.size() + (name.empty() ? 0 : 1));
+    if (auto dot = name.rfind('.'); dot != std::string::npos) {
+      name = name.substr(0, dot);
+    }
+#if FML_OS_WIN
+    const char* root = std::getenv("LOCALAPPDATA");
+#else
+    const char* root = std::getenv("XDG_CACHE_HOME");
+    std::string home_cache;
+    if (root == nullptr || root[0] == '\0') {
