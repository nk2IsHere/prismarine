@@ -0,0 +1,73 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/windows/compositor_vulkan.h"
+
+#include "flutter/fml/logging.h"
+#include "flutter/shell/platform/common/mcsm_vulkan_device.h"
+#include "flutter/shell/platform/common/mcsm_vulkan_swapchain.h"
+#include "flutter/shell/platform/windows/flutter_windows_view.h"
+
+namespace flutter {
+
+CompositorVulkan::CompositorVulkan(FlutterWindowsEngine* engine)
+    : engine_(engine) {}
+
+bool CompositorVulkan::CreateBackingStore(
+    const FlutterBackingStoreConfig& config,
+    FlutterBackingStore* result) {
+  McsmVulkanDevice* device = engine_->vulkan_device();
+  return device != nullptr && device->CreateBackingStore(config, result);
+}
+
+bool CompositorVulkan::CollectBackingStore(const FlutterBackingStore* store) {
+  McsmVulkanDevice::CollectBackingStore(store);
+  return true;
+}
+
+bool CompositorVulkan::Present(FlutterWindowsView* view,
+                               const FlutterLayer** layers,
+                               size_t layers_count) {
+  FML_DCHECK(view != nullptr);
+
+  if (layers_count == 0) {
+    if (!view->OnEmptyFrameGenerated()) {
+      return false;
+    }
+    McsmVulkanSwapchain* swapchain = view->vulkan_swapchain();
+    if (swapchain == nullptr || !swapchain->Clear()) {
+      return false;
+    }
+    view->OnFramePresented();
+    return true;
+  }
+
+  // TODO: Support compositing layers and platform views (as the GL
+  // compositor).
+  FML_DCHECK(layers_count == 1);
+  FML_DCHECK(layers[0]->type == kFlutterLayerContentTypeBackingStore);
+  FML_DCHECK(layers[0]->backing_store->type == kFlutterBackingStoreTypeVulkan);
+
+  const auto width = static_cast<size_t>(layers[0]->size.width);
+  const auto height = static_cast<size_t>(layers[0]->size.height);
+
+  // Resizes the swapchain if a resize is pending and the frame has the
+  // target size (as the EGL surface is resized).
+  if (!view->OnFrameGenerated(width, height)) {
+    return false;
+  }
+  McsmVulkanSwapchain* swapchain = view->vulkan_swapchain();
+  if (swapchain == nullptr) {
+    return false;
+  }
+  auto* image = static_cast<const McsmVulkanDevice::Image*>(
+      layers[0]->backing_store->vulkan.user_data);
+  if (!swapchain->Present(image)) {
+    return false;
+  }
+  view->OnFramePresented();
+  return true;
+}
+
+}  // namespace flutter
