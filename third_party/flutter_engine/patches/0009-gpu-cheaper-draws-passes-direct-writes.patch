+    }
+    hash = h;
+  }
+  bool operator==(const McsmPipelineKey& o) const {
+    return count == o.count && hash == o.hash &&
+           std::memcmp(words.data(), o.words.data(), count * sizeof(uint32_t)) ==
+               0;
+  }
