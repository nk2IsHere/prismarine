+const McsmPipelineKey& RenderPass::CurrentPipelineKey() {
+  if (current_key_version_ == pipeline_state_version_ &&
+      current_key_.count != 0) {
+    return current_key_;
+  }
+  McsmPipelineKey& k = current_key_;
+  k.Clear();
+  k.Push(static_cast<uint32_t>(pipeline_descriptor_.GetCullMode()));
+  k.Push(static_cast<uint32_t>(pipeline_descriptor_.GetWindingOrder()));
+  k.Push(static_cast<uint32_t>(pipeline_descriptor_.GetPrimitiveType()));
+  k.Push(static_cast<uint32_t>(pipeline_descriptor_.GetPolygonMode()));
+  k.Push(static_cast<uint32_t>(render_target_.GetSampleCount()));
+  // Each colour descriptor as GetOrCreatePipeline builds it: the format is
+  // its target's (the render target's when the attachment has no texture),
+  // or its own for an index with no attachment.
+  for (const auto& [index, color] : color_descriptors_) {
+    uint32_t format = static_cast<uint32_t>(color.format);
+    if (render_target_.HasColorAttachment(index)) {
+      const auto& attachment = render_target_.GetColorAttachment(index);
+      format = static_cast<uint32_t>(
+          attachment.texture
+              ? attachment.texture->GetTextureDescriptor().format
+              : render_target_.GetRenderTargetPixelFormat());
+    }
+    k.Push(static_cast<uint32_t>(index));
+    k.Push(format);
+    k.Push(color.blending_enabled ? 1u : 0u);
+    k.Push(static_cast<uint32_t>(color.src_color_blend_factor));
+    k.Push(static_cast<uint32_t>(color.color_blend_op));
+    k.Push(static_cast<uint32_t>(color.dst_color_blend_factor));
+    k.Push(static_cast<uint32_t>(color.src_alpha_blend_factor));
+    k.Push(static_cast<uint32_t>(color.alpha_blend_op));
+    k.Push(static_cast<uint32_t>(color.dst_alpha_blend_factor));
+    k.Push(static_cast<uint32_t>(static_cast<uint64_t>(color.write_mask)));
+  }
+  k.Push(0xFFFFFFFFu);
+  {
+    auto stencil = render_target_.GetStencilAttachment();
+    if (stencil && impeller::IsStencilWritable(
+                       stencil->texture->GetTextureDescriptor().format)) {
+      k.Push(static_cast<uint32_t>(
+          stencil->texture->GetTextureDescriptor().format));
+      for (const auto* d : {&stencil_front_desc_, &stencil_back_desc_}) {
+        k.Push(static_cast<uint32_t>(d->stencil_compare));
+        k.Push(static_cast<uint32_t>(d->stencil_failure));
+        k.Push(static_cast<uint32_t>(d->depth_failure));
+        k.Push(static_cast<uint32_t>(d->depth_stencil_pass));
+        k.Push(d->read_mask);
+        k.Push(d->write_mask);
+      }
+    } else {
+      k.Push(0);
+    }
+  }
+  {
+    auto depth = render_target_.GetDepthAttachment();
+    if (depth && impeller::IsDepthWritable(
+                     depth->texture->GetTextureDescriptor().format)) {
+      k.Push(static_cast<uint32_t>(
+          depth->texture->GetTextureDescriptor().format));
+      k.Push(static_cast<uint32_t>(depth_desc_.depth_compare));
+      k.Push(depth_desc_.depth_write_enabled ? 1u : 0u);
+    } else {
+      k.Push(0);
+    }
+  }
+  k.Finish();
+  current_key_version_ = pipeline_state_version_;
+  return k;
+}
