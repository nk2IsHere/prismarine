   return false;
 }
 
+void CommandBuffer::McsmEndOpenEncoder() {
+  // Only Metal encodes as it goes; the other backends record commands and
+  // encode them all at submit.
+  if (encodables_.empty() ||
+      context_->GetBackendType() != impeller::Context::BackendType::kMetal) {
+    return;
+  }
+  auto& last = encodables_.back();
+  if (last.ended && *last.ended) {
+    return;
+  }
+  if (!last.ended) {
+    last.ended = std::make_shared<bool>(false);
+  }
+  last.EncodeCommands();
+}
