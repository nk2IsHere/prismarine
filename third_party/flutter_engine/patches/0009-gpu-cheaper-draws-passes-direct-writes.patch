-RenderPass::PipelineStateKey RenderPass::MakePipelineStateKey() const {
-  return PipelineStateKey{
-      .cull_mode = pipeline_descriptor_.GetCullMode(),
-      .winding_order = pipeline_descriptor_.GetWindingOrder(),
