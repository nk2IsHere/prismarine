+impeller::raw_ptr<const impeller::Sampler> RenderPass::GetSampler(
+    const impeller::SamplerDescriptor& desc,
+    uint32_t packed) {
+  for (const auto& entry : samplers_) {
+    if (entry.sampler && entry.packed == packed) {
+      return entry.sampler;
+    }
+  }
+  auto sampler = GetContext()->GetSamplerLibrary()->GetSampler(desc);
+  samplers_[next_sampler_] = SamplerEntry{packed, sampler};
+  next_sampler_ = (next_sampler_ + 1) % samplers_.size();
+  return sampler;
