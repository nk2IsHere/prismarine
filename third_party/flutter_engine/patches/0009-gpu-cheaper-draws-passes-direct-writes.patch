+uint32_t RenderPass::ScalarState() const {
+  return static_cast<uint32_t>(pipeline_descriptor_.GetCullMode()) |
+         (static_cast<uint32_t>(pipeline_descriptor_.GetWindingOrder()) << 4) |
+         (static_cast<uint32_t>(pipeline_descriptor_.GetPrimitiveType()) << 8) |
+         (static_cast<uint32_t>(pipeline_descriptor_.GetPolygonMode()) << 12);
+}
+
+RenderPass::RecentPipeline* RenderPass::FindRecent(uint32_t scalar) {
+  const uintptr_t rp = reinterpret_cast<uintptr_t>(render_pipeline_.get());
+  auto& e = recent_[((rp >> 4) ^ scalar * 2654435761u) % recent_.size()];
+  return (e.pipeline && e.render_pipeline == render_pipeline_.get() &&
+          e.scalar == scalar && e.slow_version == slow_state_version_)
+             ? &e
+             : nullptr;
+}
+
+void RenderPass::AddRecent(
+    uint32_t scalar,
+    const std::shared_ptr<impeller::Pipeline<impeller::PipelineDescriptor>>&
+        pipeline) {
+  const uintptr_t rp = reinterpret_cast<uintptr_t>(render_pipeline_.get());
+  auto& e = recent_[((rp >> 4) ^ scalar * 2654435761u) % recent_.size()];
+  e.render_pipeline = render_pipeline_.get();
+  e.scalar = scalar;
+  e.slow_version = slow_state_version_;
+  e.pipeline = pipeline;
 }
 
