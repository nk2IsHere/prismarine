+namespace {
+
+// mcsm8: what a render pass and framebuffer built for [target] depend on
+// besides colour 0's subresource and sample count: every attachment's
+// texture (by its never-reused id), resolve texture, load and store actions,
+// subresource, and the layout a loaded attachment starts in. Mixed with
+// splitmix64 steps; a cached pair is reused only for an equal key.
+uint64_t McsmAttachmentsKey(const RenderTarget& target, bool is_swapchain) {
+  uint64_t key = 0x6d63736d38ull;
+  auto mix = [&key](uint64_t v) {
+    uint64_t z = (key ^ v) + 0x9e3779b97f4a7c15ull;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ull;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebull;
+    key = z ^ (z >> 31);
+  };
+  auto id = [](const std::shared_ptr<Texture>& texture) -> uint64_t {
+    return texture ? TextureVK::Cast(*texture).McsmSourceId() : 0u;
+  };
+  auto layout = [](const Attachment& a) -> uint64_t {
+    return a.load_action == LoadAction::kLoad && a.texture
+               ? static_cast<uint64_t>(TextureVK::Cast(*a.texture).GetLayout())
+               : 0xffffu;
+  };
+  auto attachment = [&](const Attachment& a) {
+    mix(id(a.texture));
+    mix(id(a.resolve_texture));
+    mix(static_cast<uint64_t>(a.load_action) << 16 |
+        static_cast<uint64_t>(a.store_action));
+    mix(static_cast<uint64_t>(a.mip_level) << 32 | a.slice);
+    mix(layout(a));
+  };
+  target.IterateAllColorAttachments(
+      [&](size_t index, const ColorAttachment& a) -> bool {
+        mix(0xc0u + index);
+        attachment(a);
+        return true;
+      });
+  if (auto depth = target.GetDepthAttachment(); depth.has_value()) {
+    mix(0xd0u);
+    attachment(*depth);
+  }
+  if (auto stencil = target.GetStencilAttachment(); stencil.has_value()) {
+    mix(0x5cu);
+    attachment(*stencil);
+  }
+  mix(is_swapchain ? 1u : 2u);
+  return key;
+}
+
