+    if (attachment.load_action != LoadAction::kLoad || !attachment.texture) {
+      return true;
+    }
+    const auto& texture = TextureVK::Cast(*attachment.texture);
+    if (texture.GetLayout() != vk::ImageLayout::eUndefined) {
+      return true;
+    }
+    const PixelFormat format = attachment.texture->GetTextureDescriptor().format;
+    const bool depth_stencil =
+        IsDepthWritable(format) || IsStencilWritable(format);
