From a9b9d65ab02fc009c9e07a7f4a113749ee78e3cf Mon Sep 17 00:00:00 2001
From: mcsm <mcsm@localhost>
Date: Mon, 26 Oct 2026 18:17:43 +0100
Subject: [PATCH 1/3] impeller (mcsm8): a host-visible buffer that doesn't fit
 the Vulkan staging pool's memory type (the 256 MB device-local + host-visible
 heap on a discrete GPU without resizable BAR) is allocated outside the pool,
 where VMA falls back to other host-visible memory (TownFair ran out of device
 memory on the RTX 4060 Ti)

---
 .../renderer/backend/vulkan/allocator_vk.cc        | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/engine/src/flutter/impeller/renderer/backend/vulkan/allocator_vk.cc b/engine/src/flutter/impeller/renderer/backend/vulkan/allocator_vk.cc
index 20313ea2aad..024d45feca9 100644
--- a/engine/src/flutter/impeller/renderer/backend/vulkan/allocator_vk.cc
+++ b/engine/src/flutter/impeller/renderer/backend/vulkan/allocator_vk.cc
@@ -588,6 +588,20 @@ std::shared_ptr<DeviceBuffer> AllocatorVK::OnCreateBuffer(
                                              &buffer_allocation,      //
                                              &buffer_allocation_info  //
                                              )};
+  // mcsm8: the staging pool is tied to one memory type, which on a discrete
+  // GPU without resizable BAR is the small device-local + host-visible heap
+  // (256 MB): a scene's host-visible buffers then run out of it. Outside the
+  // pool VMA falls back to other host-visible memory.
+  if (result != vk::Result::eSuccess && allocation_info.pool != nullptr) {
+    allocation_info.pool = nullptr;
+    result = vk::Result{::vmaCreateBuffer(allocator_.get(),        //
+                                          &buffer_info_native,     //
+                                          &allocation_info,        //
+                                          &buffer,                 //
+                                          &buffer_allocation,      //
+                                          &buffer_allocation_info  //
+                                          )};
+  }
 
   auto type = memory_properties_.memoryTypes[buffer_allocation_info.memoryType];
   bool is_host_coherent =
