 }
 
+// |RenderPass|
+bool RenderPassVK::McsmSetViewports(const Viewport* viewports,
+                                    const IRect32* scissors,
+                                    size_t count) {
+  // mcsm8: all 16 slots (the pipelines built for viewport arrays use 16);
+  // slots past [count] repeat the first.
+  constexpr size_t kMax = 16;
+  if (count == 0 || count > kMax) {
+    return false;
+  }
+  std::array<vk::Viewport, kMax> vp;
+  std::array<vk::Rect2D, kMax> sc;
+  for (size_t i = 0; i < kMax; i++) {
+    const size_t k = i < count ? i : 0;
+    vp[i] = ToVkViewport(viewports[k]);
+    const IRect32& s = scissors[k];
+    sc[i] = vk::Rect2D()
+                .setOffset(vk::Offset2D(s.GetX(), s.GetY()))
+                .setExtent(vk::Extent2D(s.GetWidth(), s.GetHeight()));
+  }
+  command_buffer_vk_.setViewport(0, kMax, vp.data());
+  command_buffer_vk_.setScissor(0, kMax, sc.data());
+  return true;
+}
+
 // |RenderPass|
 void RenderPassVK::SetElementCount(size_t count) {
   element_count_ = count;
