From a193cfcf3f65848c8b80ea4b3f0c4f1eb5977e09 Mon Sep 17 00:00:00 2001
From: mcsm <mcsm@localhost>
Date: Mon, 26 Oct 2026 17:46:25 +0100
Subject: [PATCH 1/2] flutter_gpu (mcsm8): feature bits per backend once the
 default context exists (bit 1024; InternalFlutterGpu_McsmBackend), and Vulkan
 ends a command buffer's previous pass when the next begins (it encodes as it
 goes, like Metal)

---
 engine/src/flutter/lib/gpu/command_buffer.cc |  8 ++--
 engine/src/flutter/lib/gpu/context.cc        | 43 +++++++++++++++++++-
 engine/src/flutter/lib/gpu/context.h         |  6 +++
 engine/src/flutter/lib/gpu/render_pass.cc    |  6 ++-
 4 files changed, 57 insertions(+), 6 deletions(-)

diff --git a/engine/src/flutter/lib/gpu/command_buffer.cc b/engine/src/flutter/lib/gpu/command_buffer.cc
index 9946bd585f9..a1ee6dae4d9 100644
--- a/engine/src/flutter/lib/gpu/command_buffer.cc
+++ b/engine/src/flutter/lib/gpu/command_buffer.cc
@@ -43,10 +43,12 @@ bool CommandBuffer::Encodable::EncodeCommands() const {
 }
 
 void CommandBuffer::McsmEndOpenEncoder() {
-  // Only Metal encodes as it goes; the other backends record commands and
-  // encode them all at submit.
+  // Metal and Vulkan encode as they go (mcsm8: Vulkan begins a render pass
+  // when it is created); GLES records commands and encodes them at submit.
+  const auto backend = context_->GetBackendType();
   if (encodables_.empty() ||
-      context_->GetBackendType() != impeller::Context::BackendType::kMetal) {
+      (backend != impeller::Context::BackendType::kMetal &&
+       backend != impeller::Context::BackendType::kVulkan)) {
     return;
   }
   auto& last = encodables_.back();
diff --git a/engine/src/flutter/lib/gpu/context.cc b/engine/src/flutter/lib/gpu/context.cc
index 28ba701e134..f97a186c4a1 100644
--- a/engine/src/flutter/lib/gpu/context.cc
+++ b/engine/src/flutter/lib/gpu/context.cc
@@ -4,6 +4,8 @@
 
 #include "flutter/lib/gpu/context.h"
 
+#include <atomic>
+
 #include <future>
 
 #include "flutter/lib/gpu/formats.h"
@@ -99,12 +101,31 @@ std::shared_ptr<impeller::Context>& Context::GetContextShared() {
 /// Exports
 ///
 
+// mcsm8: the default context's backend once Flutter GPU made it (-1 before):
+// 0 Metal, 1 GLES, 2 Vulkan.
+static std::atomic<int> g_mcsm_backend{-1};
+
+static int McsmBackendIndex(impeller::Context::BackendType type) {
+  switch (type) {
+    case impeller::Context::BackendType::kMetal:
+      return 0;
+    case impeller::Context::BackendType::kOpenGLES:
+      return 1;
+    case impeller::Context::BackendType::kVulkan:
+      return 2;
+  }
+  return -1;
+}
+
 Dart_Handle InternalFlutterGpu_Context_InitializeDefault(Dart_Handle wrapper) {
   std::optional<std::string> out_error;
   auto impeller_context = flutter::gpu::Context::GetDefaultContext(out_error);
   if (out_error.has_value()) {
     return tonic::ToDart(out_error.value());
   }
+  if (impeller_context) {
+    g_mcsm_backend = McsmBackendIndex(impeller_context->GetBackendType());
+  }
 
   auto res = fml::MakeRefCounted<flutter::gpu::Context>(impeller_context);
   res->AssociateWithDartWrapper(wrapper);
@@ -200,5 +221,25 @@ extern int64_t InternalFlutterGpu_McsmFeatures() {
   // (RenderPass_McsmSetViewports; false on other backends), 512 = draws from
   // a first instance (RenderPass_McsmDrawInstanced). (32 is unused: a
   // batched encoding was tried and measured no cheaper than the leaf calls.)
-  return 1 | 2 | 4 | 8 | 16 | 64 | 128 | 256 | 512;
+  //
+  // mcsm8: once the default context exists the bits are its backend's, with
+  // 1024 set: Metal 16, 64, 256; GLES 64, 128; Vulkan 64 (several passes on
+  // one command buffer: Vulkan ends the previous pass, GLES records them).
+  // Before that, every bit without 1024 (callers ask again later).
+  const int backend = g_mcsm_backend;
+  const int64_t common = 1 | 2 | 4 | 8 | 512;
+  switch (backend) {
+    case 0:
+      return common | 16 | 64 | 256 | 1024;
+    case 1:
+      return common | 64 | 128 | 1024;
+    case 2:
+      return common | 64 | 1024;
+    default:
+      return common | 16 | 64 | 128 | 256;
+  }
+}
+
+extern int InternalFlutterGpu_McsmBackend() {
+  return g_mcsm_backend;
 }
diff --git a/engine/src/flutter/lib/gpu/context.h b/engine/src/flutter/lib/gpu/context.h
index 70269e2f27d..cb8a15674eb 100644
--- a/engine/src/flutter/lib/gpu/context.h
+++ b/engine/src/flutter/lib/gpu/context.h
@@ -120,9 +120,15 @@ extern bool InternalFlutterGpu_Context_SupportsTextureFormat(
 ///   128: several colour attachments in one pass on GLES (mcsm7)
 ///   256: viewport arrays, RenderPass_McsmSetViewports (Metal only) (mcsm7)
 ///   512: RenderPass_McsmDrawInstanced, draws from a first instance (mcsm7)
+///   1024: the bits are the default context's backend's (mcsm8)
 FLUTTER_GPU_EXPORT
 extern int64_t InternalFlutterGpu_McsmFeatures();
 
+/// mcsm8: the default context's backend once Flutter GPU created it: -1
+/// before, 0 Metal, 1 GLES, 2 Vulkan. Leaf.
+FLUTTER_GPU_EXPORT
+extern int InternalFlutterGpu_McsmBackend();
+
 }  // extern "C"
 
 #endif  // FLUTTER_LIB_GPU_CONTEXT_H_
diff --git a/engine/src/flutter/lib/gpu/render_pass.cc b/engine/src/flutter/lib/gpu/render_pass.cc
index 3aa9f177a87..b2fcc790ab1 100644
--- a/engine/src/flutter/lib/gpu/render_pass.cc
+++ b/engine/src/flutter/lib/gpu/render_pass.cc
@@ -91,9 +91,11 @@ bool RenderPass::Begin(flutter::gpu::CommandBuffer& command_buffer) {
   if (!render_pass_) {
     return false;
   }
-  // (Metal only: the other backends encode every pass at submit.)
+  // (Metal and Vulkan: GLES encodes every pass at submit.)
   if (GetContext()->GetBackendType() ==
-      impeller::Context::BackendType::kMetal) {
+          impeller::Context::BackendType::kMetal ||
+      GetContext()->GetBackendType() ==
+          impeller::Context::BackendType::kVulkan) {
     ended_ = std::make_shared<bool>(false);
   }
   command_buffer.AddRenderPass(render_pass_, ended_);
-- 
