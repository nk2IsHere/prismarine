+RenderPass::PipelineStateKey RenderPass::MakePipelineStateKey() const {
+  return PipelineStateKey{
+      .cull_mode = pipeline_descriptor_.GetCullMode(),
+      .winding_order = pipeline_descriptor_.GetWindingOrder(),
+      .primitive_type = pipeline_descriptor_.GetPrimitiveType(),
+      .polygon_mode = pipeline_descriptor_.GetPolygonMode(),
+      .color = color_descriptors_,
+      .depth = depth_desc_,
+      .stencil_front = stencil_front_desc_,
+      .stencil_back = stencil_back_desc_,
+  };
+}
+
+std::shared_ptr<impeller::Pipeline<impeller::PipelineDescriptor>>
+RenderPass::GetCachedPipeline() {
+  // Fast path: the same RenderPipeline and no state change since the last
+  // draw. Everything else that goes into the descriptor (the render target's
+  // sample count and formats) is fixed for the life of this pass.
+  if (last_pipeline_ && render_pipeline_.get() == last_render_pipeline_ &&
+      pipeline_state_version_ == last_pipeline_state_version_) {
+    return last_pipeline_;
+  }
+  std::shared_ptr<impeller::Pipeline<impeller::PipelineDescriptor>> pipeline;
+  {
+    PipelineStateKey key = MakePipelineStateKey();
+    for (const auto& entry : pipeline_cache_) {
+      if (entry.render_pipeline.get() == render_pipeline_.get() &&
+          entry.key == key) {
+        pipeline = entry.pipeline;
+        break;
+      }
+    }
+  }
+  if (!pipeline) {
+    pipeline = GetOrCreatePipeline();
+    if (!pipeline) {
+      return pipeline;
+    }
+    // GetOrCreatePipeline fills in the colour attachments' formats, so the
+    // key is taken after it.
+    pipeline_cache_.push_back(CachedPipeline{
+        .render_pipeline = render_pipeline_,
+        .key = MakePipelineStateKey(),
+        .pipeline = pipeline,
+    });
+  }
+  last_render_pipeline_ = render_pipeline_.get();
+  last_pipeline_state_version_ = pipeline_state_version_;
+  last_pipeline_ = pipeline;
+  return pipeline;
+}
+
+bool RenderPass::SendBuffer(impeller::ShaderStage stage,
+                            size_t index,
+                            const void* writer,
+                            bool dirty) {
+  if (index >= kTrackedIndices) {
+    return true;
+  }
+  IndexWriters& writers = stage == impeller::ShaderStage::kVertex
+                              ? vertex_buffer_writers_
+                              : fragment_buffer_writers_;
+  if (!dirty && writers[index] == writer) {
+    return false;
+  }
+  writers[index] = writer;
+  return true;
+}
+
+bool RenderPass::SendTexture(impeller::ShaderStage stage,
+                             size_t index,
+                             const void* writer,
+                             bool dirty) {
+  if (index >= kTrackedIndices) {
+    return true;
+  }
+  IndexWriters& writers = stage == impeller::ShaderStage::kVertex
+                              ? vertex_texture_writers_
+                              : fragment_texture_writers_;
+  if (!dirty && writers[index] == writer) {
+    return false;
+  }
+  writers[index] = writer;
+  return true;
+}
+
 bool RenderPass::Draw(size_t element_count,
                       size_t instance_count,
                       bool indexed) {
@@ -195,8 +289,83 @@ bool RenderPass::Draw(size_t element_count,
     return false;
   }
 
-  render_pass_->SetPipeline(impeller::PipelineRef(GetOrCreatePipeline()));
+  render_pass_->SetPipeline(impeller::PipelineRef(GetCachedPipeline()));
+
+  if (retained_bindings_) {
+    // mcsm E2: the reflected metadata by pointer (the shader owns it and
+    // RenderPassMTL doesn't read it), and only bindings the encoder doesn't
+    // already hold from this same entry.
+    auto send_buffers = [&](impeller::ShaderStage stage,
+                            BufferUniformMap& map) {
+      for (auto& [key, buffer] : map) {
+        if (SendBuffer(stage, buffer.slot.ext_res_0, key, buffer.dirty)) {
+          render_pass_->BindResource(
+              stage, impeller::DescriptorType::kUniformBuffer, buffer.slot,
+              buffer.view.GetMetadata(), buffer.view.resource);
+        }
+        buffer.dirty = false;
+      }
+    };
+    auto send_textures = [&](impeller::ShaderStage stage,
+                             TextureUniformMap& map) {
+      for (auto& [key, entry] : map) {
+        const auto& texture = entry.binding;
+        if (SendTexture(stage, texture.slot.texture_index, key, entry.dirty)) {
+          render_pass_->BindResource(
+              stage, impeller::DescriptorType::kSampledImage, texture.slot,
+              texture.texture.GetMetadata(), texture.texture.resource,
+              texture.sampler);
+        }
+        entry.dirty = false;
+      }
+    };
+    send_buffers(impeller::ShaderStage::kVertex, vertex_uniform_bindings);
+    send_textures(impeller::ShaderStage::kVertex, vertex_texture_bindings);
+    send_buffers(impeller::ShaderStage::kFragment, fragment_uniform_bindings);
+    send_textures(impeller::ShaderStage::kFragment,
+                  fragment_texture_bindings);
+    bool send_vertex_buffers = false;
+    for (size_t i = 0; i < vertex_buffer_count; i++) {
+      // RenderPassMTL binds vertex buffer i at buffer index
+      // kReservedVertexBufferIndex - i of the vertex stage.
+      send_vertex_buffers |= SendBuffer(
+          impeller::ShaderStage::kVertex,
+          impeller::VertexDescriptor::kReservedVertexBufferIndex - i,
+          &vertex_buffers[i], vertex_buffer_dirty[i]);
+      vertex_buffer_dirty[i] = false;
+    }
+    if (send_vertex_buffers) {
+      render_pass_->SetVertexBuffer(vertex_buffers.data(),
+                                    vertex_buffer_count);
+    }
+  } else {
+    SendAllBindings();
+  }
+  if (indexed) {
+    render_pass_->SetIndexBuffer(index_buffer, index_buffer_type);
+  } else {
+    render_pass_->SetIndexBuffer(impeller::BufferView{},
+                                 impeller::IndexType::kNone);
+  }
+  render_pass_->SetElementCount(element_count);
+  render_pass_->SetInstanceCount(instance_count);
+
+  render_pass_->SetStencilReference(stencil_reference);
+
+  if (viewport.has_value()) {
+    render_pass_->SetViewport(viewport.value());
+  }
 
+  if (scissor.has_value()) {
+    render_pass_->SetScissor(scissor.value());
+  }
+
+  bool result = render_pass_->Draw().ok();
+
+  return result;
+}
