+  /// mcsm E1: called by every export that changes pipeline state (blend,
+  /// depth, stencil, cull, winding, primitive, polygon mode).
+  void MarkPipelineStateChanged() { ++pipeline_state_version_; }
+
  private:
+  // mcsm E1: the pipeline state that, with the RenderPipeline and this
+  // pass's render target, decides the Impeller pipeline.
+  struct PipelineStateKey {
+    impeller::CullMode cull_mode;
+    impeller::WindingOrder winding_order;
+    impeller::PrimitiveType primitive_type;
+    impeller::PolygonMode polygon_mode;
+    std::map<size_t, impeller::ColorAttachmentDescriptor> color;
+    impeller::DepthAttachmentDescriptor depth;
+    impeller::StencilAttachmentDescriptor stencil_front;
+    impeller::StencilAttachmentDescriptor stencil_back;
+
+    bool operator==(const PipelineStateKey& o) const {
+      return cull_mode == o.cull_mode && winding_order == o.winding_order &&
+             primitive_type == o.primitive_type &&
+             polygon_mode == o.polygon_mode && color == o.color &&
+             depth == o.depth && stencil_front == o.stencil_front &&
+             stencil_back == o.stencil_back;
+    }
+  };
+
+  struct CachedPipeline {
+    fml::RefPtr<RenderPipeline> render_pipeline;
+    PipelineStateKey key;
+    std::shared_ptr<impeller::Pipeline<impeller::PipelineDescriptor>>
+        pipeline;
+  };
+
+  PipelineStateKey MakePipelineStateKey() const;
+
+  /// Every binding, vertex and index buffer, each time (non-Metal backends).
+  void SendAllBindings();
+
+  /// mcsm E1: the pipeline for the bound RenderPipeline and the current
+  /// state, from this pass's cache; GetOrCreatePipeline on a miss.
+  std::shared_ptr<impeller::Pipeline<impeller::PipelineDescriptor>>
+  GetCachedPipeline();
+
+  // mcsm E2: whether the encoder keeps bindings between draws (Metal), and
+  // which binding last wrote each encoder index, per stage.
+  static constexpr size_t kTrackedIndices = 32;
+  using IndexWriters = std::array<const void*, kTrackedIndices>;
+  bool SendBuffer(impeller::ShaderStage stage,
+                  size_t index,
+                  const void* writer,
+                  bool dirty);
+  bool SendTexture(impeller::ShaderStage stage,
+                   size_t index,
+                   const void* writer,
+                   bool dirty);
+  bool retained_bindings_ = false;
+  IndexWriters vertex_buffer_writers_{};
+  IndexWriters fragment_buffer_writers_{};
+  IndexWriters vertex_texture_writers_{};
+  IndexWriters fragment_texture_writers_{};
+
+  uint64_t pipeline_state_version_ = 1;
+  const RenderPipeline* last_render_pipeline_ = nullptr;
+  uint64_t last_pipeline_state_version_ = 0;
+  std::shared_ptr<impeller::Pipeline<impeller::PipelineDescriptor>>
+      last_pipeline_;
+  std::vector<CachedPipeline> pipeline_cache_;
+
   /// Lookup an Impeller pipeline by building a descriptor based on the current
