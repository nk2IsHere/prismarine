@@ -160,6 +160,9 @@ bool RenderPass::McsmBindStorageBuffer(
     size_t length) {
   const Shader::StorageBinding* binding = shader.McsmGetStorageBuffer(index);
   const impeller::ShaderStage stage = shader.GetShaderStage();
+  if (binding && binding->unused) {
+    return true;  // mcsm10: the stage never reads it.
+  }
   if (!binding || !buffer ||
       (stage != impeller::ShaderStage::kVertex &&
        stage != impeller::ShaderStage::kFragment) ||
@@ -253,6 +256,9 @@ void RenderPass::McsmSendStorageBuffers() {
 }
 
 bool RenderPass::McsmBind(McsmBinding binding) {
+  if (binding.slot.unused) {
+    return true;  // mcsm10: the stage never reads it.
+  }
   for (auto& entry : mcsm_bindings_) {
     if (entry.stage == binding.stage && entry.kind == binding.kind &&
         entry.slot.binding == binding.slot.binding &&
diff --git a/engine/src/flutter/lib/gpu/shader.h b/engine/src/flutter/lib/gpu/shader.h
index 42435385831..b41606a3fed 100644
