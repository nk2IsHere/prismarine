@@ -96,6 +96,9 @@ bool ComputePass::BindStorageBuffer(
   if (!binding) {
     return false;
   }
+  if (binding->unused) {
+    return true;  // mcsm10: the shader never reads it.
+  }
   static const impeller::ShaderMetadata kNoMetadata;
   return pass_->BindResource(
       impeller::ShaderStage::kCompute, impeller::DescriptorType::kStorageBuffer,
@@ -133,6 +136,9 @@ bool ComputePass::BindStorageImage(
   if (!binding) {
     return false;
   }
+  if (binding->unused) {
+    return true;  // mcsm10: the shader never reads it.
+  }
   static const impeller::ShaderMetadata kNoMetadata;
   const impeller::SampledImageSlot slot{
       .name = binding->name.c_str(),
@@ -160,6 +166,9 @@ bool ComputePass::BindTexelBuffer(
   if (!slot) {
     return false;
   }
+  if (slot->unused) {
+    return true;  // mcsm10: the shader never reads it.
+  }
   return pass_->McsmBindTexelBuffer(
       impeller::ShaderStage::kCompute,
       {.metal_texture = slot->ext_res_0,
@@ -177,6 +186,9 @@ bool ComputePass::BindSeparateTexture(
     return false;
   }
   const Shader::McsmBinding* slot = pipeline_->GetShader()->McsmGet(3, index);
+  if (slot && slot->unused) {
+    return true;  // mcsm10: the shader never reads it.
+  }
   return slot && pass_->McsmBindSeparateTexture(impeller::ShaderStage::kCompute,
                                                 slot->ext_res_0, slot->binding,
                                                 std::move(texture));
@@ -189,6 +201,9 @@ bool ComputePass::BindSeparateSampler(
     return false;
   }
   const Shader::McsmBinding* slot = pipeline_->GetShader()->McsmGet(4, index);
+  if (slot && slot->unused) {
+    return true;  // mcsm10: the shader never reads it.
+  }
   return slot && pass_->McsmBindSeparateSampler(
                      impeller::ShaderStage::kCompute, slot->ext_res_0,
                      slot->binding,
diff --git a/engine/src/flutter/lib/gpu/render_pass.cc b/engine/src/flutter/lib/gpu/render_pass.cc
index 6d8b3e8f776..20a68dc17e2 100644
