+++ b/engine/src/flutter/lib/gpu/shader.h
@@ -47,6 +47,7 @@ class Shader : public RefCountedDartWrappable<Shader> {
     size_t set = 0u;
     size_t binding = 0u;
     bool read_only = false;
+    bool unused = false;  // mcsm10: declared, never read: binds are no-ops.
   };
 
   ~Shader() override;
@@ -96,6 +97,7 @@ class Shader : public RefCountedDartWrappable<Shader> {
     size_t ext_res_1 = ~size_t{0};
     size_t binding = 0u;
     bool storage = false;
+    bool unused = false;  // mcsm10: declared, never read: binds are no-ops.
   };
   void McsmSetBindings(std::vector<McsmBinding> texel_buffers,
                        std::vector<McsmBinding> textures,
diff --git a/engine/src/flutter/lib/gpu/shader_library.cc b/engine/src/flutter/lib/gpu/shader_library.cc
index 24cde29f8e0..06f2cd50c5d 100644
--- a/engine/src/flutter/lib/gpu/shader_library.cc
+++ b/engine/src/flutter/lib/gpu/shader_library.cc
@@ -344,7 +344,13 @@ static ShaderLibrary::ShaderMap ParseShaderBundle(
             .set = static_cast<size_t>(entry->set()),
             .binding = static_cast<size_t>(entry->binding()),
             .read_only = entry->read_only(),
+            .unused = entry->mcsm_unused(),
         });
+        // mcsm10: a resource the stage never reads takes no descriptor (its
+        // binding may be another stage's).
+        if (entry->mcsm_unused()) {
+          continue;
+        }
         descriptor_set_layouts.push_back(impeller::DescriptorSetLayout{
             static_cast<uint32_t>(entry->binding()), type,
             ToShaderStage(backend_shader->stage())});
@@ -368,7 +374,11 @@ static ShaderLibrary::ShaderMap ParseShaderBundle(
                              : static_cast<size_t>(entry->ext_res_1()),
             .binding = static_cast<size_t>(entry->binding()),
             .storage = entry->storage(),
+            .unused = entry->mcsm_unused(),
         });
+        if (entry->mcsm_unused()) {
+          continue;  // mcsm10: as storage buffers.
+        }
         descriptor_set_layouts.push_back(impeller::DescriptorSetLayout{
             static_cast<uint32_t>(entry->binding()),
             entry->storage()
@@ -388,7 +398,11 @@ static ShaderLibrary::ShaderMap ParseShaderBundle(
             .name = entry->name() ? entry->name()->str() : std::string(),
             .ext_res_0 = static_cast<size_t>(entry->ext_res_0()),
             .binding = static_cast<size_t>(entry->binding()),
+            .unused = entry->mcsm_unused(),
         });
+        if (entry->mcsm_unused()) {
+          continue;  // mcsm10: as storage buffers.
+        }
         descriptor_set_layouts.push_back(impeller::DescriptorSetLayout{
             static_cast<uint32_t>(entry->binding()), type,
             ToShaderStage(backend_shader->stage())});
