From 42083b13f06cdbb9d8ba6259358ef71af11e608f Mon Sep 17 00:00:00 2001
From: mcsm <mcsm@localhost>
Date: Mon, 26 Oct 2026 18:58:33 +0100
Subject: [PATCH 2/7] flutter_gpu (mcsm8): on Vulkan a submit disposes the
 thread's command and descriptor pools at most every 16 ms instead of every
 time: each dispose made the next command buffer create new pools (~1-2 ms a
 pass on the RTX; SMAA 2.3 ms vs 0.03 on GLES)

---
 engine/src/flutter/lib/gpu/command_buffer.cc | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/engine/src/flutter/lib/gpu/command_buffer.cc b/engine/src/flutter/lib/gpu/command_buffer.cc
index a1ee6dae4d9..f4bcd41fd92 100644
--- a/engine/src/flutter/lib/gpu/command_buffer.cc
+++ b/engine/src/flutter/lib/gpu/command_buffer.cc
@@ -4,6 +4,8 @@
 
 #include "flutter/lib/gpu/command_buffer.h"
 
+#include <chrono>
+
 #include "dart_api.h"
 #include "fml/make_copyable.h"
 #include "impeller/core/buffer_view.h"
@@ -210,7 +212,22 @@ bool CommandBuffer::Submit(
 
   auto status = context_->GetCommandQueue()->Submit(
       {command_buffer_}, combined_completion_callback);
-  context_->DisposeThreadLocalCachedResources();
+  // mcsm8: on Vulkan, disposing drops this thread's command and descriptor
+  // pools, so the next command buffer makes new ones (~1-2 ms each on the
+  // RTX: a frame of the look submits dozens). Dispose at most every 16 ms
+  // (about once a frame) there; the pools are recycled as before.
+  bool dispose = true;
+  if (context_->GetBackendType() == impeller::Context::BackendType::kVulkan) {
+    thread_local auto last_dispose = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    dispose = now - last_dispose >= std::chrono::milliseconds(16);
+    if (dispose) {
+      last_dispose = now;
+    }
+  }
+  if (dispose) {
+    context_->DisposeThreadLocalCachedResources();
+  }
   if (!status.ok() && combined_completion_callback) {
     combined_completion_callback(impeller::CommandBuffer::Status::kError);
   }
