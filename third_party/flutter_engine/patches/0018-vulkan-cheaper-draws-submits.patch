@@ -201,6 +220,30 @@ bool FenceWaiterVK::Wait() {
         wait_set_.end());
   }
 
+  // mcsm8: signalled fences are reset and reused (vkCreateFence costs
+  // ~300 us on NVIDIA's Linux driver, once per submit).
+  {
+    std::vector<vk::Fence> to_reset;
+    std::vector<vk::UniqueFence> taken;
+    for (auto& entry : erased_entries) {
+      auto fence = entry->TakeFence();
+      if (fence) {
+        to_reset.push_back(fence.get());
+        taken.push_back(std::move(fence));
+      }
+    }
+    if (!to_reset.empty() &&
+        device.resetFences(to_reset.size(), to_reset.data()) ==
+            vk::Result::eSuccess) {
+      std::scoped_lock lock(mcsm_free_fences_mutex_);
+      for (auto& fence : taken) {
+        if (mcsm_free_fences_.size() < 64) {
+          mcsm_free_fences_.push_back(std::move(fence));
+        }
+      }
+    }
+  }
