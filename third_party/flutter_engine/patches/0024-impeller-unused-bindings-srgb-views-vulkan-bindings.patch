+  if (index == kMcsmUnusedIndex) {
+    return;
+  }
   auto found = buffers_.find(index);
   if (found != buffers_.end() && found->second.buffer == buffer) {
     // The right buffer is bound. Check if its offset needs to be updated.
@@ -48,6 +59,9 @@
 
