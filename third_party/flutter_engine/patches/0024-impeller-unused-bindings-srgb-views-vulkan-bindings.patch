@@ -302,6 +302,14 @@ class AllocatedTextureSourceVK final : public TextureSourceVK {
         image_info_chain;
     auto& image_info = image_info_chain.get();
     image_info.flags = ToVKImageCreateFlags(desc.type);
+    // mcsm10: 8-bit colour render targets may be viewed as their sRGB twin
+    // (S2 draws and samples several targets through sRGB views). Only render
+    // targets: sampled textures upload in their final format, and a mutable
+    // format can cost a driver its compression.
+    if (McsmSRGBTwin(desc.format) != PixelFormat::kUnknown &&
+        (desc.usage & TextureUsage::kRenderTarget)) {
+      image_info.flags |= vk::ImageCreateFlagBits::eMutableFormat;
+    }
     // mcsm: 3D textures and arrays.
     image_info.imageType = desc.type == TextureType::kTexture3D
                                ? vk::ImageType::e3D
