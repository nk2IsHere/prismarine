   }
 }
 
+/// mcsm10: the format an 8-bit RGBA/BGRA texture's view may take besides its
+/// own (UNORM <-> sRGB; the same bits, encoded or not on read and write).
+constexpr PixelFormat McsmSRGBTwin(PixelFormat format) {
+  switch (format) {
+    case PixelFormat::kR8G8B8A8UNormInt:
+      return PixelFormat::kR8G8B8A8UNormIntSRGB;
+    case PixelFormat::kR8G8B8A8UNormIntSRGB:
+      return PixelFormat::kR8G8B8A8UNormInt;
+    case PixelFormat::kB8G8R8A8UNormInt:
+      return PixelFormat::kB8G8R8A8UNormIntSRGB;
+    case PixelFormat::kB8G8R8A8UNormIntSRGB:
+      return PixelFormat::kB8G8R8A8UNormInt;
+    default:
+      return PixelFormat::kUnknown;
+  }
+}
+
+/// mcsm10: whether a view of a `parent` texture may have `view`'s format.
+constexpr bool McsmViewFormatAllowed(PixelFormat parent, PixelFormat view) {
+  return view == parent || view == McsmSRGBTwin(parent);
+}
