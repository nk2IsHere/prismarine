+  for (const auto& image : resources.storage_images) {
+    // mcsm: an imageBuffer is a storage texel buffer (its atomic view, where
+    // Metal emulates image atomics, at the secondary index).
+    if (compiler_->get_type(image.type_id).image.dim == spv::DimBuffer) {
+      ShaderBundleData::ShaderTexelBuffer buffer;
