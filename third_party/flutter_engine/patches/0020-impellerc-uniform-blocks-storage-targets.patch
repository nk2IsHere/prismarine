@@ -608,6 +608,50 @@ std::shared_ptr<ShaderBundleData> Reflector::GenerateShaderBundleData() const {
     data->AddUniformTexture(uniform_texture);
   }
 
+  // mcsm: storage buffers and images, and a compute shader's workgroup size.
+  const auto resources = compiler_->get_shader_resources();
+  for (const auto& buffer : resources.storage_buffers) {
+    ShaderBundleData::ShaderStorageResource storage;
+    storage.name = buffer.name;
+    storage.ext_res_0 = compiler_.GetExtendedMSLResourceBinding(
+        CompilerBackend::ExtendedResourceIndex::kPrimary, buffer.id);
+    storage.set = compiler_->get_decoration(
+        buffer.id, spv::Decoration::DecorationDescriptorSet);
+    storage.binding = compiler_->get_decoration(
+        buffer.id, spv::Decoration::DecorationBinding);
+    storage.read_only = compiler_->get_buffer_block_flags(buffer.id).get(
+        spv::Decoration::DecorationNonWritable);
+    data->AddStorageBuffer(std::move(storage));
+  }
+  for (const auto& image : resources.storage_images) {
+    ShaderBundleData::ShaderStorageResource storage;
+    storage.name = image.name;
+    storage.ext_res_0 = compiler_.GetExtendedMSLResourceBinding(
+        CompilerBackend::ExtendedResourceIndex::kPrimary, image.id);
+    storage.set = compiler_->get_decoration(
+        image.id, spv::Decoration::DecorationDescriptorSet);
+    storage.binding =
+        compiler_->get_decoration(image.id, spv::Decoration::DecorationBinding);
+    storage.read_only = compiler_->has_decoration(
+        image.id, spv::Decoration::DecorationNonWritable);
+    data->AddStorageImage(std::move(storage));
+  }
+  if (entrypoints.front().execution_model ==
+      spv::ExecutionModel::ExecutionModelGLCompute) {
+    spirv_cross::SpecializationConstant spec_x, spec_y, spec_z;
+    compiler_->get_work_group_size_specialization_constants(spec_x, spec_y,
+                                                            spec_z);
+    const auto local_size = [&](spirv_cross::SpecializationConstant& spec,
+                                uint32_t index) -> uint32_t {
+      return spec.id != 0 ? 0u
+                          : compiler_->get_execution_mode_argument(
+                                spv::ExecutionMode::ExecutionModeLocalSize,
+                                index);
+    };
+    data->SetWorkgroupSize(local_size(spec_x, 0u), local_size(spec_y, 1u),
+                           local_size(spec_z, 2u));
+  }
+
   // We only need to worry about storing vertex attributes.
   if (entrypoints.front().execution_model == spv::ExecutionModelVertex) {
     const auto inputs = compiler_->get_shader_resources().stage_inputs;
