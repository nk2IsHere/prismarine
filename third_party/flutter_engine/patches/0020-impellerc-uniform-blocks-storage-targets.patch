+    ShaderBundleData::ShaderUniformTexture texture;
+    texture.name = resource.name;
+    texture.ext_res_0 = compiler_.GetExtendedMSLResourceBinding(
+        CompilerBackend::ExtendedResourceIndex::kPrimary, resource.id);
+    texture.set = compiler_->get_decoration(
