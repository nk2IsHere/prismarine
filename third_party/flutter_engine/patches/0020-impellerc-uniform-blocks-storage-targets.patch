From 3391e04d669bf22ff6f6c032064a7916e1ee3b0c Mon Sep 17 00:00:00 2001
From: mcsm <mcsm@localhost>
Date: Tue, 3 Nov 2026 11:58:53 +0100
Subject: [PATCH 2/4] impellerc (mcsm9): Metal and Vulkan shaders limit each
 uniform block to 16 KB (Vulkan's minimum maxUniformBufferRange) instead of
 all blocks together to 6,208 bytes, a GLES budget (S2's light data block is
 12,288); shader bundles record storage buffers, storage images (with
 read-only flags) and a compute shader's workgroup size; a bundle entry may
 name its backends ("targets"), so Metal- and Vulkan-only shaders leave out GL

---
 .../src/flutter/impeller/compiler/compiler.cc | 49 +++++++++-
 .../flutter/impeller/compiler/reflector.cc    | 44 +++++++++
 .../impeller/compiler/shader_bundle.cc        | 91 ++++++++++++++-----
 .../impeller/compiler/shader_bundle_data.cc   | 33 +++++++
 .../impeller/compiler/shader_bundle_data.h    | 17 ++++
 engine/src/flutter/impeller/compiler/types.h  |  6 ++
 .../impeller/shader_bundle/shader_bundle.fbs  | 24 +++++
 7 files changed, 234 insertions(+), 30 deletions(-)

diff --git a/engine/src/flutter/impeller/compiler/compiler.cc b/engine/src/flutter/impeller/compiler/compiler.cc
index 939ce618ff7..8ed1e459ee3 100644
--- a/engine/src/flutter/impeller/compiler/compiler.cc
+++ b/engine/src/flutter/impeller/compiler/compiler.cc
@@ -4,6 +4,7 @@
 
 #include "impeller/compiler/compiler.h"
 
+#include <algorithm>
 #include <cstdint>
 #include <filesystem>
 #include <memory>
@@ -102,6 +103,12 @@ std::string InjectYFlipForGLESVertexShader(std::string source) {
 // https://docs.qualcomm.com/bundle/publicresource/topics/80-78185-2/best_practices.html?product=1601111740035277#buffer-best-practices
 static const uint32_t kMaxUniformBufferSize = 6208;
 
+// mcsm: one uniform block on Metal and Vulkan: 64 KB, Direct3D 11's
+// constant buffer size (4,096 vec4s), so a translated shader's blocks always
+// fit. Desktop Vulkan drivers take 64 KB or more (maxUniformBufferRange; the
+// spec's minimum is 16 KB).
+static const uint32_t kMaxUniformBlockSizeMetalVulkan = 65536;
+
 static uint32_t ParseMSLVersion(const std::string& msl_version) {
   std::stringstream sstream(msl_version);
   std::string version_part;
@@ -341,6 +348,19 @@ static CompilerBackend CreateCompiler(const spirv_cross::ParsedIR& ir,
 }
 
 namespace {
+// mcsm: the largest single uniform block of a shader.
+uint32_t CalculateLargestUBOSize(const spirv_cross::Compiler* compiler) {
+  spirv_cross::ShaderResources resources = compiler->get_shader_resources();
+  uint32_t result = 0;
+  for (const spirv_cross::Resource& ubo : resources.uniform_buffers) {
+    const spirv_cross::SPIRType& ubo_type =
+        compiler->get_type(ubo.base_type_id);
+    result = std::max<uint32_t>(result,
+                                compiler->get_declared_struct_size(ubo_type));
+  }
+  return result;
+}
+
 uint32_t CalculateUBOSize(const spirv_cross::Compiler* compiler) {
   spirv_cross::ShaderResources resources = compiler->get_shader_resources();
   uint32_t result = 0;
@@ -564,11 +584,30 @@ Compiler::Compiler(const std::shared_ptr<const fml::Mapping>& source_mapping,
   CanonicalizeUniformBlockInstanceNamesForGL(source_options.target_platform,
                                              sl_compiler.GetCompiler());
 
-  uint32_t ubo_size = CalculateUBOSize(sl_compiler.GetCompiler());
-  if (ubo_size > kMaxUniformBufferSize) {
-    COMPILER_ERROR(error_stream_) << "Uniform buffer size exceeds max ("
-                                  << kMaxUniformBufferSize << "): " << ubo_size;
-    return;
+  // mcsm: Metal and Vulkan shaders (not runtime stages) bind each uniform
+  // block as its own buffer, so only a single block's size is limited; the
+  // total budget is a GLES one.
+  // Minecraft: Story Mode S2's light data block alone is 12,288 bytes.
+  const bool per_block_limit =
+      source_options.target_platform == TargetPlatform::kMetalDesktop ||
+      source_options.target_platform == TargetPlatform::kMetalIOS ||
+      source_options.target_platform == TargetPlatform::kVulkan;
+  if (per_block_limit) {
+    uint32_t block_size = CalculateLargestUBOSize(sl_compiler.GetCompiler());
+    if (block_size > kMaxUniformBlockSizeMetalVulkan) {
+      COMPILER_ERROR(error_stream_)
+          << "Uniform block size exceeds max ("
+          << kMaxUniformBlockSizeMetalVulkan << "): " << block_size;
+      return;
+    }
+  } else {
+    uint32_t ubo_size = CalculateUBOSize(sl_compiler.GetCompiler());
+    if (ubo_size > kMaxUniformBufferSize) {
+      COMPILER_ERROR(error_stream_)
+          << "Uniform buffer size exceeds max (" << kMaxUniformBufferSize
+          << "): " << ubo_size;
+      return;
+    }
   }
 
   // We need to invoke the compiler even if we don't use the SL mapping later
diff --git a/engine/src/flutter/impeller/compiler/reflector.cc b/engine/src/flutter/impeller/compiler/reflector.cc
