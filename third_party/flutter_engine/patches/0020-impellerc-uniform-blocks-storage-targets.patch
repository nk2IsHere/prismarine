+      buffer.ext_res_1 = compiler_.GetExtendedMSLResourceBinding(
+          CompilerBackend::ExtendedResourceIndex::kSecondary, image.id);
+      buffer.set = compiler_->get_decoration(
+          image.id, spv::Decoration::DecorationDescriptorSet);
+      buffer.binding = compiler_->get_decoration(
+          image.id, spv::Decoration::DecorationBinding);
+      buffer.storage = true;
+      data->AddTexelBuffer(std::move(buffer));
+      continue;
+    }
+    ShaderBundleData::ShaderStorageResource storage;
+    storage.name = image.name;
+    storage.ext_res_0 = compiler_.GetExtendedMSLResourceBinding(
+        CompilerBackend::ExtendedResourceIndex::kPrimary, image.id);
+    storage.set = compiler_->get_decoration(
+        image.id, spv::Decoration::DecorationDescriptorSet);
+    storage.binding =
+        compiler_->get_decoration(image.id, spv::Decoration::DecorationBinding);
+    storage.read_only = compiler_->has_decoration(
+        image.id, spv::Decoration::DecorationNonWritable);
+    data->AddStorageImage(std::move(storage));
