+      buffer.name = image.name;
+      buffer.ext_res_0 = compiler_.GetExtendedMSLResourceBinding(
+          CompilerBackend::ExtendedResourceIndex::kPrimary, image.id);
+      buffer.set = compiler_->get_decoration(
+          image.id, spv::Decoration::DecorationDescriptorSet);
+      buffer.binding = compiler_->get_decoration(
+          image.id, spv::Decoration::DecorationBinding);
+      data->AddTexelBuffer(std::move(buffer));
+    } else {
+      add_separate(image, false);
+    }
+  }
+  for (const auto& sampler : resources.separate_samplers) {
+    add_separate(sampler, true);
+  }
+  data->SetMetalOptions(options_.mcsm_metal_options);
+
+  if (entrypoints.front().execution_model ==
+      spv::ExecutionModel::ExecutionModelGLCompute) {
+    spirv_cross::SpecializationConstant spec_x, spec_y, spec_z;
+    compiler_->get_work_group_size_specialization_constants(spec_x, spec_y,
