-  // mcsm12: 16384 = McsmOldSpace and McsmHeap (every backend).
+  // mcsm12: 16384 = PrismarineOldSpace and PrismarineHeap (every backend).
   const int64_t common = 1 | 2 | 4 | 8 | 512 | 8192 | 16384;
   switch (backend) {
     case 0:
@@ -301,11 +301,11 @@ extern int64_t InternalFlutterGpu_McsmFeatures() {
