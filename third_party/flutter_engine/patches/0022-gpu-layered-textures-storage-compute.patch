+    std::shared_ptr<const impeller::DeviceBuffer> buffer,
+    size_t offset,
+    size_t length) {
+  const Shader::StorageBinding* binding = shader.McsmGetStorageBuffer(index);
+  const impeller::ShaderStage stage = shader.GetShaderStage();
+  if (!binding || !buffer ||
+      (stage != impeller::ShaderStage::kVertex &&
+       stage != impeller::ShaderStage::kFragment) ||
+      offset + length > buffer->GetDeviceBufferDescriptor().size) {
+    return false;
+  }
+  impeller::ShaderUniformSlot slot{
+      .name = binding->name.c_str(),
+      .ext_res_0 = binding->ext_res_0,
+      .set = binding->set,
+      .binding = binding->binding,
+  };
+  impeller::BufferView view(std::move(buffer), impeller::Range(offset, length));
+  for (auto& entry : mcsm_storage_bindings_) {
+    if (entry.stage == stage && entry.slot.binding == slot.binding &&
+        entry.slot.ext_res_0 == slot.ext_res_0) {
+      entry.slot = slot;
+      entry.view = std::move(view);
+      return true;
+    }
+  }
+  mcsm_storage_bindings_.push_back({stage, slot, std::move(view)});
+  return true;
