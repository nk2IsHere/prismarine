+namespace {
+// mcsm9: whether a region of a mip level and slice lies in the texture.
+bool McsmRegionFits(const impeller::Texture& texture,
+                    impeller::IRect region,
+                    uint32_t mip,
+                    uint32_t slice) {
+  const impeller::TextureDescriptor& desc = texture.GetTextureDescriptor();
+  if (mip >= desc.mip_count) {
+    return false;
+  }
+  const int64_t w = std::max<int64_t>(1, desc.size.width >> mip);
+  const int64_t h = std::max<int64_t>(1, desc.size.height >> mip);
+  const size_t slices =
+      desc.type == impeller::TextureType::kTexture3D
+          ? std::max<size_t>(1, desc.depth >> mip)
+          : desc.GetSliceCount();
+  return slice < slices && region.GetX() >= 0 && region.GetY() >= 0 &&
+         region.GetWidth() > 0 && region.GetHeight() > 0 &&
+         region.GetRight() <= w && region.GetBottom() <= h;
+}
+
+bool McsmCopiesSupported(const impeller::Context& context) {
+  return context.GetBackendType() == impeller::Context::BackendType::kMetal ||
+         context.GetBackendType() == impeller::Context::BackendType::kVulkan;
+}
+}  // namespace
+
+bool CommandBuffer::McsmCopyTextureToTexture(
+    Texture& source,
+    Texture& destination,
+    impeller::IRect source_region,
+    impeller::IPoint destination_origin,
+    uint32_t source_mip,
+    uint32_t source_slice,
+    uint32_t destination_mip,
+    uint32_t destination_slice) {
+  const auto src = source.GetTexture();
+  const auto dst = destination.GetTexture();
+  const auto dst_region = impeller::IRect::MakeXYWH(
+      destination_origin.x, destination_origin.y, source_region.GetWidth(),
+      source_region.GetHeight());
+  if (!McsmCopiesSupported(*context_) || source.McsmIsView() ||
+      destination.McsmIsView() ||
+      src->GetTextureDescriptor().format != dst->GetTextureDescriptor().format ||
+      !McsmRegionFits(*src, source_region, source_mip, source_slice) ||
+      !McsmRegionFits(*dst, dst_region, destination_mip, destination_slice)) {
+    return false;
+  }
+  auto blit_pass = GetOrCreateBlitPass();
+  return blit_pass &&
+         blit_pass->McsmCopyTextureToTexture(
+             src, dst, source_region, destination_origin, source_mip,
+             source_slice, destination_mip, destination_slice);
+}
+
+bool CommandBuffer::McsmCopyTextureToBuffer(Texture& source,
+                                            impeller::IRect source_region,
+                                            uint32_t source_mip,
+                                            uint32_t source_slice,
+                                            DeviceBuffer& destination,
+                                            size_t destination_offset) {
+  const auto src = source.GetTexture();
+  const size_t bytes = impeller::BytesForTextureRegion(
+      src->GetTextureDescriptor().format, source_region.GetWidth(),
+      source_region.GetHeight());
+  if (!McsmCopiesSupported(*context_) || source.McsmIsView() ||
+      !McsmRegionFits(*src, source_region, source_mip, source_slice) ||
+      destination_offset + bytes >
+          destination.GetBuffer()->GetDeviceBufferDescriptor().size) {
+    return false;
+  }
+  auto blit_pass = GetOrCreateBlitPass();
+  return blit_pass && blit_pass->McsmCopyTextureToBuffer(
+                          src, destination.GetBuffer(), source_region,
+                          destination_offset, source_mip, source_slice);
+}
+
+bool CommandBuffer::McsmGenerateMipmap(Texture& texture) {
+  if (!McsmCopiesSupported(*context_) || texture.McsmIsView() ||
+      texture.GetTexture()->GetTextureDescriptor().type ==
+          impeller::TextureType::kTexture3D) {
+    return false;
+  }
+  auto blit_pass = GetOrCreateBlitPass();
+  return blit_pass && blit_pass->GenerateMipmap(texture.GetTexture(),
+                                                "CommandBuffer.mcsmMipmap");
+}
