+namespace flutter {
+namespace gpu {
+
+/// mcsm9: a compute pipeline made from a compute shader of a shader bundle
+/// (Metal and Vulkan).
+class ComputePipeline : public RefCountedDartWrappable<ComputePipeline> {
+  DEFINE_WRAPPERTYPEINFO();
+  FML_FRIEND_MAKE_REF_COUNTED(ComputePipeline);
+
+ public:
+  using ImpellerPipeline =
+      impeller::Pipeline<impeller::ComputePipelineDescriptor>;
+
+  ComputePipeline(fml::RefPtr<Shader> shader,
+                  std::shared_ptr<ImpellerPipeline> pipeline);
+
+  ~ComputePipeline() override;
+
+  const fml::RefPtr<Shader>& GetShader() const { return shader_; }
+
+  const std::shared_ptr<ImpellerPipeline>& GetPipeline() const {
+    return pipeline_;
+  }
+
+ private:
+  fml::RefPtr<Shader> shader_;
+  std::shared_ptr<ImpellerPipeline> pipeline_;
+
+  FML_DISALLOW_COPY_AND_ASSIGN(ComputePipeline);
+};
+
+/// mcsm9: a compute pass on a command buffer: a pipeline, its uniform and
+/// storage buffers, sampled textures and storage images, then dispatches of
+/// workgroups. Bindings hold until the next dispatch.
+class ComputePass : public RefCountedDartWrappable<ComputePass> {
+  DEFINE_WRAPPERTYPEINFO();
+  FML_FRIEND_MAKE_REF_COUNTED(ComputePass);
+
+ public:
+  ComputePass();
+
+  ~ComputePass() override;
+
+  bool Begin(CommandBuffer& command_buffer);
+
+  bool SetPipeline(fml::RefPtr<ComputePipeline> pipeline);
+
+  bool BindUniform(int index,
+                   std::shared_ptr<const impeller::DeviceBuffer> buffer,
+                   size_t offset,
+                   size_t length);
+
+  bool BindStorageBuffer(int index,
+                         std::shared_ptr<const impeller::DeviceBuffer> buffer,
+                         size_t offset,
+                         size_t length);
+
+  bool BindTexture(int index,
+                   std::shared_ptr<const impeller::Texture> texture,
+                   const impeller::SamplerDescriptor& sampler);
+
+  bool BindStorageImage(int index,
+                        std::shared_ptr<const impeller::Texture> texture);
+
+  bool Dispatch(uint32_t x, uint32_t y, uint32_t z);
+
+  /// Workgroup counts from `args` (three uint32s).
+  bool DispatchIndirect(std::shared_ptr<const impeller::DeviceBuffer> args,
+                        size_t offset);
+
+  /// Orders this pass's earlier dispatches' writes before its later ones'
+  /// reads (buffers and images).
+  void Barrier();
+
+ private:
+  std::shared_ptr<const impeller::Context> context_;
+  std::shared_ptr<impeller::ComputePass> pass_;
+  std::shared_ptr<bool> ended_;
+  fml::RefPtr<ComputePipeline> pipeline_;
+
+  FML_DISALLOW_COPY_AND_ASSIGN(ComputePass);
+};
+
