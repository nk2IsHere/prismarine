+// mcsm9: texel buffers, textures and samplers bound apart.
+bool InternalFlutterGpu_RenderPass_McsmBindTexelBuffer(
+    flutter::gpu::RenderPass* wrapper,
+    flutter::gpu::Shader* shader,
+    int index,
+    flutter::gpu::DeviceBuffer* buffer,
+    int offset_in_bytes,
+    int length_in_bytes,
