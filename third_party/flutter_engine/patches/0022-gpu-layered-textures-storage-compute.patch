+namespace flutter {
+namespace gpu {
+
+IMPLEMENT_WRAPPERTYPEINFO(flutter_gpu, ComputePipeline);
+IMPLEMENT_WRAPPERTYPEINFO(flutter_gpu, ComputePass);
+
+ComputePipeline::ComputePipeline(fml::RefPtr<Shader> shader,
+                                 std::shared_ptr<ImpellerPipeline> pipeline)
+    : shader_(std::move(shader)), pipeline_(std::move(pipeline)) {}
+
+ComputePipeline::~ComputePipeline() = default;
+
+ComputePass::ComputePass() = default;
+
+ComputePass::~ComputePass() = default;
+
+bool ComputePass::Begin(CommandBuffer& command_buffer) {
+  // The command buffer's open render or blit encoder ends first (Metal
+  // allows one open encoder per command buffer).
+  command_buffer.McsmEndOpenEncoder();
+  pass_ = command_buffer.GetCommandBuffer()->CreateComputePass();
+  if (!pass_ || !pass_->IsValid()) {
+    pass_ = nullptr;
+    return false;
+  }
+  context_ = command_buffer.McsmGetContext();
+  ended_ = std::make_shared<bool>(false);
+  command_buffer.AddComputePass(pass_, ended_);
+  return true;
+}
+
+bool ComputePass::SetPipeline(fml::RefPtr<ComputePipeline> pipeline) {
+  if (!pass_ || *ended_ || !pipeline || !pipeline->GetPipeline()) {
+    return false;
+  }
+  pipeline_ = std::move(pipeline);
+  pass_->SetPipeline(pipeline_->GetPipeline());
+  return true;
+}
+
+static impeller::ShaderUniformSlot McsmSlot(
+    const Shader::StorageBinding& binding) {
+  return impeller::ShaderUniformSlot{
+      .name = binding.name.c_str(),
+      .ext_res_0 = binding.ext_res_0,
+      .set = binding.set,
+      .binding = binding.binding,
+  };
+}
+
+bool ComputePass::BindUniform(
+    int index,
+    std::shared_ptr<const impeller::DeviceBuffer> buffer,
+    size_t offset,
+    size_t length) {
+  if (!pass_ || *ended_ || !pipeline_ || !buffer ||
+      offset + length > buffer->GetDeviceBufferDescriptor().size) {
+    return false;
+  }
+  const Shader::UniformBinding* uniform =
+      pipeline_->GetShader()->GetResolvedUniformStruct(index);
+  if (!uniform) {
+    return false;
+  }
+  return pass_->BindResource(
+      impeller::ShaderStage::kCompute, impeller::DescriptorType::kUniformBuffer,
+      uniform->slot, &uniform->metadata,
+      impeller::BufferView(std::move(buffer), impeller::Range(offset, length)));
+}
+
+bool ComputePass::BindStorageBuffer(
+    int index,
+    std::shared_ptr<const impeller::DeviceBuffer> buffer,
+    size_t offset,
+    size_t length) {
+  if (!pass_ || *ended_ || !pipeline_ || !buffer ||
+      offset + length > buffer->GetDeviceBufferDescriptor().size) {
+    return false;
+  }
+  const Shader::StorageBinding* binding =
+      pipeline_->GetShader()->McsmGetStorageBuffer(index);
+  if (!binding) {
+    return false;
+  }
+  static const impeller::ShaderMetadata kNoMetadata;
+  return pass_->BindResource(
+      impeller::ShaderStage::kCompute, impeller::DescriptorType::kStorageBuffer,
+      McsmSlot(*binding), &kNoMetadata,
+      impeller::BufferView(std::move(buffer), impeller::Range(offset, length)));
+}
+
+bool ComputePass::BindTexture(int index,
+                              std::shared_ptr<const impeller::Texture> texture,
+                              const impeller::SamplerDescriptor& sampler) {
+  if (!pass_ || *ended_ || !pipeline_ || !texture) {
+    return false;
+  }
+  const Shader::TextureBinding* binding =
+      pipeline_->GetShader()->GetResolvedUniformTexture(index);
+  if (!binding) {
+    return false;
+  }
+  return pass_->BindResource(
+      impeller::ShaderStage::kCompute, impeller::DescriptorType::kSampledImage,
+      binding->slot, &binding->metadata, std::move(texture),
+      context_->GetSamplerLibrary()->GetSampler(sampler));
+}
+
+bool ComputePass::BindStorageImage(
+    int index,
+    std::shared_ptr<const impeller::Texture> texture) {
+  if (!pass_ || *ended_ || !pipeline_ || !texture ||
+      !(texture->GetTextureDescriptor().usage &
+        impeller::TextureUsage::kShaderWrite)) {
+    return false;
+  }
+  const Shader::StorageBinding* binding =
+      pipeline_->GetShader()->McsmGetStorageImage(index);
+  if (!binding) {
+    return false;
+  }
+  static const impeller::ShaderMetadata kNoMetadata;
+  const impeller::SampledImageSlot slot{
+      .name = binding->name.c_str(),
+      .texture_index = binding->ext_res_0,
+      .set = binding->set,
+      .binding = binding->binding,
+  };
+  return pass_->BindResource(impeller::ShaderStage::kCompute,
+                             impeller::DescriptorType::kStorageImage, slot,
+                             &kNoMetadata, std::move(texture),
+                             impeller::raw_ptr<const impeller::Sampler>());
+}
+
+bool ComputePass::BindTexelBuffer(
+    int index,
+    std::shared_ptr<const impeller::DeviceBuffer> buffer,
+    size_t offset,
+    size_t length,
+    impeller::PixelFormat format) {
+  if (!pass_ || *ended_ || !pipeline_ || !buffer ||
+      offset + length > buffer->GetDeviceBufferDescriptor().size) {
+    return false;
+  }
+  const Shader::McsmBinding* slot = pipeline_->GetShader()->McsmGet(2, index);
+  if (!slot) {
+    return false;
+  }
+  return pass_->McsmBindTexelBuffer(
+      impeller::ShaderStage::kCompute,
+      {.metal_texture = slot->ext_res_0,
+       .metal_atomic_buffer = slot->ext_res_1,
+       .binding = slot->binding,
+       .storage = slot->storage},
+      impeller::BufferView(std::move(buffer), impeller::Range(offset, length)),
+      format);
+}
+
+bool ComputePass::BindSeparateTexture(
+    int index,
+    std::shared_ptr<const impeller::Texture> texture) {
+  if (!pass_ || *ended_ || !pipeline_ || !texture) {
+    return false;
+  }
+  const Shader::McsmBinding* slot = pipeline_->GetShader()->McsmGet(3, index);
+  return slot && pass_->McsmBindSeparateTexture(impeller::ShaderStage::kCompute,
+                                                slot->ext_res_0, slot->binding,
+                                                std::move(texture));
+}
+
+bool ComputePass::BindSeparateSampler(
+    int index,
+    const impeller::SamplerDescriptor& sampler) {
+  if (!pass_ || *ended_ || !pipeline_) {
+    return false;
+  }
+  const Shader::McsmBinding* slot = pipeline_->GetShader()->McsmGet(4, index);
+  return slot && pass_->McsmBindSeparateSampler(
+                     impeller::ShaderStage::kCompute, slot->ext_res_0,
+                     slot->binding,
+                     context_->GetSamplerLibrary()->GetSampler(sampler));
+}
+
+bool ComputePass::Dispatch(uint32_t x, uint32_t y, uint32_t z) {
+  if (!pass_ || *ended_ || !pipeline_) {
+    return false;
+  }
+  // Impeller drops a pipeline's bindings after each dispatch (Vulkan) and
+  // needs it set again before the next.
+  const bool ok = pass_->Compute({x, y, z}).ok();
+  pass_->SetPipeline(pipeline_->GetPipeline());
+  return ok;
+}
+
+bool ComputePass::DispatchIndirect(
+    std::shared_ptr<const impeller::DeviceBuffer> args,
+    size_t offset) {
+  if (!pass_ || *ended_ || !pipeline_ || !args || offset % 4 != 0 ||
+      offset + 12u > args->GetDeviceBufferDescriptor().size) {
+    return false;
+  }
+  pass_->McsmSetIndirect(
+      impeller::BufferView(std::move(args), impeller::Range(offset, 12u)));
+  return Dispatch(1u, 1u, 1u);
+}
+
+void ComputePass::Barrier() {
+  if (!pass_ || *ended_) {
+    return;
+  }
+  pass_->AddBufferMemoryBarrier();
+  pass_->AddTextureMemoryBarrier();
+}
+
