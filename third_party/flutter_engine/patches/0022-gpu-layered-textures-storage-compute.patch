+    int mip_count,
+    int base_layer,
+    int layers) {
+  if (!parent || base_mip < 0 || mip_count < 1 || base_layer < 0 ||
+      layers < 1) {
+    return false;
+  }
+  const auto parent_texture = parent->GetTexture();
+  const impeller::TextureDescriptor& parent_desc =
+      parent_texture->GetTextureDescriptor();
+  impeller::TextureDescriptor desc = parent_desc;
+  desc.type = static_cast<impeller::TextureType>(texture_type);
+  desc.size = {std::max<int64_t>(1, parent_desc.size.width >> base_mip),
+               std::max<int64_t>(1, parent_desc.size.height >> base_mip)};
+  desc.mip_count = static_cast<size_t>(mip_count);
+  desc.array_layer_count =
+      desc.type == impeller::TextureType::kTexture2DArray
+          ? static_cast<size_t>(layers)
+          : 1u;
+  desc.depth = 1u;
+  if ((desc.type == impeller::TextureType::kTextureCube && layers != 6) ||
+      ((desc.type == impeller::TextureType::kTexture2D ||
+        desc.type == impeller::TextureType::kTexture2DMultisample) &&
+       layers != 1)) {
+    return false;
+  }
+  auto view = gpu_context->GetContext().McsmMakeTextureView(
+      parent_texture, desc, static_cast<uint32_t>(base_mip),
+      static_cast<uint32_t>(base_layer));
+  if (!view) {
+    return false;
+  }
