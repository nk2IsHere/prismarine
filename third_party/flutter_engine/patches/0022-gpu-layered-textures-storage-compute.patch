+/// mcsm9: a whole sampler state from Dart's `McsmSampler`: bits 0-3 the min
+/// filter, 4-7 mag, 8-11 mip, 12-15, 16-19 and 20-23 the width, height and
+/// depth address modes, 24-31 the anisotropy, 32-35 the compare function
+/// plus one (0: no comparison), 36-39 the border colour; LOD clamps and
+/// bias apart.
+inline impeller::SamplerDescriptor McsmSamplerFromPacked(int64_t packed,
+                                                        double min_lod,
+                                                        double max_lod,
+                                                        double lod_bias) {
+  const auto field = [packed](int shift, int bits) {
+    return static_cast<int>((packed >> shift) & ((1 << bits) - 1));
+  };
+  impeller::SamplerDescriptor desc;
+  desc.min_filter = ToImpellerMinMagFilter(field(0, 4));
+  desc.mag_filter = ToImpellerMinMagFilter(field(4, 4));
+  desc.mip_filter = ToImpellerMipFilter(field(8, 4));
+  desc.width_address_mode = ToImpellerSamplerAddressMode(field(12, 4));
+  desc.height_address_mode = ToImpellerSamplerAddressMode(field(16, 4));
+  desc.depth_address_mode = ToImpellerSamplerAddressMode(field(20, 4));
+  desc.max_anisotropy = static_cast<uint8_t>(std::max(1, field(24, 8)));
+  if (field(32, 4) > 0) {
+    desc.mcsm_compare = ToImpellerCompareFunction(field(32, 4) - 1);
+  }
+  desc.mcsm_border_color = static_cast<impeller::McsmBorderColor>(
+      std::min(2, field(36, 4)));
+  desc.mcsm_min_lod = static_cast<float>(min_lod);
+  desc.mcsm_max_lod = static_cast<float>(max_lod);
+  desc.mcsm_lod_bias = static_cast<float>(lod_bias);
+  return desc;
+}
