+
+Dart_Handle InternalFlutterGpu_ComputePipeline_McsmInitialize(
+    Dart_Handle wrapper,
+    flutter::gpu::Context* gpu_context,
+    flutter::gpu::Shader* shader) {
+  impeller::Context& context = gpu_context->GetContext();
+  if (context.GetBackendType() == impeller::Context::BackendType::kOpenGLES) {
+    return tonic::ToDart("Compute pipelines need Metal or Vulkan.");
+  }
+  if (!shader || shader->GetShaderStage() != impeller::ShaderStage::kCompute) {
+    return tonic::ToDart("The shader is not a compute shader.");
+  }
+  if (!shader->RegisterSync(*gpu_context)) {
+    return tonic::ToDart("Failed to register the compute shader.");
+  }
+  impeller::ComputePipelineDescriptor desc;
+  desc.SetLabel("mcsm compute");
+  desc.SetStageEntrypoint(
+      shader->GetFunctionFromLibrary(*context.GetShaderLibrary()));
+  desc.SetWorkgroupSize(shader->McsmGetWorkgroupSize());
+  const auto& layouts = shader->GetDescriptorSetLayouts();
+  desc.RegisterDescriptorSetLayouts(layouts.data(), layouts.size());
+  auto pipeline = context.GetPipelineLibrary()->GetPipeline(desc).Get();
+  if (!pipeline || !pipeline->IsValid()) {
+    return tonic::ToDart("Failed to create the compute pipeline.");
+  }
+  auto res = fml::MakeRefCounted<flutter::gpu::ComputePipeline>(
+      fml::Ref(shader), std::move(pipeline));
+  res->AssociateWithDartWrapper(wrapper);
+  return Dart_Null();
+}
+
+void InternalFlutterGpu_ComputePass_McsmInitialize(Dart_Handle wrapper) {
+  auto res = fml::MakeRefCounted<flutter::gpu::ComputePass>();
+  res->AssociateWithDartWrapper(wrapper);
+}
+
+Dart_Handle InternalFlutterGpu_ComputePass_McsmBegin(
+    flutter::gpu::ComputePass* wrapper,
+    flutter::gpu::CommandBuffer* command_buffer) {
+  if (!wrapper->Begin(*command_buffer)) {
+    return tonic::ToDart("Failed to begin the compute pass.");
+  }
+  return Dart_Null();
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindPipeline(
+    flutter::gpu::ComputePass* wrapper,
+    flutter::gpu::ComputePipeline* pipeline) {
+  return wrapper->SetPipeline(fml::Ref(pipeline));
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindUniform(
+    flutter::gpu::ComputePass* wrapper,
+    int index,
+    flutter::gpu::DeviceBuffer* buffer,
+    int offset_in_bytes,
+    int length_in_bytes) {
+  if (!buffer || offset_in_bytes < 0 || length_in_bytes <= 0) {
+    return false;
+  }
+  return wrapper->BindUniform(index, buffer->GetBuffer(),
+                              static_cast<size_t>(offset_in_bytes),
+                              static_cast<size_t>(length_in_bytes));
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindStorageBuffer(
+    flutter::gpu::ComputePass* wrapper,
+    int index,
+    flutter::gpu::DeviceBuffer* buffer,
+    int offset_in_bytes,
+    int length_in_bytes) {
+  if (!buffer || offset_in_bytes < 0 || length_in_bytes <= 0) {
+    return false;
+  }
+  return wrapper->BindStorageBuffer(index, buffer->GetBuffer(),
+                                    static_cast<size_t>(offset_in_bytes),
+                                    static_cast<size_t>(length_in_bytes));
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindTexture(
+    flutter::gpu::ComputePass* wrapper,
+    int index,
+    flutter::gpu::Texture* texture,
+    int min_filter,
+    int mag_filter,
+    int mip_filter,
+    int width_address_mode,
+    int height_address_mode) {
+  if (!texture) {
+    return false;
+  }
+  impeller::SamplerDescriptor sampler;
+  sampler.min_filter = flutter::gpu::ToImpellerMinMagFilter(min_filter);
+  sampler.mag_filter = flutter::gpu::ToImpellerMinMagFilter(mag_filter);
+  sampler.mip_filter = flutter::gpu::ToImpellerMipFilter(mip_filter);
+  sampler.width_address_mode =
+      flutter::gpu::ToImpellerSamplerAddressMode(width_address_mode);
+  sampler.height_address_mode =
+      flutter::gpu::ToImpellerSamplerAddressMode(height_address_mode);
+  return wrapper->BindTexture(index, texture->GetTexture(), sampler);
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindStorageImage(
+    flutter::gpu::ComputePass* wrapper,
+    int index,
+    flutter::gpu::Texture* texture) {
+  if (!texture) {
+    return false;
+  }
+  return wrapper->BindStorageImage(index, texture->GetTexture());
+}
+
+bool InternalFlutterGpu_ComputePass_McsmDispatch(
+    flutter::gpu::ComputePass* wrapper,
+    int x,
+    int y,
+    int z) {
+  if (x <= 0 || y <= 0 || z <= 0) {
+    return false;
+  }
+  return wrapper->Dispatch(static_cast<uint32_t>(x), static_cast<uint32_t>(y),
+                           static_cast<uint32_t>(z));
+}
+
+void InternalFlutterGpu_ComputePass_McsmBarrier(
+    flutter::gpu::ComputePass* wrapper) {
+  wrapper->Barrier();
+}
+
+bool InternalFlutterGpu_ComputePass_McsmDispatchIndirect(
+    flutter::gpu::ComputePass* wrapper,
+    flutter::gpu::DeviceBuffer* args,
+    int offset_in_bytes) {
+  if (!args || offset_in_bytes < 0) {
+    return false;
+  }
+  return wrapper->DispatchIndirect(args->GetBuffer(),
+                                   static_cast<size_t>(offset_in_bytes));
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindTextureSampler(
+    flutter::gpu::ComputePass* wrapper,
+    int index,
+    flutter::gpu::Texture* texture,
+    int64_t packed,
+    double min_lod,
+    double max_lod,
+    double lod_bias) {
+  if (!texture) {
+    return false;
+  }
+  return wrapper->BindTexture(
+      index, texture->GetTexture(),
+      flutter::gpu::McsmSamplerFromPacked(packed, min_lod, max_lod, lod_bias));
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindTexelBuffer(
+    flutter::gpu::ComputePass* wrapper,
+    int index,
+    flutter::gpu::DeviceBuffer* buffer,
+    int offset_in_bytes,
+    int length_in_bytes,
+    int format) {
+  if (!buffer || offset_in_bytes < 0 || length_in_bytes <= 0) {
+    return false;
+  }
+  return wrapper->BindTexelBuffer(index, buffer->GetBuffer(),
+                                  static_cast<size_t>(offset_in_bytes),
+                                  static_cast<size_t>(length_in_bytes),
+                                  flutter::gpu::ToImpellerPixelFormat(format));
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindSeparateTexture(
+    flutter::gpu::ComputePass* wrapper,
+    int index,
+    flutter::gpu::Texture* texture) {
+  return texture && wrapper->BindSeparateTexture(index, texture->GetTexture());
+}
+
+bool InternalFlutterGpu_ComputePass_McsmBindSeparateSampler(
+    flutter::gpu::ComputePass* wrapper,
+    int index,
+    int64_t packed,
+    double min_lod,
+    double max_lod,
+    double lod_bias) {
+  return wrapper->BindSeparateSampler(
+      index,
+      flutter::gpu::McsmSamplerFromPacked(packed, min_lod, max_lod, lod_bias));
+}
