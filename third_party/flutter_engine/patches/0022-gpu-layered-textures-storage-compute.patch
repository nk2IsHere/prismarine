+bool RenderPass::McsmBindStorageBuffer(
+    const Shader& shader,
+    int index,
+    std::shared_ptr<const impeller::DeviceBuffer> buffer,
+    size_t offset,
+    size_t length) {
+  const Shader::StorageBinding* binding = shader.McsmGetStorageBuffer(index);
+  const impeller::ShaderStage stage = shader.GetShaderStage();
+  if (!binding || !buffer ||
+      (stage != impeller::ShaderStage::kVertex &&
+       stage != impeller::ShaderStage::kFragment) ||
+      offset + length > buffer->GetDeviceBufferDescriptor().size) {
+    return false;
+  }
+  impeller::ShaderUniformSlot slot{
+      .name = binding->name.c_str(),
+      .ext_res_0 = binding->ext_res_0,
+      .set = binding->set,
+      .binding = binding->binding,
+  };
+  impeller::BufferView view(std::move(buffer), impeller::Range(offset, length));
+  for (auto& entry : mcsm_storage_bindings_) {
+    if (entry.stage == stage && entry.slot.binding == slot.binding &&
+        entry.slot.ext_res_0 == slot.ext_res_0) {
+      entry.slot = slot;
+      entry.view = std::move(view);
+      return true;
+    }
+  }
+  mcsm_storage_bindings_.push_back({stage, slot, std::move(view)});
+  return true;
+}
+
+void RenderPass::McsmSendStorageBuffers() {
+  // Metal's backend reads no metadata for a buffer, Vulkan's only the
+  // binding; GLES has no storage buffers.
+  static const impeller::ShaderMetadata kNoMetadata;
+  for (const auto& entry : mcsm_storage_bindings_) {
+    if (retained_bindings_) {
+      // Marks the index as written, so a uniform that held it is sent again.
+      SendBuffer(entry.stage, entry.slot.ext_res_0, &mcsm_storage_bindings_,
+                 true);
+    }
+    render_pass_->BindResource(entry.stage,
+                               impeller::DescriptorType::kStorageBuffer,
+                               entry.slot, &kNoMetadata, entry.view);
+  }
+  // mcsm9: texel buffers, textures and samplers bound apart. Their Metal
+  // indices are marked written, so a binding that held one is sent again.
+  for (const auto& entry : mcsm_bindings_) {
+    if (retained_bindings_) {
+      SendTexture(entry.stage, entry.slot.ext_res_0, &mcsm_bindings_, true);
+      if (entry.slot.ext_res_1 != ~size_t{0}) {
+        SendBuffer(entry.stage, entry.slot.ext_res_1, &mcsm_bindings_, true);
+      }
+    }
+    switch (entry.kind) {
+      case 2:
+        render_pass_->McsmBindTexelBuffer(
+            entry.stage,
