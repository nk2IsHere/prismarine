+    flutter::gpu::CommandBuffer* wrapper,
+    flutter::gpu::Texture* source,
+    flutter::gpu::Texture* destination,
+    int source_x,
+    int source_y,
+    int source_width,
+    int source_height,
+    int destination_x,
+    int destination_y,
+    int source_mip,
+    int source_slice,
+    int destination_mip,
+    int destination_slice) {
+  if (!source || !destination || source_mip < 0 || source_slice < 0 ||
+      destination_mip < 0 || destination_slice < 0 ||
+      !wrapper->McsmCopyTextureToTexture(
+          *source, *destination,
+          impeller::IRect::MakeXYWH(source_x, source_y, source_width,
+                                    source_height),
+          impeller::IPoint(destination_x, destination_y), source_mip,
+          source_slice, destination_mip, destination_slice)) {
+    return tonic::ToDart("Failed to copy between the textures.");
+  }
+  return Dart_Null();
+}
+
+Dart_Handle InternalFlutterGpu_CommandBuffer_McsmCopyTextureToBuffer(
+    flutter::gpu::CommandBuffer* wrapper,
+    flutter::gpu::Texture* source,
+    int source_x,
+    int source_y,
+    int source_width,
+    int source_height,
+    int source_mip,
+    int source_slice,
+    flutter::gpu::DeviceBuffer* destination,
+    int destination_offset_in_bytes) {
+  if (!source || !destination || source_mip < 0 || source_slice < 0 ||
+      destination_offset_in_bytes < 0 ||
+      !wrapper->McsmCopyTextureToBuffer(
+          *source,
+          impeller::IRect::MakeXYWH(source_x, source_y, source_width,
+                                    source_height),
+          source_mip, source_slice, *destination,
+          static_cast<size_t>(destination_offset_in_bytes))) {
+    return tonic::ToDart("Failed to copy the texture to the buffer.");
+  }
+  return Dart_Null();
+}
+
+Dart_Handle InternalFlutterGpu_CommandBuffer_McsmGenerateMipmap(
+    flutter::gpu::CommandBuffer* wrapper,
+    flutter::gpu::Texture* texture) {
+  if (!texture || !wrapper->McsmGenerateMipmap(*texture)) {
+    return tonic::ToDart("Failed to generate the mip levels.");
+  }
+  return Dart_Null();
+}
