+bool RenderPass::McsmDrawIndirect(impeller::BufferView args, bool indexed) {
+  const auto backend = GetContext()->GetBackendType();
+  if (backend != impeller::Context::BackendType::kMetal &&
+      backend != impeller::Context::BackendType::kVulkan) {
+    return false;
+  }
