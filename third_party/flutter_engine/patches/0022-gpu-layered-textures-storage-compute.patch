+             .metal_atomic_buffer = entry.slot.ext_res_1,
+             .binding = entry.slot.binding,
+             .storage = entry.slot.storage},
+            entry.view, entry.format);
+        break;
+      case 3:
+        render_pass_->McsmBindSeparateTexture(entry.stage, entry.slot.ext_res_0,
+                                              entry.slot.binding,
+                                              entry.texture);
+        break;
+      case 4:
